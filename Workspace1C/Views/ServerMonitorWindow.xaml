<Window x:Class="Workspace1C.ServerMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        xmlns:conv="clr-namespace:Workspace1C.Converters"
        Icon="{StaticResource AppIcon}"
        Height="680" Width="1400" MinHeight="560" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Конвертер равенства записи справочника по Id (issue #3, комментарий 7OH 19.10):
             в списке «Сервера управления» строка подключённого сервера — жирная. -->
        <conv:ServerIdentityEqualityConverter x:Key="ServerIdentityEqualityConverter"/>

        <!-- Вертикальное выравнивание содержимого ячеек по центру (как в ProcessInspectorWindow). -->
        <Style x:Key="CenteredCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <Style x:Key="CellTextAccent" TargetType="TextBlock" BasedOn="{StaticResource CenteredCellText}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Заголовки колонок: текст по вертикали по центру (issue #324; глобальный шаблон
             темы центрирует ContentPresenter, здесь фиксируем явно для окна монитора).
             Явный шаблон со стрелкой ▲/▼ (issue #3): тема DataGrid не показывала штатную
             индикацию сортировки, поэтому стрелка рисуется отдельным TextBlock, видимым
             только у колонки с заданным SortDirection. -->
        <!-- Невидимая «ручка» изменения ширины колонки (issue #3): курсор ↔ у границы заголовка. -->
        <Style x:Key="ColumnHeaderGripper" TargetType="Thumb">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CenteredColumnHeader" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <!-- Вертикальная линия справа и снизу заголовка (issue #3, 7OH 17.10)
                             и «ручки» PART_LeftHeaderGripper/PART_RightHeaderGripper: без них
                             DataGrid не даёт менять ширину колонок (пропало в 1.0.0.9 вместе
                             с собственным шаблоном заголовка). -->
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,1,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}"/>
                                    <TextBlock Grid.Column="1" x:Name="SortArrow" Text="▲" FontSize="9"
                                               Margin="4,0,6,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left"
                                   Style="{StaticResource ColumnHeaderGripper}"/>
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                                   Style="{StaticResource ColumnHeaderGripper}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding SortDirection, RelativeSource={RelativeSource Self}}"
                                         Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Text" Value="▲"/>
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SortDirection, RelativeSource={RelativeSource Self}}"
                                         Value="Descending">
                                <Setter TargetName="SortArrow" Property="Text" Value="▼"/>
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Заголовки вкладок ужаты (issue #3): меньше отступов и шрифт чуть меньше.
             Собственный шаблон (issue #3, комментарий 7OH 20.10): в тёмном режиме вкладки
             были белыми и надписи не читались — фон/текст/граница берутся из темы. -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,3"
                                Margin="0,0,0,-1"
                                SnapsToDevicePixels="True"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка-иконка управления базами и серверами (issue #3): без текста, узкая.
             Кнопки шире (комментарий 7OH 20.10): раза в полтора — отступы 9,7 и шрифт 14.
             MinWidth (комментарий 7OH 20.10): «Вверх»/«Вниз» (глифы ↑/↓ уже соседних)
             получают ту же ширину, что и остальные кнопки-иконки. -->
        <Style x:Key="IconOnlyButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <!-- Колонка «Базы» расширена (issue #27): кнопки шире (MinWidth=40 после
                 1.0.0.25) — 260 px, чтобы все пять кнопок и разделители помещались. -->
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Справочник «Сервера управления» (issue #3): список серверов слева, в списке
             выводится только Описание. Кнопки «Добавить/Изменить/Удалить» — НАД списком
             (между заголовком и списком, комментарий 7OH от 2026-10-17). Подключение —
             по кнопке «Подключиться» или двойному клику по строке. -->
        <DockPanel Grid.Column="0" Grid.Row="0" Grid.RowSpan="7" Margin="0,0,16,0">
            <TextBlock DockPanel.Dock="Top" Text="{loc:Loc ServerMonitor.Servers.Title}"
                       FontWeight="SemiBold" Margin="0,0,0,8"/>
            <!-- Кнопки управления серверами — иконками без надписей (issue #3, комментарий
                 7OH 20.10): Добавить, Изменить | Вверх, Вниз | Удалить (как у списка баз). -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <Button x:Name="AddServerButton" Style="{StaticResource IconOnlyButton}"
                        ToolTip="{loc:Loc ServerMonitor.Servers.Add}"
                        Click="OnAddServer_Click">
                    <TextBlock Text="＋" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="EditServerButton" Style="{StaticResource IconOnlyButton}"
                        ToolTip="{loc:Loc ServerMonitor.Servers.Edit}"
                        Click="OnEditServer_Click">
                    <TextBlock Text="✎" VerticalAlignment="Center"/>
                </Button>
                <Border Width="1" Margin="0,4,6,4" Background="{DynamicResource BorderBrushColor}"/>
                <Button x:Name="MoveUpServerButton" Style="{StaticResource IconOnlyButton}"
                        ToolTip="{loc:Loc ServerMonitor.Servers.MoveUp}"
                        IsEnabled="{Binding CanMoveServerUp}" Click="OnMoveServerUp_Click">
                    <TextBlock Text="↑" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="MoveDownServerButton" Style="{StaticResource IconOnlyButton}"
                        ToolTip="{loc:Loc ServerMonitor.Servers.MoveDown}"
                        IsEnabled="{Binding CanMoveServerDown}" Click="OnMoveServerDown_Click">
                    <TextBlock Text="↓" VerticalAlignment="Center"/>
                </Button>
                <Border Width="1" Margin="0,4,6,4" Background="{DynamicResource BorderBrushColor}"/>
                <!-- Кнопке «Удалить» — красная иконка (issue #3, комментарий 7OH). -->
                <Button x:Name="DeleteServerButton" Style="{StaticResource IconOnlyButton}"
                        ToolTip="{loc:Loc ServerMonitor.Servers.Delete}"
                        Click="OnDeleteServer_Click">
                    <TextBlock Text="🗑" VerticalAlignment="Center" Foreground="#DC2626"/>
                </Button>
            </StackPanel>
            <!-- Подсказка при пустом списке (issue #3): добавьте сервер и выберите его. -->
            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{loc:Loc ServerMonitor.Servers.Empty}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasServers}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <!-- Кнопка «СЛУЖБЫ» (issue #3, 18.10 08:57): внизу левой колонки, на всю
                 ширину; подменю служб — то же, что в трее по Ctrl+ПКМ (ServiceTrayMenuBuilder). -->
            <Button DockPanel.Dock="Bottom" x:Name="ServicesMenuButton"
                    Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}"
                    Margin="0,8,0,0" Padding="0,8"
                    Click="OnServicesMenu_Click">
                <TextBlock Text="{loc:Loc ServerMonitor.Servers.Services}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
            </Button>
            <ListBox x:Name="ServersList" ItemsSource="{Binding Servers}"
                     SelectedItem="{Binding SelectedServer}"
                     MouseDoubleClick="OnServersList_MouseDoubleClick"
                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                     Background="{DynamicResource CardBackgroundBrush}">
                <!-- Строки списка серверов крупнее (issue #3): как строки в списке баз —
                     выше высота и крупнее шрифт (строку удобно выделять для правки). -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="MinHeight" Value="40"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <!-- Подсветка подключённого сервера (issue #3, комментарий 7OH 19.10):
                             строка записи, к которой установлено подключение, — жирная.
                             MultiBinding: DataContext.ConnectedServer из родительского
                             ListBox + текущий элемент; конвертер сверяет Id. При отсутствии
                             подключения (ConnectedServer == null) конвертер возвращает
                             false — триггер не срабатывает. -->
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource ServerIdentityEqualityConverter}">
                                        <Binding Path="DataContext.ConnectedServer"
                                                 RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                        <Binding/>
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Description}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Список информационных баз кластера (issue #3, комментарий 7OH от 2026-10-17):
             НЕ вкладка, а отдельный список слева от вкладок, на одной горизонтали с ними.
             Клик по строке включает фильтр сеансов/соединений/блокировок. Три кнопки
             управления — в одну строку, только иконки; у «Удалить» красная иконка. -->
        <!-- Компоновка (issue #3, скриншот 7OH 17.10): список баз начинается на одном уровне
             со строкой фильтра и вкладками; кнопки действий и строка кластера — над ними
             на всю ширину (Grid.ColumnSpan="2"). -->
        <DockPanel Grid.Column="1" Grid.Row="2" Grid.RowSpan="5" Margin="0,0,12,0">
            <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,8"
                       Text="{Binding InfobasesHeaderText}"/>
            <!-- Три кнопки управления базами в одну строку (иконки + подсказки). -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <Button x:Name="AddInfobaseButton" Style="{StaticResource IconOnlyButton}"
                        ToolTip="{loc:Loc ServerMonitor.Infobase.Add}"
                        Click="OnAddInfobase_Click">
                    <TextBlock Text="＋" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="EditInfobaseButton" Style="{StaticResource IconOnlyButton}"
                        ToolTip="{loc:Loc ServerMonitor.Infobase.Edit}"
                        IsEnabled="{Binding CanDropInfobase}"
                        Click="OnEditInfobase_Click">
                    <TextBlock Text="✎" VerticalAlignment="Center"/>
                </Button>
                <!-- Сортировка списка баз (issue #3, 7OH 17.10): Добавить, Правка | А→Я, Я→А | Удалить. -->
                <Border Width="1" Margin="0,4,6,4" Background="{DynamicResource BorderBrushColor}"/>
                <Button x:Name="SortInfobasesAscButton" Style="{StaticResource IconOnlyButton}"
                        ToolTip="{loc:Loc ServerMonitor.Infobase.SortAsc}"
                        Click="OnSortInfobasesAsc_Click">
                    <TextBlock Text="А↓" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="SortInfobasesDescButton" Style="{StaticResource IconOnlyButton}"
                        ToolTip="{loc:Loc ServerMonitor.Infobase.SortDesc}"
                        Click="OnSortInfobasesDesc_Click">
                    <TextBlock Text="Я↓" VerticalAlignment="Center"/>
                </Button>
                <Border Width="1" Margin="0,4,6,4" Background="{DynamicResource BorderBrushColor}"/>
                <!-- Кнопке удаления — красная иконка (issue #3). -->
                <Button x:Name="DeleteInfobaseButton" Style="{StaticResource IconOnlyButton}"
                        ToolTip="{loc:Loc ServerMonitor.Infobase.Delete}"
                        IsEnabled="{Binding CanDropInfobase}" Click="OnDeleteInfobase_Click">
                    <TextBlock Text="🗑" VerticalAlignment="Center" Foreground="#DC2626"/>
                </Button>
            </StackPanel>
            <!-- Подсказка при пустом списке баз. -->
            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{loc:Loc ServerMonitor.Infobase.Empty}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasInfobases}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <!-- Кнопки «Импорт» и «Миграция» (issue #41): внизу панели баз, по аналогии
                 с «Службы» под списком серверов; открывают «Импорт из кластера 1С» /
                 «Миграцию между кластерами 1С» с текущим сервером (SelectedServer,
                 иначе ConnectedServer, иначе первый). -->
            <!-- Кнопки растягиваются на ширину панели баз и делят её пополам с учётом
                 отступа (issue #41, комментарий 7OH): в горизонтальном StackPanel
                 HorizontalAlignment=Stretch не работает, поэтому контейнер — Grid. -->
            <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="InfobasesImportButton" Grid.Column="0"
                        Style="{StaticResource ModernButton}"
                        Background="{DynamicResource ItemHoverBrush}"
                        Padding="0,8" HorizontalAlignment="Stretch"
                        Click="OnImport_Click">
                    <TextBlock Text="{loc:Loc ServerMonitor.Infobase.Import}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                </Button>
                <Button x:Name="InfobasesMigrateButton" Grid.Column="2"
                        Style="{StaticResource ModernButton}"
                        Background="{DynamicResource ItemHoverBrush}"
                        Padding="0,8" HorizontalAlignment="Stretch"
                        Click="OnMigrate_Click">
                    <TextBlock Text="{loc:Loc ServerMonitor.Infobase.Migrate}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                </Button>
            </Grid>
            <!-- Список баз: одна колонка с именем; клик по строке включает фильтр. -->
            <ListBox x:Name="InfobasesList" ItemsSource="{Binding Infobases}"
                     SelectedItem="{Binding SelectedInfobase}"
                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                     Background="{DynamicResource CardBackgroundBrush}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="MinHeight" Value="32"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Padding" Value="8,2"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Первая строка правой панели (issue #3): кнопки «Подключиться», «Обновить»,
             «Диагностика сети». Подключение к кластеру выбранного сервера справочника. -->
        <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="ConnectButton" Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}" Padding="14,6" Margin="0,0,6,0"
                    Click="OnConnect_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔗" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc ServerMonitor.Connect}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="RefreshButton" Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}" Padding="14,6" Margin="0,0,6,0"
                    Click="OnRefresh_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⟳" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc ServerMonitor.Refresh}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <!-- Диагностика сети до сервера 1С (функция 12): DNS/ICMP/TCP-проверка адреса:порт
                 монитора и стандартных портов 1540/1541/1545. Работает до подключения rac. -->
            <Button x:Name="DiagnosticsButton" Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}" Padding="14,6"
                    Click="OnDiagnostics_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🛜" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc ServerMonitor.NetworkDiagnostics}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Вторая строка правой панели (issue #3): выбор кластера, настройка
             автообновления и статус подключения. -->
        <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{loc:Loc ServerMonitor.Cluster}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <!-- issue #324: явный ItemTemplate вместо DisplayMemberPath — с шаблоном
                 ModernComboBox закрытый ComboBox в ряде случаев показывал ToString()
                 выбранного элемента («Workspace1C…» вместо имени кластера). -->
            <ComboBox x:Name="ClusterCombo" Width="300" Style="{StaticResource ModernComboBox}"
                      ItemsSource="{Binding ClusterRows}"
                      SelectedValuePath="Id" SelectedValue="{Binding SelectedClusterId}"
                      VerticalContentAlignment="Center" Padding="6,2">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <!-- Автообновление (issue #324): переключатель и интервал рядом с кластером. -->
            <CheckBox x:Name="AutoRefreshCheckBox" Content="{loc:Loc ServerMonitor.AutoRefreshToggle}"
                      IsChecked="{Binding IsAutoRefreshEnabled, Mode=TwoWay}"
                      VerticalAlignment="Center" Margin="10,0,8,0"/>
            <TextBlock Text="{loc:Loc ServerMonitor.AutoRefreshInterval}" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox x:Name="AutoRefreshIntervalCombo" Width="64" Style="{StaticResource ModernComboBox}"
                      SelectedValuePath="Tag" SelectedValue="{Binding AutoRefreshIntervalSeconds, Mode=TwoWay}"
                      VerticalContentAlignment="Center" Padding="6,2">
                <ComboBoxItem Content="5" Tag="5"/>
                <ComboBoxItem Content="10" Tag="10"/>
                <ComboBoxItem Content="15" Tag="15"/>
                <ComboBoxItem Content="30" Tag="30"/>
                <ComboBoxItem Content="60" Tag="60"/>
            </ComboBox>
            <TextBlock x:Name="StatusSummary" VerticalAlignment="Center" Margin="14,0,0,0"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding StatusText}"/>
        </StackPanel>

        <!-- Индикатор фильтра по базе (issue #3, комментарий 7OH от 2026-10-17): надпись
             и кнопка «Сбросить» видны ВСЕГДА; при снятом фильтре — «Без фильтра». -->
        <StackPanel Grid.Column="2" Grid.Row="2"
                    Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding InfobaseFilterText}"/>
            <Button Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}" Padding="10,4" Margin="8,0,0,0"
                    Click="OnClearInfobaseFilter_Click">
                <TextBlock Text="{loc:Loc ServerMonitor.Infobase.FilterReset}" VerticalAlignment="Center"/>
            </Button>
        </StackPanel>

        <!-- Вкладки данных кластера (issue #3): порядок «Сеансы / Соединения / Блокировки /
             Рабочие процессы / Информация о кластере»; вкладка «Базы» перенесена в отдельный
             список слева; в заголовках — количество строк («Сеансы (12)»). -->
        <TabControl Grid.Column="2" Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">

            <!-- Сеансы -->
            <TabItem Header="{Binding SessionsTabText}">
                <DockPanel>
                    <!-- Действие: завершить выбранные сеансы (подтверждение — в VM;
                         issue #72 — действует на ВСЕ выделенные строки). -->
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource ModernButton}"
                            Background="{DynamicResource ItemHoverBrush}" Padding="12,5"
                            Margin="0,8,0,0" HorizontalAlignment="Left"
                            IsEnabled="{Binding CanTerminateSessions}"
                            Click="OnTerminateSession_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✕" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc ServerMonitor.TerminateSession}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Горизонтальная прокрутка (issue #75): у колонок задан MinWidth по
                         содержимому заголовка (см. ServerMonitorColumnWidthsStore), поэтому
                         при узком окне колонки не «схлопываются», а прокручиваются за границу
                         области — для инструмента монитора это нормально. -->
                    <DataGrid x:Name="SessionsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectedItem="{Binding SelectedSession}"
                              HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserSortColumns="True" Sorting="OnGridSorting"
                              ColumnHeaderStyle="{StaticResource CenteredColumnHeader}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          SelectionMode="Extended" SelectionUnit="FullRow" GridLinesVisibility="All" CanUserResizeColumns="True"
                          SelectionChanged="OnSessionsGrid_SelectionChanged"
                          HorizontalGridLinesBrush="{DynamicResource BorderBrushColor}"
                          VerticalGridLinesBrush="{DynamicResource BorderBrushColor}"
                          RowHeight="34" AlternatingRowBackground="{DynamicResource CardBackgroundBrush}"
                          BorderThickness="0">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <!-- issue #75: MinWidth колонок — по длине локализованного заголовка
                             (худший случай ru/en, см. ServerMonitorColumnWidthsStore.HeaderMinWidth)
                             плюс запас на стрелку сортировки: заголовок не «схлопывается», при
                             узком окне колонки уходят за границу области по горизонтали. -->
                        <DataGridTextColumn Width="1.2*" MinWidth="130" Header="{loc:Loc ServerMonitor.Columns.Session.User}"
                                            Binding="{Binding User}" ElementStyle="{StaticResource CellTextAccent}"/>
                        <!-- issue #324, C2: колонка «Информационная база» (имя из
                             «infobase summary list» по infobase-id сеанса). -->
                        <DataGridTextColumn Width="1.1*" MinWidth="183" Header="{loc:Loc ServerMonitor.Columns.Session.Infobase}"
                                            Binding="{Binding InfobaseName}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="1.1*" MinWidth="70" Header="{loc:Loc ServerMonitor.Columns.Session.Host}"
                                            Binding="{Binding Host}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="123" MinWidth="123" Header="{loc:Loc ServerMonitor.Columns.Session.App}"
                                            Binding="{Binding AppId}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="150" MinWidth="130" Header="{loc:Loc ServerMonitor.Columns.Session.StartedAt}"
                                            Binding="{Binding StartedAtText}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="160" MinWidth="160" Header="{loc:Loc ServerMonitor.Columns.Session.LastActive}"
                                            Binding="{Binding LastActiveAtText}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="120" MinWidth="108" Header="{loc:Loc ServerMonitor.Columns.Session.State}"
                                            Binding="{Binding StateText}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenteredCellText}">
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="active">
                                            <Setter Property="Foreground" Value="#16A34A"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="dead">
                                            <Setter Property="Foreground" Value="#DC2626"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="sleep">
                                            <Setter Property="Foreground" Value="#D97706"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="call">
                                            <Setter Property="Foreground" Value="#D97706"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="wait">
                                            <Setter Property="Foreground" Value="#D97706"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="100" MinWidth="93" Header="{loc:Loc ServerMonitor.Columns.Session.Blocked}"
                                            Binding="{Binding BlockedSymbol}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="110" MinWidth="85" Header="{loc:Loc ServerMonitor.Columns.Session.Memory}"
                                            Binding="{Binding MemoryText}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="130" MinWidth="130" Header="{loc:Loc ServerMonitor.Columns.Session.Duration}"
                                            Binding="{Binding DurationAllText}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="130" MinWidth="130" Header="{loc:Loc ServerMonitor.Columns.Session.DurationCurrent}"
                                            Binding="{Binding DurationCurrentText}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="108" MinWidth="108" Header="{loc:Loc ServerMonitor.Columns.Session.Hibernate}"
                                            Binding="{Binding HibernateText}" ElementStyle="{StaticResource CenteredCellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Соединения -->
            <TabItem Header="{Binding ConnectionsTabText}">
                <DockPanel>
                    <!-- Действие: разорвать выбранные соединения (подтверждение — в VM;
                         issue #72 — действует на ВСЕ выделенные строки). -->
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource ModernButton}"
                            Background="{DynamicResource ItemHoverBrush}" Padding="12,5"
                            Margin="0,8,0,0" HorizontalAlignment="Left"
                            IsEnabled="{Binding CanDisconnectConnections}"
                            Click="OnDisconnectConnection_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⛓" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc ServerMonitor.DisconnectConnection}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Горизонтальная прокрутка колонок (issue #75; см. SessionsGrid). -->
                    <DataGrid x:Name="ConnectionsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectedItem="{Binding SelectedConnection}"
                              HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserSortColumns="True" Sorting="OnGridSorting"
                              ColumnHeaderStyle="{StaticResource CenteredColumnHeader}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          SelectionMode="Extended" SelectionUnit="FullRow" GridLinesVisibility="All" CanUserResizeColumns="True"
                          SelectionChanged="OnConnectionsGrid_SelectionChanged"
                          HorizontalGridLinesBrush="{DynamicResource BorderBrushColor}"
                          VerticalGridLinesBrush="{DynamicResource BorderBrushColor}"
                          RowHeight="34" AlternatingRowBackground="{DynamicResource CardBackgroundBrush}"
                          BorderThickness="0">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <!-- issue #75: MinWidth колонок — по заголовку (худший случай ru/en,
                             см. ServerMonitorColumnWidthsStore.HeaderMinWidth), см. SessionsGrid. -->
                        <DataGridTextColumn Width="1.2*" MinWidth="70" Header="{loc:Loc ServerMonitor.Columns.Connection.Host}"
                                            Binding="{Binding Host}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="90" MinWidth="70" Header="{loc:Loc ServerMonitor.Columns.Connection.Port}"
                                            Binding="{Binding Port}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="120" MinWidth="108" Header="{loc:Loc ServerMonitor.Columns.Connection.Connector}"
                                            Binding="{Binding Connector}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="150" MinWidth="123" Header="{loc:Loc ServerMonitor.Columns.Connection.Established}"
                                            Binding="{Binding EstablishedAtText}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="153" MinWidth="153" Header="{loc:Loc ServerMonitor.Columns.Connection.LastActive}"
                                            Binding="{Binding LastConnectionTimeText}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="130" MinWidth="130" Header="{loc:Loc ServerMonitor.Columns.Connection.Duration}"
                                            Binding="{Binding DurationText}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="1.3*" MinWidth="123" Header="{loc:Loc ServerMonitor.Columns.Connection.Descr}"
                                            Binding="{Binding Descr}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="138" MinWidth="138" Header="{loc:Loc ServerMonitor.Columns.Connection.Blocked}"
                                            Binding="{Binding BlockedText}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenteredCellText}">
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Blocked}" Value="True">
                                            <Setter Property="Foreground" Value="#D97706"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Блокировки -->
            <TabItem Header="{Binding LocksTabText}">
                <!-- Горизонтальная прокрутка колонок (issue #75; см. SessionsGrid). -->
                <DataGrid x:Name="LocksGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="True" Sorting="OnGridSorting"
                          ColumnHeaderStyle="{StaticResource CenteredColumnHeader}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          SelectionMode="Single" SelectionUnit="FullRow" GridLinesVisibility="All" CanUserResizeColumns="True"
                          HorizontalGridLinesBrush="{DynamicResource BorderBrushColor}"
                          VerticalGridLinesBrush="{DynamicResource BorderBrushColor}"
                          RowHeight="34" AlternatingRowBackground="{DynamicResource CardBackgroundBrush}"
                          BorderThickness="0">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <!-- issue #75: MinWidth колонок — по заголовку (см. SessionsGrid). -->
                        <DataGridTextColumn Width="2*" MinWidth="85" Header="{loc:Loc ServerMonitor.Columns.Lock.Object}"
                                            Binding="{Binding Object}" ElementStyle="{StaticResource CellTextAccent}"/>
                        <DataGridTextColumn Width="110" MinWidth="93" Header="{loc:Loc ServerMonitor.Columns.Lock.Waiting}"
                                            Binding="{Binding WaitingSymbol}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenteredCellText}">
                                    <Setter Property="Foreground" Value="#D97706"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="110" MinWidth="108" Header="{loc:Loc ServerMonitor.Columns.Lock.Blocking}"
                                            Binding="{Binding BlockingSymbol}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenteredCellText}">
                                    <Setter Property="Foreground" Value="#DC2626"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="1.1*" MinWidth="93" Header="{loc:Loc ServerMonitor.Columns.Lock.Session}"
                                            Binding="{Binding SessionId}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="1.1*" MinWidth="115" Header="{loc:Loc ServerMonitor.Columns.Lock.Connection}"
                                            Binding="{Binding ConnectionId}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="1.1*" MinWidth="123" Header="{loc:Loc ServerMonitor.Columns.Lock.Transaction}"
                                            Binding="{Binding TransactionId}" ElementStyle="{StaticResource CenteredCellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Рабочие процессы (issue #3: перенесена перед «Информация о кластере»). -->
            <TabItem Header="{Binding ProcessesTabText}">
                <!-- Горизонтальная прокрутка колонок (issue #75; см. SessionsGrid). -->
                <DataGrid x:Name="ProcessesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="True" Sorting="OnGridSorting"
                          ColumnHeaderStyle="{StaticResource CenteredColumnHeader}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          SelectionMode="Single" SelectionUnit="FullRow" GridLinesVisibility="All" CanUserResizeColumns="True"
                          HorizontalGridLinesBrush="{DynamicResource BorderBrushColor}"
                          VerticalGridLinesBrush="{DynamicResource BorderBrushColor}"
                          RowHeight="34" AlternatingRowBackground="{DynamicResource CardBackgroundBrush}"
                          BorderThickness="0">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <!-- issue #75: MinWidth колонок — по заголовку (см. SessionsGrid). -->
                        <DataGridTextColumn Width="110" MinWidth="70" Header="{loc:Loc ServerMonitor.Columns.Process.Type}"
                                            Binding="{Binding Type}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="1.2*" MinWidth="70" Header="{loc:Loc ServerMonitor.Columns.Process.Host}"
                                            Binding="{Binding Host}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="90" MinWidth="60" Header="PID"
                                            Binding="{Binding Pid}" ElementStyle="{StaticResource CellTextAccent}"/>
                        <DataGridTextColumn Width="80" MinWidth="70" Header="{loc:Loc ServerMonitor.Columns.Process.Port}"
                                            Binding="{Binding Port}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="150" MinWidth="130" Header="{loc:Loc ServerMonitor.Columns.Process.StartedAt}"
                                            Binding="{Binding StartedAtText}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="110" MinWidth="85" Header="{loc:Loc ServerMonitor.Columns.Process.Memory}"
                                            Binding="{Binding MemorySizeText}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="100" MinWidth="93" Header="{loc:Loc ServerMonitor.Columns.Process.Threads}"
                                            Binding="{Binding Threads}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="100" MinWidth="63" Header="{loc:Loc ServerMonitor.Columns.Process.Cpu}"
                                            Binding="{Binding CpuText}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="100" MinWidth="93" Header="{loc:Loc ServerMonitor.Columns.Process.Running}"
                                            Binding="{Binding RunningText}" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Width="80" MinWidth="63" Header="{loc:Loc ServerMonitor.Columns.Process.Infobases}"
                                            Binding="{Binding Infobases}" ElementStyle="{StaticResource CenteredCellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Лицензии (issue #83: вкладка ПЕРЕД «Информация о кластере» — данные по
                 лицензиям интереснее свойств кластера; п.5 «Мониторинг лицензий», выпуск
                 1.0.0.87): занятые сеансами лицензии (rac «session list» с параметром
                 licences) + установленные программные лицензии («ring license list» /
                 licensetool). Сводка — LicenseSummaryText, предупреждение о недоступности
                 утилиты — LicenseStatusText. -->
            <TabItem Header="{Binding LicensesTabText}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="{Binding LicenseSummaryText}" FontWeight="SemiBold"
                                   FontSize="13" Margin="0,2,0,4"/>
                        <!-- issue #83: предупреждение (в т.ч. «module license is not
                             registered» / «ring не найдена в PATH») должно быть ВИДНО,
                             когда текст непустой; при пустом — скрывается. Раньше
                             триггеры были инвертированы (warning скрывался). -->
                        <TextBlock Text="{Binding LicenseStatusText}" FontSize="12"
                                   Foreground="#D97706" TextWrapping="Wrap" Margin="0,0,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LicenseStatusText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LicenseStatusText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,4,0,4"
                               Text="{loc:Loc ServerMonitor.Licenses.InUseHeader}"/>
                    <!-- Занятые лицензии по сеансам. -->
                    <DataGrid x:Name="LicensedSessionsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserSortColumns="True" Sorting="OnGridSorting"
                              ColumnHeaderStyle="{StaticResource CenteredColumnHeader}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              SelectionMode="Extended" SelectionUnit="FullRow" GridLinesVisibility="All"
                              CanUserResizeColumns="True"
                              HorizontalGridLinesBrush="{DynamicResource BorderBrushColor}"
                              VerticalGridLinesBrush="{DynamicResource BorderBrushColor}"
                              RowHeight="34" AlternatingRowBackground="{DynamicResource CardBackgroundBrush}"
                              Canvas.ZIndex="10" MinHeight="120" BorderThickness="0">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="1.2*" MinWidth="100" Header="{loc:Loc ServerMonitor.Licenses.Columns.User}"
                                                Binding="{Binding User}" ElementStyle="{StaticResource CellTextAccent}"/>
                            <DataGridTextColumn Width="1.2*" MinWidth="130" Header="{loc:Loc ServerMonitor.Licenses.Columns.Infobase}"
                                                Binding="{Binding InfobaseName}" ElementStyle="{StaticResource CenteredCellText}"/>
                            <DataGridTextColumn Width="1*" MinWidth="90" Header="{loc:Loc ServerMonitor.Licenses.Columns.Host}"
                                                Binding="{Binding Host}" ElementStyle="{StaticResource CenteredCellText}"/>
                            <DataGridTextColumn Width="110" MinWidth="90" Header="{loc:Loc ServerMonitor.Licenses.Columns.Type}"
                                                Binding="{Binding LicType}" ElementStyle="{StaticResource CenteredCellText}"/>
                            <DataGridTextColumn Width="90" MinWidth="70" Header="{loc:Loc ServerMonitor.Licenses.Columns.Used}"
                                                Binding="{Binding LicensesUsedText}" ElementStyle="{StaticResource CenteredCellText}"/>
                            <DataGridTextColumn Width="100" MinWidth="80" Header="{loc:Loc ServerMonitor.Licenses.Columns.Max}"
                                                Binding="{Binding MaxLicensesText}" ElementStyle="{StaticResource CenteredCellText}"/>
                            <DataGridTextColumn Width="100" MinWidth="80" Header="{loc:Loc ServerMonitor.Licenses.Columns.App}"
                                                Binding="{Binding AppId}" ElementStyle="{StaticResource CenteredCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock DockPanel.Dock="Bottom" FontWeight="SemiBold" Margin="0,4,0,2"
                               Text="{loc:Loc ServerMonitor.Licenses.InstalledHeader}"/>
                    <!-- Установленные программные лицензии (ring/licensetool). -->
                    <DataGrid x:Name="InstalledLicensesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserSortColumns="True" Sorting="OnGridSorting"
                              ColumnHeaderStyle="{StaticResource CenteredColumnHeader}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              SelectionMode="Extended" SelectionUnit="FullRow" GridLinesVisibility="All"
                              CanUserResizeColumns="True"
                              HorizontalGridLinesBrush="{DynamicResource BorderBrushColor}"
                              VerticalGridLinesBrush="{DynamicResource BorderBrushColor}"
                              RowHeight="34" AlternatingRowBackground="{DynamicResource CardBackgroundBrush}"
                              MinHeight="120" BorderThickness="0">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="1.4*" MinWidth="160" Header="{loc:Loc ServerMonitor.Licenses.Columns.Serial}"
                                                Binding="{Binding SerialNumber}" ElementStyle="{StaticResource CellTextAccent}"/>
                            <DataGridTextColumn Width="120" MinWidth="90" Header="{loc:Loc ServerMonitor.Licenses.Columns.Type}"
                                                Binding="{Binding Type}" ElementStyle="{StaticResource CenteredCellText}"/>
                            <DataGridTextColumn Width="100" MinWidth="80" Header="{loc:Loc ServerMonitor.Licenses.Columns.Version}"
                                                Binding="{Binding Version}" ElementStyle="{StaticResource CenteredCellText}"/>
                            <DataGridTextColumn Width="1.1*" MinWidth="110" Header="{loc:Loc ServerMonitor.Licenses.Columns.Module}"
                                                Binding="{Binding Module}" ElementStyle="{StaticResource CenteredCellText}"/>
                            <DataGridTextColumn Width="1.1*" MinWidth="100" Header="{loc:Loc ServerMonitor.Licenses.Columns.User}"
                                                Binding="{Binding User}" ElementStyle="{StaticResource CenteredCellText}"/>
                            <DataGridTextColumn Width="100" MinWidth="80" Header="{loc:Loc ServerMonitor.Licenses.Columns.State}"
                                                Binding="{Binding State}" ElementStyle="{StaticResource CenteredCellText}"/>
                            <DataGridTextColumn Width="110" MinWidth="90" Header="{loc:Loc ServerMonitor.Licenses.Columns.Expiry}"
                                                Binding="{Binding ExpiryDate}" ElementStyle="{StaticResource CenteredCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Информация о кластере (issue #324, C3; issue #3 — человекочитаемые значения
                 и группировка по секциям): свойства сгруппированы, значения отформатированы
                 («1 ч 30 мин», «512 МБ», «Да/Нет»); правится безопасный набор параметров. -->
            <TabItem Header="{loc:Loc ServerMonitor.Tabs.Info}">
                <StackPanel>
                    <StackPanel.Resources>
                        <CollectionViewSource x:Key="GroupedProperties" Source="{Binding ClusterProperties}">
                            <CollectionViewSource.GroupDescriptions>
                                <PropertyGroupDescription PropertyName="Group"/>
                            </CollectionViewSource.GroupDescriptions>
                        </CollectionViewSource>
                    </StackPanel.Resources>
                    <Button DockPanel.Dock="Top" Style="{StaticResource ModernButton}"
                            Background="{DynamicResource ItemHoverBrush}" Padding="12,5"
                            Margin="0,0,0,8" HorizontalAlignment="Left"
                            Click="OnSaveClusterInfo_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc ServerMonitor.Cluster.Save}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                        <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedProperties}}">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       FontSize="13" Margin="0,10,0,4"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="340" SharedSizeGroup="Property"/>
                                            <ColumnDefinition Width="340" SharedSizeGroup="Value"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding RawKey}"/>
                                        <!-- Правка — только для безопасного набора параметров. -->
                                        <TextBox Grid.Column="1" Padding="4,2"
                                                 Text="{Binding EditValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalContentAlignment="Center">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditable}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <!-- Только чтение — человекочитаемое значение (issue #3). -->
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditable}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <TextBlock.Text>
                                                <Binding Path="DisplayValue"/>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Строка состояния и ошибки (пустой ErrorMessage ничего не показывает) -->
        <TextBlock Grid.Column="2" Grid.Row="4" Margin="0,10,0,0" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding StatusText}"/>
        <TextBlock Grid.Column="2" Grid.Row="5" Margin="0,4,0,0" FontSize="12"
                   Foreground="#DC2626" Text="{Binding ErrorMessage}"
                   TextWrapping="Wrap"/>
        <!-- Подсказка про автообновление (по образцу ProcessInspectorWindow.Hint). -->
        <TextBlock Grid.Column="2" Grid.Row="6" Margin="0,8,0,0" FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{Binding AutoRefreshText}"/>
    </Grid>
</Window>