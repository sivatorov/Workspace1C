<Window x:Class="Workspace1C.TagPickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        mc:Ignorable="d"
        Title="{loc:Loc TagPick.Title}"
        Icon="{StaticResource AppIcon}"
        Width="460" Height="440"
        MinHeight="380" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <!-- Implicit-стили для корректного отображения в тёмной теме -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"/>
        <Style TargetType="CheckBox" BasedOn="{StaticResource ModernMaterialCheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ Заголовок списка + счётчик «Выбрано: N» ============ -->
        <DockPanel Grid.Row="0">
            <TextBlock x:Name="SelectedCountText" DockPanel.Dock="Right"
                       FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text="{loc:Loc TagPick.ExistingTags}" FontSize="15" FontWeight="SemiBold"/>
        </DockPanel>

        <!-- ============ Список существующих тегов с флажками ============ -->
        <Border Grid.Row="1" Margin="0,10,0,0" CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrushColor}"
                Background="{DynamicResource CardBackgroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                <StackPanel x:Name="TagsPanel"/>
            </ScrollViewer>
        </Border>

        <!-- ============ Поле нового тега + «Добавить» ============ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="{loc:Loc TagPick.NewTagLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="NewTagBox" Width="180" Padding="8,6" KeyDown="OnNewTagBox_KeyDown"/>
            <Button Margin="8,0,0,0" Padding="14,6"
                    Style="{StaticResource ModernButton}"
                    Click="OnAddTag_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="＋" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc TagPick.AddNewTag}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- ============ Кнопки Отмена / ОК ============ -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Width="110" Margin="0,0,8,0"
                    IsCancel="True"
                    Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="✖" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Common.Cancel}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="OkButton" Width="130"
                    IsDefault="True"
                    Style="{StaticResource ModernButton}"
                    Click="OnOk_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource SuccessBrush}" Text="✔" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Common.Ok}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
