<Application x:Class="Workspace1C.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Workspace1C"
             xmlns:conv="clr-namespace:Workspace1C.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:themes="clr-namespace:Workspace1C.Themes"
            >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Amber" SecondaryColor="Blue" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <ResourceDictionary Source="Themes/LightTheme.xaml"/>
                <ResourceDictionary Source="Themes/Icons.xaml"/>
                <!-- Второй набор иконок (Outline, Задача 5): ключи с суффиксом ".Outline".
                     Резолв (IconKeyToGeometryConverter) выбирает активный набор по ресурсу
                     IconSetName, который выставляет ThemeManager.ApplyIconSet. -->
                <ResourceDictionary Source="Themes/IconsOutline.xaml"/>
                <!-- Наборы иконок Material/MacOS/WindowsXp/Glass (Задача 2): суффиксные ключи
                     (IconAdd.Material и т.п.). Отсутствующие в наборе иконки бесшовно
                     фолбэчатся на Fluent через IconResolutionCandidates. -->
                <ResourceDictionary Source="Themes/IconsMaterial.xaml"/>
                <ResourceDictionary Source="Themes/IconsMacOS.xaml"/>
                <ResourceDictionary Source="Themes/IconsWindowsXp.xaml"/>
                <ResourceDictionary Source="Themes/IconsGlass.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:GroupTextColorConverter x:Key="GroupTextColorConverter"/>
            <conv:IconKeyToGeometryConverter x:Key="IconKeyToGeometryConverter"/>
            <!-- Цвет точки «база запущена» (issue #310): зелёный/оранжевый/красный. -->
            <conv:RunningDotColorConverter x:Key="RunningDotColorConverter"/>

            <!-- ===================== Значки PackIcon по набору иконок (0.3.12.60) =====================
                 Неявный стиль заменяет шаблон materialDesign:PackIcon: геометрия берётся из
                 активного набора иконок темы (Pack.<Kind>.<Набор> в Icons<Набор>.xaml) через
                 PackIconGeometryConverter, а при Fluent — родная геометрия PackIcon. Слои:
                 фоновый полупрозрачный (Duotone-набор Glass), основной и «блик» (IconGlossBrush,
                 у Windows XP — объёмный градиент). Привязка к IconSetState.Current перерисовывает
                 все значки сразу при смене темы. Локальные стили PackIcon наследуют этот стиль
                 через BasedOn="{StaticResource {x:Type materialDesign:PackIcon}}". -->
            <SolidColorBrush x:Key="IconGlossBrush" Color="Transparent"/>
            <Style TargetType="{x:Type materialDesign:PackIcon}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type materialDesign:PackIcon}">
                            <Viewbox FlowDirection="{TemplateBinding FlowDirection}">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{TemplateBinding Foreground}" Opacity="0.25">
                                        <Path.Data>
                                            <MultiBinding Converter="{x:Static conv:PackIconGeometryConverter.Back}">
                                                <Binding Path="Kind" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                <Binding Path="Current" Source="{x:Static themes:IconSetState.Instance}"/>
                                                <Binding Path="Data" RelativeSource="{RelativeSource TemplatedParent}"/>
                                            </MultiBinding>
                                        </Path.Data>
                                    </Path>
                                    <Path x:Name="FrontPath" Fill="{TemplateBinding Foreground}">
                                        <Path.Data>
                                            <MultiBinding Converter="{x:Static conv:PackIconGeometryConverter.Front}">
                                                <Binding Path="Kind" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                <Binding Path="Current" Source="{x:Static themes:IconSetState.Instance}"/>
                                                <Binding Path="Data" RelativeSource="{RelativeSource TemplatedParent}"/>
                                            </MultiBinding>
                                        </Path.Data>
                                    </Path>
                                    <Path Data="{Binding Data, ElementName=FrontPath}"
                                          Fill="{DynamicResource IconGlossBrush}" IsHitTestVisible="False"/>
                                </Canvas>
                            </Viewbox>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===================== Иконка приложения 0.2.6.10 ===================== -->
            <DrawingImage x:Key="AppIcon">
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <!-- Фон: indigo → blue → cyan, скруглённый квадрат -->
                        <GeometryDrawing>
                            <GeometryDrawing.Brush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1E3A8A" Offset="0"/>
                                    <GradientStop Color="#2563EB" Offset="0.45"/>
                                    <GradientStop Color="#3B82F6" Offset="0.75"/>
                                    <GradientStop Color="#0EA5E9" Offset="1"/>
                                </LinearGradientBrush>
                            </GeometryDrawing.Brush>
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,32,32" RadiusX="7" RadiusY="7"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <!-- Цилиндр БД по центру -->
                        <GeometryDrawing Brush="#F8FAFC">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <PathGeometry Figures="M9,9 L9,21 A7,2.5 0 0 0 23,21 L23,9"/>
                                    <EllipseGeometry Center="16,21" RadiusX="7" RadiusY="2.5"/>
                                    <EllipseGeometry Center="16,15" RadiusX="7" RadiusY="2.5"/>
                                    <EllipseGeometry Center="16,9" RadiusX="7" RadiusY="2.5"/>
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#FFFFFF">
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="16,9" RadiusX="7" RadiusY="2.5"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <!-- Янтарный бейдж -->
                        <GeometryDrawing Brush="#FBBF24">
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="24,23" RadiusX="4.2" RadiusY="4.2"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <!-- Галочка на бейдже -->
                        <GeometryDrawing>
                            <GeometryDrawing.Pen>
                                <Pen Brush="#1E293B" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <PathGeometry Figures="M21.8,23.2 L23.2,24.6 L26.4,21.2"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>

            <!-- ===================== Собственные кнопки управления окном =====================
                 Общие для всех окон: главное окно и диалоговые окна (WindowChromeHelper)
                 переиспользуют эти стили. Скруглённая подложка, плавные переходы цвета/масштаба
                 и выразительные значки в духе macOS/VSCode.
                 Параметры подложки приходят из ресурсов полноценной темы (Задача 4), которые
                 выставляет ThemeManager по стилю кнопок окна: WindowButtonHoverBrush (подложка
                 наведения), WindowButtonCloseHoverBrush (подложка «закрыть»),
                 WindowButtonCornerRadius (скругление), WindowButtonSize (размер). Кисти/press/фокус
                 задаются вложенными свойствами WindowChromeHelper.HoverBrush / PressedBrush /
                 FocusBrush — акцентные варианты и кнопка «закрыть» переопределяют только их.
                 Примечание: TemplateBinding допустим только в свойствах элементов шаблона, но НЕ
                 в триггерных Setter'ах (WPF бросает «Тип Expression не является допустимым
                 значением для Style»), поэтому цвет значка при наведении в шаблонах задаётся
                 обычным DynamicResource: у базовой кнопки — основной цвет текста, у «закрыть» —
                 белый. Цвет заливки анимируется прозрачностью слоёв, поэтому кисти можно брать
                 DynamicResource'ом из темы: значения не «замораживаются» в анимациях и
                 корректно обновляются при смене схемы. -->
            <Style x:Key="WindowControlButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <!-- Размер кнопки (ширина) приходит из темы: 46 — Fluent, 40 — Minimal, 34 — Classic.
                     Высота фиксирована высотой полосы заголовка (34). -->
                <Setter Property="Width" Value="{DynamicResource WindowButtonSize}"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="ToolTipService.InitialShowDelay" Value="400"/>
                <!-- Подложка наведения — из темы. Активный заголовок (WindowControlButtonOnAccent)
                     переопределяет её полупрозрачным белым, чтобы оставаться читаемой; обычный
                     стиль (неактивное главное окно, шапка карточки) использует приглушённую
                     кисть WindowButtonInactiveHoverBrush — в тёмной теме она тёмная, и кнопки
                     не «светятся белым» (issue #26, комментарий 7OH от 2026-10-29). -->
                <Setter Property="local:WindowChromeHelper.HoverBrush" Value="{DynamicResource WindowButtonInactiveHoverBrush}"/>
                <Setter Property="local:WindowChromeHelper.PressedBrush" Value="{DynamicResource AccentPressedBrush}"/>
                <Setter Property="local:WindowChromeHelper.FocusBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- Скруглённая подложка: слой под курсором, слой нажатия и кольцо
                                     фокуса. Степень скругления приходит из темы (WindowButtonCornerRadius):
                                     Fluent — круг (15), Minimal — мягкий квадрат (4), Classic — прямоугольник (0).
                                     Прозрачность слоёв анимируется триггерами (плавная заливка),
                                     масштаб подложки даёт тактильный отклик нажатия. -->
                                <Grid x:Name="circleRoot" Width="30" Height="30"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="circleScale" CenterX="15" CenterY="15"/>
                                    </Grid.RenderTransform>
                                    <Border x:Name="hoverLayer" CornerRadius="{DynamicResource WindowButtonCornerRadius}"
                                            Background="{TemplateBinding local:WindowChromeHelper.HoverBrush}" Opacity="0"/>
                                    <Border x:Name="pressLayer" CornerRadius="{DynamicResource WindowButtonCornerRadius}"
                                            Background="{TemplateBinding local:WindowChromeHelper.PressedBrush}" Opacity="0"/>
                                    <Border x:Name="focusRing" CornerRadius="{DynamicResource WindowButtonCornerRadius}" BorderThickness="1.5" Opacity="0"
                                            BorderBrush="{TemplateBinding local:WindowChromeHelper.FocusBrush}"/>
                                </Grid>
                                <!-- Значок: лёгкое увеличение при наведении, «пружинное»
                                     сжатие при нажатии. -->
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter.RenderTransform>
                                        <ScaleTransform x:Name="glyphScale" CenterX="7" CenterY="7"/>
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="hoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                                <DoubleAnimation Storyboard.TargetName="glyphScale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.12"/>
                                                <DoubleAnimation Storyboard.TargetName="glyphScale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="hoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                                <DoubleAnimation Storyboard.TargetName="glyphScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                                                <DoubleAnimation Storyboard.TargetName="glyphScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                    <!-- Значок под курсором: вторичный, а не основной/белый — при
                                         неактивном окне (шапка карточки) «белые элементы» больше
                                         не появляются (issue #26). OnAccent-вариант переопределяет
                                         Foreground в стиле, но триггер шаблона возвращает вторичный
                                         цвет; на акцентной шапке вторичный светлый читается. -->
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="pressLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08"/>
                                                <DoubleAnimation Storyboard.TargetName="circleScale" Storyboard.TargetProperty="ScaleX" To="0.9" Duration="0:0:0.08"/>
                                                <DoubleAnimation Storyboard.TargetName="circleScale" Storyboard.TargetProperty="ScaleY" To="0.9" Duration="0:0:0.08"/>
                                                <DoubleAnimation Storyboard.TargetName="glyphScale" Storyboard.TargetProperty="ScaleX" To="0.92" Duration="0:0:0.08"/>
                                                <DoubleAnimation Storyboard.TargetName="glyphScale" Storyboard.TargetProperty="ScaleY" To="0.92" Duration="0:0:0.08"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="pressLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="circleScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="circleScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="glyphScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="glyphScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="focusRing" Property="Opacity" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Варианты кнопок для акцентной шапки (активное главное окно / заголовок
                 диалогов): базовый цвет значка ButtonTextBrush (читается на акцентном фоне),
                 подложка — полупрозрачный белый, чтобы оставаться читаемой на любой теме.
                 Радиус и размер наследуются из базового стиля (ресурсы темы). -->
            <Style x:Key="WindowControlButtonOnAccent" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
                <!-- Значок контрастен фактическому акценту (issue #26): при тёмном
                     пользовательском акценте глиф белый, при светлом (например #FFB300) — чёрный. -->
                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                <Setter Property="local:WindowChromeHelper.HoverBrush" Value="#33FFFFFF"/>
                <Setter Property="local:WindowChromeHelper.PressedBrush" Value="#4DFFFFFF"/>
                <Setter Property="local:WindowChromeHelper.FocusBrush" Value="#80FFFFFF"/>
            </Style>

            <!-- Кнопка «закрыть» окна: как WindowControlButton (та же скруглённая подложка),
                 но с красным выделением при наведении/нажатии и белым значком на нём. Цвет
                 красной подложки приходит из темы (WindowButtonCloseHoverBrush), радиус и размер
                 — из тех же ресурсов, что и у обычных кнопок. Значок «белый при наведении»
                 задан отдельным шаблоном — в триггерном Setter'е нельзя ссылаться на
                 attached-свойство (Expression недопустим), поэтому шаблон дублируется
                 с одним изменением. -->
            <Style x:Key="WindowControlCloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
                <Setter Property="local:WindowChromeHelper.HoverBrush" Value="{DynamicResource WindowButtonCloseHoverBrush}"/>
                <Setter Property="local:WindowChromeHelper.PressedBrush" Value="#B91C1C"/>
                <Setter Property="local:WindowChromeHelper.FocusBrush" Value="{DynamicResource WindowButtonCloseHoverBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Grid x:Name="circleRoot" Width="30" Height="30"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="circleScale" CenterX="15" CenterY="15"/>
                                    </Grid.RenderTransform>
                                    <Border x:Name="hoverLayer" CornerRadius="{DynamicResource WindowButtonCornerRadius}"
                                            Background="{TemplateBinding local:WindowChromeHelper.HoverBrush}" Opacity="0"/>
                                    <Border x:Name="pressLayer" CornerRadius="{DynamicResource WindowButtonCornerRadius}"
                                            Background="{TemplateBinding local:WindowChromeHelper.PressedBrush}" Opacity="0"/>
                                    <Border x:Name="focusRing" CornerRadius="{DynamicResource WindowButtonCornerRadius}" BorderThickness="1.5" Opacity="0"
                                            BorderBrush="{TemplateBinding local:WindowChromeHelper.FocusBrush}"/>
                                </Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter.RenderTransform>
                                        <ScaleTransform x:Name="glyphScale" CenterX="7" CenterY="7"/>
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="hoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                                <DoubleAnimation Storyboard.TargetName="glyphScale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.12"/>
                                                <DoubleAnimation Storyboard.TargetName="glyphScale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="hoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                                <DoubleAnimation Storyboard.TargetName="glyphScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                                                <DoubleAnimation Storyboard.TargetName="glyphScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="pressLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08"/>
                                                <DoubleAnimation Storyboard.TargetName="circleScale" Storyboard.TargetProperty="ScaleX" To="0.9" Duration="0:0:0.08"/>
                                                <DoubleAnimation Storyboard.TargetName="circleScale" Storyboard.TargetProperty="ScaleY" To="0.9" Duration="0:0:0.08"/>
                                                <DoubleAnimation Storyboard.TargetName="glyphScale" Storyboard.TargetProperty="ScaleX" To="0.92" Duration="0:0:0.08"/>
                                                <DoubleAnimation Storyboard.TargetName="glyphScale" Storyboard.TargetProperty="ScaleY" To="0.92" Duration="0:0:0.08"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="pressLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="circleScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="circleScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="glyphScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="glyphScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="focusRing" Property="Opacity" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Вариант кнопки «закрыть» для акцентной шапки: базовый цвет значка
                 контрастен фактическому акценту (issue #26), красная подложка
                 при наведении/нажатии наследуется из базового стиля. -->
            <Style x:Key="WindowControlCloseButtonOnAccent" TargetType="Button" BasedOn="{StaticResource WindowControlCloseButton}">
                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            </Style>

            <!-- ===================== Кнопки окна macOS «светофор» (Задача 3) =====================
                 Три цветных круга: красный «закрыть», жёлтый «свернуть», зелёный «развернуть».
                 В отличие от обычных кнопок (подложка появляется только при наведении) круг
                 «светофора» виден всегда; его цвет — HoverBrush кнопки: у «свернуть»/«развернуть»
                 кисть выставляет код (WindowButtonMinimizeHoverBrush/WindowButtonMaximizeHoverBrush),
                 у «закрыть» — WindowButtonCloseHoverBrush. Значок тёмный, как у настоящих кнопок
                 macOS; при нажатии круг затемняется полупрозрачным чёрным слоем (PressedBrush). -->
            <Style x:Key="WindowControlButtonMacOS" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
                <Setter Property="Foreground" Value="#1F1F1F"/>
                <Setter Property="local:WindowChromeHelper.HoverBrush" Value="{DynamicResource WindowButtonHoverBrush}"/>
                <Setter Property="local:WindowChromeHelper.PressedBrush" Value="#33000000"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Grid x:Name="circleRoot" Width="30" Height="30"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="circleScale" CenterX="15" CenterY="15"/>
                                    </Grid.RenderTransform>
                                    <!-- Цветной круг «светофора»: всегда видим (Opacity="1"). -->
                                    <Border x:Name="hoverLayer" CornerRadius="{DynamicResource WindowButtonCornerRadius}"
                                            Background="{TemplateBinding local:WindowChromeHelper.HoverBrush}" Opacity="1"/>
                                    <Border x:Name="pressLayer" CornerRadius="{DynamicResource WindowButtonCornerRadius}"
                                            Background="{TemplateBinding local:WindowChromeHelper.PressedBrush}" Opacity="0"/>
                                    <Border x:Name="focusRing" CornerRadius="{DynamicResource WindowButtonCornerRadius}" BorderThickness="1.5" Opacity="0"
                                            BorderBrush="{TemplateBinding local:WindowChromeHelper.FocusBrush}"/>
                                </Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter.RenderTransform>
                                        <ScaleTransform x:Name="glyphScale" CenterX="7" CenterY="7"/>
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="glyphScale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.12"/>
                                                <DoubleAnimation Storyboard.TargetName="glyphScale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="glyphScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                                                <DoubleAnimation Storyboard.TargetName="glyphScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="pressLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08"/>
                                                <DoubleAnimation Storyboard.TargetName="circleScale" Storyboard.TargetProperty="ScaleX" To="0.9" Duration="0:0:0.08"/>
                                                <DoubleAnimation Storyboard.TargetName="circleScale" Storyboard.TargetProperty="ScaleY" To="0.9" Duration="0:0:0.08"/>
                                                <DoubleAnimation Storyboard.TargetName="glyphScale" Storyboard.TargetProperty="ScaleX" To="0.92" Duration="0:0:0.08"/>
                                                <DoubleAnimation Storyboard.TargetName="glyphScale" Storyboard.TargetProperty="ScaleY" To="0.92" Duration="0:0:0.08"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="pressLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="circleScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="circleScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="glyphScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="glyphScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="focusRing" Property="Opacity" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Вариант «на акценте»: круг остаётся цветным (HoverBrush выставляет код),
                 значок тёмный — на цветном круге он читается и на акцентной шапке. -->
            <Style x:Key="WindowControlButtonMacOSOnAccent" TargetType="Button" BasedOn="{StaticResource WindowControlButtonMacOS}">
                <Setter Property="Foreground" Value="#1F1F1F"/>
            </Style>

            <!-- Кнопка «закрыть» macOS: красный круг (WindowButtonCloseHoverBrush),
                 при нажатии — темнее (как у обычной кнопки «закрыть»). -->
            <Style x:Key="WindowControlCloseButtonMacOS" TargetType="Button" BasedOn="{StaticResource WindowControlButtonMacOS}">
                <Setter Property="local:WindowChromeHelper.HoverBrush" Value="{DynamicResource WindowButtonCloseHoverBrush}"/>
                <Setter Property="local:WindowChromeHelper.PressedBrush" Value="#B91C1C"/>
                <Setter Property="local:WindowChromeHelper.FocusBrush" Value="{DynamicResource WindowButtonCloseHoverBrush}"/>
            </Style>

            <Style x:Key="WindowControlCloseButtonMacOSOnAccent" TargetType="Button" BasedOn="{StaticResource WindowControlCloseButtonMacOS}">
                <Setter Property="Foreground" Value="#1F1F1F"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
