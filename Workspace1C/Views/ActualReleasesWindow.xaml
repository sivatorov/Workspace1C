<Window x:Class="Workspace1C.ActualReleasesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        xmlns:win="clr-namespace:Workspace1C"
        Title="{loc:Loc Updates.ActualReleasesTitle}"
        Icon="{StaticResource AppIcon}"
        Width="860" Height="600"
        MinHeight="460" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <win:UpdateStatusToTextConverter x:Key="StatusConv"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Галочка-фильтр «Только в базах» (issue #375): темизируется, как в остальных окнах. -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource ModernMaterialCheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="SelectAllButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопки — единый контракт (issue #26): «основная» — акцентная ModernButton
             (заливка акцентом темы, текст по WCAG), «контурная» — вторичная
             SecondaryButton. Имена PrimaryButtonStyle/OutlineButtonStyle сохранены,
             чтобы ссылки из разметки не менялись. -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
        <Style x:Key="OutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="15" FontWeight="SemiBold" Text="{loc:Loc Updates.ActualReleasesTitle}"/>
        <TextBlock Grid.Row="1" FontSize="12" Margin="0,6,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap" Text="{loc:Loc Updates.OpenCatalog}"/>

        <!-- Таблица отслеживаемых конфигураций -->
        <Border Grid.Row="2" Margin="0,12,0,0"
                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                CornerRadius="6" Background="{DynamicResource CardBackgroundBrush}">
            <DataGrid x:Name="RowsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserSortColumns="False" RowHeaderWidth="0" SelectionMode="Single"
                      BorderThickness="0" Background="Transparent" GridLinesVisibility="None"
                      RowHeight="40" AlternationCount="2">
                <!-- Вертикальное выравнивание содержимого ячеек по центру (issue #264).
                     Для DataGridTextColumn центрирование задаётся через ElementStyle на самой колонке
                     (стиль TextBlock), т.к. VerticalContentAlignment на DataGridCell на текст колонки не действует. -->
                <DataGrid.Resources>
                    <Style x:Key="CenteredCellText" TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <!-- Горизонтальные отступы текста от краёв ячейки (issue #266). -->
                        <Setter Property="Margin" Value="8,0,8,0"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </DataGrid.CellStyle>
                <!-- Подсветка только нечётных строк (1-я, 3-я, 5-я…): AlternationIndex начинается
                     с 0, поэтому нечётным позициям строк соответствует индекс 0 (issue #264).
                     Текущая строка подсвечивается и при наведении, и при клавиатурной навигации
                     (SelectionMode="Single", текущая = выбранная). -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                <Setter Property="Background" Value="{DynamicResource ZebraRowBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ItemSelectedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ItemSelectedBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Width="2*" Header="{loc:Loc Updates.Name}" Binding="{Binding Name}"
                                        ElementStyle="{StaticResource CenteredCellText}"/>

                    <DataGridTemplateColumn Width="*" Header="{loc:Loc Updates.LatestVersion}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LatestVersion}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="8,0,8,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasNewer}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Width="*" Header="{loc:Loc Updates.Status}"
                                        Binding="{Binding Status, Converter={StaticResource StatusConv}}"
                                        ElementStyle="{StaticResource CenteredCellText}"/>

                    <!-- Заголовок сокращён до «Ссылка» (issue #267): полный текст
                         «Ссылка на каталог релизов» не влазил в шапку колонки. -->
                    <DataGridTemplateColumn Width="*" Header="{loc:Loc Updates.UrlShort}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Url}" VerticalAlignment="Center" FontSize="11"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="8,0,8,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Колонка прогресса проверки/скачивания (issue #267): «странная пустая
                         колонка» — она всегда была видима, даже когда нет ни одной операции.
                         По умолчанию скрыта; показывается, когда идёт проверка или загрузка
                         хотя бы одной строки (см. UpdateProgressColumnVisibility). -->
                    <DataGridTemplateColumn x:Name="ProgressColumn" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <ProgressBar Height="4" Maximum="1" Minimum="0" Value="{Binding Progress}"
                                                 Foreground="{DynamicResource AccentBrush}">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                    <TextBlock x:Name="ProgressLabel" FontSize="10" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value=""/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecking}" Value="True">
                                                        <Setter Property="Text" Value="…"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                        <Setter Property="Text" Value="{Binding Progress, StringFormat={}{0:P0}}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="44">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SelectAllButtonStyle}"
                                        Command="{Binding CheckCommand}"
                                        ToolTip="{loc:Loc Updates.Check}">
                                    <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16"
                                                             Foreground="{DynamicResource AccentBrush}"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="44">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SelectAllButtonStyle}"
                                        Command="{Binding DownloadCommand}"
                                        ToolTip="{loc:Loc Updates.Download}">
                                    <materialDesign:PackIcon Kind="DownloadOutline" Width="16" Height="16"
                                                             Foreground="#16A34A"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Нижняя панель: Пакетная проверка / Закрыть -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Height="36" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding CheckAllCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CloudDownloadOutline" Width="16" Height="16"/>
                        <TextBlock Text="{loc:Loc Updates.BatchCheck}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Фильтр «Только в базах» (issue #375): по умолчанию включён; список
                     фильтруется конфигурациями, присутствующими в списке баз (привязка
                     или эвристика). Подсказка объясняет правила поиска конфигурации и
                     сопоставления редакций (точное совпадение или префикс по сегментам). -->
                <CheckBox x:Name="OnlyInBasesCheck" Content="{loc:Loc Updates.OnlyInBases}"
                          IsChecked="True" VerticalAlignment="Center" Margin="16,0,0,0"
                          ToolTip="{loc:Loc Updates.OnlyInBasesTooltip}"
                          Checked="OnOnlyInBasesChanged" Unchecked="OnOnlyInBasesChanged"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="120" Height="36" Style="{StaticResource OutlineButtonStyle}" Click="OnClose_Click">
                    <TextBlock Text="{loc:Loc Updates.Close}" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>