<Window x:Class="Workspace1C.BaseNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Icon="{StaticResource AppIcon}"
        Height="580" Width="780" MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <!-- Issue #61: у явного стиля FieldLabel Foreground не наследуется от неявного
                 стиля окна — задаём кисть подписи формы явно, иначе в тёмной теме
                 подписи полей остаются чёрными. -->
            <Setter Property="Foreground" Value="{DynamicResource FormLabelBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <!-- Заголовок окна + имя базы -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock x:Name="EditorTitle" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock x:Name="BaseSubtitle" FontSize="12" Margin="12,0,0,0"
                       Foreground="{DynamicResource FormLabelBrush}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Кнопки внизу -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="SaveButton" Content="{loc:Loc Common.Save}" Width="110"
                    Style="{StaticResource ModernButton}" Margin="0,0,8,0" IsDefault="True"
                    Click="OnSaveClick"/>
            <!-- «Отмена» — вторичная кнопка (фон карточки + контур, hover-рамка),
                 как во всех диалогах после v1.0.1.46 (issue #107). -->
            <Button x:Name="CancelButton" Content="{loc:Loc Common.Cancel}" Width="110"
                    Style="{StaticResource SecondaryButton}" IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Markdown-карточка: редактор + предпросмотр -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,4">
                <TextBlock Text="{loc:Loc Notes.MarkdownLabel}" Style="{StaticResource FieldLabel}"/>
                <CheckBox x:Name="PreviewCheck" Content="{loc:Loc Notes.Preview}" Margin="16,0,0,0"
                          VerticalAlignment="Center" Checked="OnPreviewToggled" Unchecked="OnPreviewToggled"/>
            </StackPanel>
            <Grid Grid.Row="1">
                <TextBox x:Name="MarkdownBox" Style="{StaticResource ModernTextBox}"
                         AcceptsReturn="True" AcceptsTab="True"
                         Padding="6,4" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                <FlowDocumentScrollViewer x:Name="PreviewViewer" Visibility="Collapsed"
                                          BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" Padding="8"/>
            </Grid>

            <!-- Секреты: поле пароля/ключа только в зашифрованном виде на диске -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,4">
                <TextBlock Text="{loc:Loc Notes.SecretsHeader}" Style="{StaticResource FieldLabel}"/>
                <Button x:Name="AddSecretButton" Content="{loc:Loc Notes.AddSecret}" Margin="16,0,0,0"
                        Style="{StaticResource ModernButton}" Click="OnAddSecretClick"/>
            </StackPanel>
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="SecretsPanel" Margin="0,2,0,0"/>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
