<Window x:Class="Workspace1C.BatchOperationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Icon="{StaticResource AppIcon}"
        Height="620" Width="700" MinHeight="460" MinWidth="580"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HintText" Grid.Row="0" Margin="0,0,0,10"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

        <!-- Список баз с флажками -->
        <ListBox x:Name="ItemsList" Grid.Row="1"
                 BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding IsSelectable}"
                              Margin="2,3" Cursor="Hand">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="{loc:Loc Selection.SelectAll}" Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}" Padding="12,5" Margin="0,0,8,0"
                    Click="OnSelectAll_Click"/>
            <Button Content="{loc:Loc Selection.None}" Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}" Padding="12,5"
                    Click="OnSelectNone_Click"/>
        </StackPanel>

        <!-- Путь: каталог выгрузки .dt/.cf или файл конфигурации .cf.
             Ниже — опции массовой выгрузки (issue #92): шаблон имени файла
             с токенами {Имя} и {Дата} и переключатель формата DT/CF. -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PathLabel" Grid.Column="0" VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBox x:Name="PathBox" Grid.Column="1" VerticalContentAlignment="Center"
                         Text="{Binding PathText, UpdateSourceTrigger=PropertyChanged}"/>
                <Button x:Name="BrowseButton" Grid.Column="2" Content="…" Width="34" Margin="6,0,0,0"
                        Style="{StaticResource ModernButton}"
                        Background="{DynamicResource ItemHoverBrush}"
                        Click="OnBrowse_Click"/>
            </Grid>
            <StackPanel x:Name="DumpOptionsPanel" Orientation="Horizontal" Margin="0,8,0,0"
                        Visibility="Collapsed">
                <TextBlock x:Name="TemplateLabel" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TemplateBox" Width="260" VerticalContentAlignment="Center"
                         Text="{Binding Template, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{loc:Loc BatchOps.TemplateHint}"/>
                <RadioButton x:Name="KindDtRadio" GroupName="BatchDumpKind" Margin="16,0,0,0"
                             VerticalAlignment="Center" Checked="OnKindDt_Checked"/>
                <RadioButton x:Name="KindCfRadio" GroupName="BatchDumpKind" Margin="12,0,0,0"
                             VerticalAlignment="Center" Checked="OnKindCf_Checked"/>
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="LogHeader" Grid.Row="4" Margin="0,14,0,6" FontWeight="SemiBold"
                   Text="{loc:Loc BatchOps.Log}"/>

        <!-- Построчный лог прогона -->
        <ListBox x:Name="LogList" Grid.Row="5"
                 BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                 IsHitTestVisible="False"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                               FontFamily="Consolas"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="2,1"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="SummaryText" Grid.Row="6" Margin="0,10,0,0" FontWeight="SemiBold"
                   TextWrapping="Wrap" Text="{Binding Summary}"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="StopButton" Width="130" Margin="0,0,8,0" IsEnabled="False"
                    Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Click="OnStop_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⏹" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc BatchOps.Stop}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="CloseButton" Width="110" Margin="0,0,8,0" IsCancel="True"
                    Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Click="OnClose_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✖" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Common.Close}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="RunButton" Width="190" IsDefault="True"
                    Style="{StaticResource ModernButton}" Click="OnRun_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="▶" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="RunButtonText" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
