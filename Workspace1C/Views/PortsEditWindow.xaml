<Window x:Class="Workspace1C.PortsEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Icon="{StaticResource AppIcon}"
        Width="480" Height="360"
        MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Основная зелёная кнопка -->
        <!-- Кнопки — единый контракт (issue #26): акцентная ModernButton и вторичная
             SecondaryButton. Имена PrimaryButtonStyle/OutlineButtonStyle сохранены. -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>

        <!-- Серая кнопка-контур -->
        <Style x:Key="OutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="EditorTitle" Grid.Row="0" FontSize="15" FontWeight="SemiBold"/>

        <!-- Таблица «порт | описание сервиса»: правится только порт (issue #335). -->
        <DataGrid x:Name="PortsGrid" Grid.Row="1" Margin="0,14,0,0"
                  AutoGenerateColumns="False" HeadersVisibility="Column"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserSortColumns="False" RowHeaderWidth="0" SelectionMode="Single"
                  SelectionUnit="FullRow" GridLinesVisibility="Horizontal"
                  RowHeight="36" AlternationCount="2"
                  AlternatingRowBackground="{DynamicResource ZebraRowBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Width="*" Header="{loc:Loc Ports.Service}"
                                    Binding="{Binding Service}" IsReadOnly="True"/>
                <DataGridTextColumn Width="100" Header="{loc:Loc Ports.Port}"
                                    Binding="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Width="140" Height="34" Margin="0,0,10,0" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" Click="OnOkClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔌" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Ports.Check}" Margin="0,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="120" Height="34" IsCancel="True" Style="{StaticResource OutlineButtonStyle}"
                    Click="OnCancelClick">
                <TextBlock Text="{loc:Loc Updates.Cancel}" VerticalAlignment="Center"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>