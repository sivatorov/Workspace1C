<Window x:Class="Workspace1C.BackupScenarioEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Title="Сценарий резервирования"
        Width="620" Height="640" MinWidth="540" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="13"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <!-- Темизация окна «Сценарий резервирования» (issue #291): стили из LightTheme/DarkTheme,
             как у остальных окон (ConnectionSettingsWindow, AppLockWindow и др.). -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ModernButton}"/>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}"/>
        <Style TargetType="CheckBox" BasedOn="{StaticResource ModernMaterialCheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <!-- Футер диалога (аудит UI, пп. 3.3 и 5.2): единые MinWidth/Padding и ключи локализации. -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Content="{loc:Loc Common.Save}" MinWidth="96" Margin="0,0,8,0" Padding="12,5" IsDefault="True" Click="Ok_Click"/>
            <Button Content="{loc:Loc Common.Cancel}" MinWidth="96" Padding="12,5" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Локализация (аудит UI, п. 5.2): литералы заменены ключами Backup.*.
                     Конструктор окна дополнительно перезаписывает их через LocalizationManager.T. -->
                <TextBlock x:Name="NameLabel" Text="{loc:Loc Backup.Name}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,10"/>

                <TextBlock x:Name="TemplateLabel" Text="{loc:Loc Backup.FileNameTemplate}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="TemplateBox" Text="{Binding FileNameTemplate, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,2"/>
                <TextBlock x:Name="TemplateHint" Text="" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="2,0,0,10"/>

                <CheckBox x:Name="TimestampCheck" Content="{loc:Loc Backup.IncludeTimestamp}" IsChecked="{Binding IncludeTimestamp}" Margin="0,0,0,10"/>

                <TextBlock x:Name="FormatLabel" Text="{loc:Loc Backup.Format}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="FormatCombo" SelectedItem="{Binding Format}" HorizontalAlignment="Left" MinWidth="160" Margin="0,0,0,10"/>

                <TextBlock x:Name="EngineLabel" Text="{loc:Loc Backup.Engine}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="EngineCombo" HorizontalAlignment="Left" MinWidth="240" Margin="0,0,0,2"/>
                <TextBlock x:Name="EngineHint" Text="" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="2,0,0,10"/>

                <TextBlock x:Name="PrefixLabel" Text="{loc:Loc Backup.BasePrefix}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="PrefixBox" Text="{Binding BasePrefix, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,10"/>

                <TextBlock x:Name="DirsLabel" Text="{loc:Loc Backup.TargetDirectories}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button x:Name="AddDirButton" Content="{loc:Loc Common.Browse}" MinWidth="96" Padding="12,5" Click="AddDir_Click"/>
                    <Button x:Name="RemoveDirButton" Content="{loc:Loc Common.Delete}" MinWidth="96" Margin="8,0,0,0" Padding="12,5" Click="RemoveDir_Click"/>
                </StackPanel>
                <ListBox x:Name="DirList" ItemsSource="{Binding TargetDirectories}" Height="110" Margin="0,0,0,10"/>

                <TextBlock x:Name="RotationLabel" Text="{loc:Loc Backup.Rotation}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="KeepCountLabel" Text="{loc:Loc Backup.KeepCount}" Margin="0,0,0,2"/>
                        <TextBox x:Name="KeepCountBox" Text="{Binding KeepCount, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="AgeDaysLabel" Text="{loc:Loc Backup.DeleteOlderThanDays}" Margin="0,0,0,2"/>
                        <TextBox x:Name="AgeDaysBox" Text="{Binding DeleteOlderThanDays, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="RotationHint" Text="" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="2,0,0,10"/>

                <TextBlock x:Name="CredLabel" Text="{loc:Loc Backup.Credentials}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <CheckBox x:Name="UseAuthCheck" Content="{loc:Loc Backup.UseInfobaseAuth}" IsChecked="{Binding UseInfobaseAuth}" Margin="0,0,0,8"/>

                <TextBlock x:Name="UserLabel" Text="{loc:Loc Backup.User}" Margin="0,0,0,2"/>
                <TextBox x:Name="UserBox" Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,8"/>

                <TextBlock x:Name="PasswordLabel" Text="{loc:Loc Backup.Password}" Margin="0,0,0,2"/>
                <PasswordBox x:Name="PasswordBox" Padding="4" Margin="0,0,0,4"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>