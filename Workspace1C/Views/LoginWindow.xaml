<Window x:Class="Workspace1C.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        mc:Ignorable="d"
        Title="{loc:Loc Auth.Title}"
        Icon="{StaticResource AppIcon}"
        Height="360" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <!-- Implicit-стили для корректного отображения в тёмной теме -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ Подсказка ============ -->
        <TextBlock Grid.Row="0" x:Name="HintLabel" Text="{loc:Loc Auth.SelectAccountHint}"
                   TextWrapping="Wrap" Margin="0,0,0,12" Opacity="0.85"/>

        <!-- ============ Список учётных записей ============ -->
        <ListBox x:Name="ProfilesList" Grid.Row="1" Margin="0,0,0,12"
                 SelectionChanged="OnProfilesList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="LockIcon" Text="🔒" Margin="0,0,8,0" VerticalAlignment="Center" Opacity="0.0"/>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ============ Поле пароля ============ -->
        <StackPanel Grid.Row="2" x:Name="PasswordPanel" Visibility="Collapsed" Margin="0,0,0,12">
            <TextBlock Text="{loc:Loc Auth.Password}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordInput" Padding="8,6" KeyDown="OnPasswordInput_KeyDown"/>
        </StackPanel>

        <!-- ============ Ошибка ============ -->
        <TextBlock Grid.Row="3" x:Name="ErrorLabel" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                   Margin="0,0,0,12" Visibility="Collapsed"/>

        <!-- ============ Кнопки ============ -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="110" Margin="0,0,8,0"
                    IsCancel="True"
                    Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="✖" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Common.Cancel}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="LoginButton" Width="130"
                    IsDefault="True"
                    Style="{StaticResource ModernButton}"
                    Click="OnLogin_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource SuccessBrush}" Text="✔" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Auth.Login}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
