<Window x:Class="Workspace1C.ConnectionStringInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        mc:Ignorable="d"
        Title="{loc:Loc ConnectionStringInput.Title}"
        Icon="{StaticResource AppIcon}"
        Height="230" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <!-- Implicit-стили для корректного отображения в тёмной теме -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ Подпись ============ -->
        <TextBlock Grid.Row="0" Text="{loc:Loc ConnectionStringInput.Label}" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,0,0,8"
                   Text="{loc:Loc ConnectionStringInput.Hint}"/>

        <!-- ============ Поле ввода ============ -->
        <TextBox x:Name="InputBox" Grid.Row="2" MinHeight="34"
                 VerticalContentAlignment="Center"
                 TextChanged="OnInputBox_TextChanged"
                 KeyDown="OnInputBox_KeyDown"/>

        <!-- ============ Кнопки ============ -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Вставить из буфера обмена -->
            <Button Grid.Column="0" Height="38" Padding="12,0" Margin="0,0,10,0"
                    Style="{DynamicResource SecondaryButton}"
                    Click="OnPasteClipboard_Click"
                    ToolTip="{loc:Loc ConnectionStringInput.PasteTooltip}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ContentPaste" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc ConnectionStringInput.Paste}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>

            <!-- Применить / Отмена — единый контракт (issue #26): акцентная
                 ModernButton и вторичная SecondaryButton. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Width="150" Height="38" Margin="0,0,10,0"
                        IsDefault="True" Click="OnOk_Click"
                        Style="{DynamicResource ModernButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Check" Width="16" Height="16"
                                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Common.Apply}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Width="140" Height="38" IsCancel="True"
                        Style="{DynamicResource SecondaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16"
                                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Common.Cancel}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
