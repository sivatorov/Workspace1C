<Window x:Class="Workspace1C.ClearHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Title="{loc:Loc ClearHistory.Title}"
        Icon="{StaticResource AppIcon}"
        Width="620" Height="520"
        MinHeight="400" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Кнопки «Отметить все / Снять все / Инвертировать»: без рамки, с подсветкой при наведении -->
        <Style x:Key="SelectAllButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" FontSize="15" FontWeight="SemiBold" Text="{loc:Loc ClearHistory.TitleHeader}"/>
        <TextBlock Grid.Row="1" FontSize="12" Margin="0,6,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   Text="{loc:Loc ClearHistory.Subtitle}"/>

        <!-- Таблица баз -->
        <Border Grid.Row="2" Margin="0,12,0,0"
                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                CornerRadius="6" Background="{DynamicResource CardBackgroundBrush}">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,0,1"
                        Padding="8,4" Background="Transparent">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="CheckAllButton" Style="{StaticResource SelectAllButtonStyle}"
                                ToolTip="{loc:Loc ClearHistory.Button.CheckAllTooltip}"
                                Click="OnCheckAllClick">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckboxMultipleMarked" Width="16" Height="16"
                                                         Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc ClearHistory.Button.CheckAll}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="UncheckAllButton"
                                Style="{StaticResource SelectAllButtonStyle}"
                                Margin="16,0,0,0" ToolTip="{loc:Loc ClearHistory.Button.UncheckAllTooltip}"
                                Click="OnUncheckAllClick">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckboxMultipleBlankOutline" Width="16" Height="16"
                                                         Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc ClearHistory.Button.UncheckAll}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="InvertButton"
                                Style="{StaticResource SelectAllButtonStyle}"
                                Margin="16,0,0,0" ToolTip="{loc:Loc ClearHistory.Button.InvertTooltip}"
                                Click="OnInvertClick">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="SelectInverse" Width="16" Height="16"
                                                         Foreground="{DynamicResource PurpleAccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc ClearHistory.Button.Invert}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <DataGrid x:Name="BasesGrid" AutoGenerateColumns="False" IsReadOnly="False"
                          HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="False" RowHeaderWidth="0" SelectionMode="Single"
                          BorderThickness="0" Background="Transparent" GridLinesVisibility="None"
                          RowHeight="32" AlternatingRowBackground="{DynamicResource CardBackgroundBrush}">
                    <DataGrid.Columns>
                        <!-- Флажок через шаблонную колонку с CheckBox: срабатывает с первого клика,
                             без предварительного фокуса (по аналогии с DetectConfigurationsWindow). -->
                        <DataGridTemplateColumn Width="44">
                            <DataGridTemplateColumn.Header>
                                <TextBlock x:Name="CheckedHeaderText" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{loc:Loc ClearHistory.Column.CheckedHeaderFormat}"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Width="*" Header="{loc:Loc ClearHistory.Column.Name}"
                                            Binding="{Binding Name}" IsReadOnly="True"/>
                        <DataGridTextColumn Width="Auto" Header="{loc:Loc ClearHistory.Column.Count}"
                                            Binding="{Binding HistoryCount}" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Нижняя панель: кнопки Очистить / Закрыть -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SummaryText" Grid.Column="0" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>

            <!-- Единый контракт кнопок (issue #26): «Очистить» — опасная DangerButton
                 (красная заливка, белый текст), «Закрыть» — вторичная SecondaryButton. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ClearButton" Width="180" Height="36" Margin="0,0,10,0" IsDefault="True"
                        Click="OnClear_Click"
                        Style="{DynamicResource DangerButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="DeleteSweep" Width="16" Height="16"
                                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc ClearHistory.Button.Clear}" VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Width="140" Height="36" IsCancel="True"
                        Style="{DynamicResource SecondaryButton}" Click="OnClose_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Common.Close}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
