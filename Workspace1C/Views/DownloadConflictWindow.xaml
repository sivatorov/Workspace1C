<Window x:Class="Workspace1C.DownloadConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Title="{loc:Loc Updates.FileAlreadyDownloadingTitle}"
        Width="520" SizeToContent="Height" MaxWidth="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource ContentBackgroundBrush}"
        FontSize="13">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <!-- Кнопки — единый контракт (issue #26): акцентная ModernButton и вторичная
             SecondaryButton. Имена PrimaryButtonStyle/OutlineButtonStyle сохранены. -->
        <Style x:Key="OutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CancelAndRestartButton" MinWidth="150" Height="34" Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButtonStyle}" Click="OnCancelAndRestartClick">
                    <TextBlock Text="{loc:Loc Updates.FileAlreadyDownloadingCancel}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Button>
                <Button MinWidth="110" Height="34" Margin="0,0,8,0"
                        Style="{StaticResource OutlineButtonStyle}" Click="OnWaitClick">
                    <TextBlock Text="{loc:Loc Updates.FileAlreadyDownloadingWait}" VerticalAlignment="Center"/>
                </Button>
                <Button MinWidth="110" Height="34" Style="{StaticResource OutlineButtonStyle}"
                        Click="OnCancelClick" IsCancel="True">
                    <TextBlock Text="{loc:Loc Updates.Cancel}" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
