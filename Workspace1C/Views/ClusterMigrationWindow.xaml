<!-- Окно «Миграция между кластерами 1С» (issue #41, переработка по комментарию 7OH,
     Windows/WPF): перенос информационных баз между кластерами серверов 1С. Двухпанельная
     раскладка: группа «Источник» (Сервер 1С + Подключиться, Кластер + Получить базы,
     Загружено баз) и группа «Приёмник» (те же поля; кнопка «Получить статусы» проставляет
     статусы приёмника «Есть в кластере»/пусто по совпадению имени). Сервера источника и
     приёмника не должны пересекаться — проверяется по выбору, но из списков не удаляются.
     Галочки: после получения баз источника — ВСЕ; после получения статусов приёмника —
     только там, где базы нет в приёмнике. Доступность «Мигрировать» зависит от галочек
     и статусов. Вся логика — в чистой ClusterMigrationViewModel; окно — тонкая обёртка. -->
<Window x:Class="Workspace1C.ClusterMigrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Icon="{StaticResource AppIcon}"
        Height="700" Width="1200" MinHeight="520" MinWidth="1000"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="CenteredCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <Style x:Key="CenteredColumnHeader" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Двухпанельная раскладка: «Источник» и «Приёмник» (issue #41). -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===================== Группа «Источник» ===================== -->
            <GroupBox Grid.Column="0" Header="{loc:Loc ClusterMigration.SourceGroup}"
                      Padding="12,8" BorderBrush="{DynamicResource BorderBrushColor}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Сервер 1С + Подключиться. -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{loc:Loc ClusterMigration.SourceServer}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="SourceServerCombo" Width="300" Style="{StaticResource ModernComboBox}"
                                  ItemsSource="{Binding AvailableSourceServers}"
                                  SelectedItem="{Binding SelectedSourceServer, Mode=TwoWay}"
                                  VerticalContentAlignment="Center" Padding="6,2">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Description}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBlock VerticalAlignment="Center" Opacity="0.6" Margin="6,0,0,0">
                                            <Run Text="{Binding Address, Mode=OneWay}"/><Run Text=":"/><Run Text="{Binding Port, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Name="SourceConnectButton" Style="{StaticResource ModernButton}"
                                Background="{DynamicResource ItemHoverBrush}" Padding="10,5" Margin="10,0,0,0"
                                Click="OnSourceConnect_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔌" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc ClusterMigration.Connect}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Кластер + Получить базы. -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{loc:Loc ClusterMigration.SourceCluster}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="SourceClusterCombo" Width="300" Style="{StaticResource ModernComboBox}"
                                  ItemsSource="{Binding SourceClusters}" SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedSourceClusterId}"
                                  VerticalContentAlignment="Center" Padding="6,2">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Port, StringFormat=' [{0}]'}" Opacity="0.6"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Name="SourceLoadBasesButton" Style="{StaticResource ModernButton}"
                                Background="{DynamicResource ItemHoverBrush}" Padding="10,5" Margin="10,0,0,0"
                                Click="OnSourceLoadBases_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⟳" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc ClusterMigration.LoadBases}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- «Загружено баз» под «Кластер». -->
                    <TextBlock Grid.Row="2" x:Name="SourceStatusText" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding SourceStatusText}"/>
                </Grid>
            </GroupBox>

            <!-- ===================== Группа «Приёмник» ===================== -->
            <GroupBox Grid.Column="2" Header="{loc:Loc ClusterMigration.TargetGroup}"
                      Padding="12,8" BorderBrush="{DynamicResource BorderBrushColor}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Сервер 1С + Подключиться. -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{loc:Loc ClusterMigration.TargetServer}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="TargetServerCombo" Width="300" Style="{StaticResource ModernComboBox}"
                                  ItemsSource="{Binding AvailableTargetServers}"
                                  SelectedItem="{Binding SelectedTargetServer, Mode=TwoWay}"
                                  VerticalContentAlignment="Center" Padding="6,2">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Description}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBlock VerticalAlignment="Center" Opacity="0.6" Margin="6,0,0,0">
                                            <Run Text="{Binding Address, Mode=OneWay}"/><Run Text=":"/><Run Text="{Binding Port, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Name="TargetConnectButton" Style="{StaticResource ModernButton}"
                                Background="{DynamicResource ItemHoverBrush}" Padding="10,5" Margin="10,0,0,0"
                                Click="OnTargetConnect_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔌" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc ClusterMigration.Connect}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Кластер + Получить статусы. -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{loc:Loc ClusterMigration.TargetCluster}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="TargetClusterCombo" Width="300" Style="{StaticResource ModernComboBox}"
                                  ItemsSource="{Binding TargetClusters}" SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedTargetClusterId}"
                                  VerticalContentAlignment="Center" Padding="6,2">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Port, StringFormat=' [{0}]'}" Opacity="0.6"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Name="TargetGetStatusesButton" Style="{StaticResource ModernButton}"
                                Background="{DynamicResource ItemHoverBrush}" Padding="10,5" Margin="10,0,0,0"
                                Click="OnTargetGetStatuses_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⟳" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc ClusterMigration.GetStatuses}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Статус приёмника под «Кластер». -->
                    <TextBlock Grid.Row="2" x:Name="TargetStatusText" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding TargetStatusText}"/>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Чеклист баз источника: флажок, имя, описание, кластер, подключение,
             статус источника, статус приёмника. -->
        <DataGrid x:Name="BasesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                  ColumnHeaderStyle="{StaticResource CenteredColumnHeader}"
                  SelectionMode="Single" SelectionUnit="FullRow" GridLinesVisibility="Horizontal"
                  AlternationCount="2"
                  RowHeight="38" RowBackground="{DynamicResource CardBackgroundBrush}"
                  AlternatingRowBackground="{DynamicResource CardBackgroundBrush}"
                  Background="{DynamicResource CardBackgroundBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <!-- issue #76 «Цвета фона строк»: локальные CellStyle/RowStyle наследуют тематические
                 триггеры через BasedOn, а строки жёстко привязаны к кистям темы — без BasedOn
                 выбранная строка красилась системной кистью выделения (светло-серая полоса
                 #E9EBE9 в тёмной теме на неактивном окне). -->
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ItemSelectedBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="44" Header="" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="1.2*" Header="{loc:Loc ClusterMigration.Columns.Name}"
                                    Binding="{Binding Name}" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn Width="1.4*" Header="{loc:Loc ClusterMigration.Columns.Description}"
                                    Binding="{Binding Subtitle}" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn Width="130" Header="{loc:Loc ClusterMigration.Columns.Cluster}"
                                    Binding="{Binding ClusterName}" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn Width="1.6*" Header="{loc:Loc ClusterMigration.Columns.Connection}"
                                    Binding="{Binding ConnectionString}" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn Width="130" Header="{loc:Loc ClusterMigration.Columns.SourceStatus}"
                                    Binding="{Binding SourceStatus}" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn Width="130" Header="{loc:Loc ClusterMigration.Columns.TargetStatus}"
                                    Binding="{Binding TargetStatusDisplay}" ElementStyle="{StaticResource CenteredCellText}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Сводка выделения «Выделено: N из M · будет перенесено: N» + кнопки
             «Выделить все»/«Снять все» (issue #41, комментарий 7OH): сразу под списком,
             НАД галочками-опциями. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="{Binding SelectionSummaryText}" FontSize="12" Opacity="0.8"
                       VerticalAlignment="Center" Margin="0,0,14,0" TextWrapping="Wrap"
                       MaxWidth="380"/>
            <Button x:Name="SelectAllButton" Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}" Padding="12,5"
                    Click="OnSelectAll_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="☑" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Selection.SelectAll}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="SelectNoneButton" Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}" Padding="12,5" Margin="8,0,0,0"
                    Click="OnSelectNone_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="☐" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Selection.None}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Опции: «Создавать группу по имени кластера» + «Не удалять в старом кластере» в одной строке. -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <CheckBox x:Name="GroupByClusterCheck" VerticalAlignment="Center"
                      Content="{loc:Loc ClusterMigration.GroupByCluster}"
                      IsChecked="{Binding UseClusterGrouping}"/>
            <CheckBox x:Name="KeepInSourceCheck" VerticalAlignment="Center" Margin="18,0,0,0"
                      Content="{loc:Loc ClusterMigration.KeepInSource}"
                      IsChecked="{Binding KeepInSource}"/>
        </StackPanel>

        <!-- Тип СУБД + Сервер СУБД (issue #41, комментарий 7OH): rac «infobase create»
             требует непустые значения "dbms" и "db-server"; для приёмника на другом
             сервере СУБД значения источника не подходят. Строка выше учётных данных СУБД. -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:Loc ClusterMigration.Dbms}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="DbmsBox" Grid.Column="1" Style="{StaticResource ModernComboBox}"
                      ItemsSource="{Binding DbmsOptions}"
                      SelectedItem="{Binding Dbms, Mode=TwoWay}"
                      VerticalContentAlignment="Center" Padding="6,2"/>
            <TextBlock Grid.Column="2" Text="{loc:Loc ClusterMigration.DbServer}" VerticalAlignment="Center"
                       Margin="14,0,8,0"/>
            <TextBox x:Name="DbServerBox" Grid.Column="3" Style="{StaticResource ModernTextBox}"
                     Text="{Binding DbServer, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
        </Grid>

        <!-- Учётные данные СУБД и локаль в одну линию (локаль — после логина/пароля,
             списоком выбора как при добавлении базы; issue #41, комментарий 7OH). -->
        <Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:Loc ClusterMigration.DbUser}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="DbUserBox" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                     Text="{Binding DbUser, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
            <TextBlock Grid.Column="2" Text="{loc:Loc ClusterMigration.DbPassword}" VerticalAlignment="Center"
                       Margin="14,0,8,0"/>
            <PasswordBox x:Name="DbPasswordBox" Grid.Column="3" Padding="6,4"
                         PasswordChanged="OnDbPasswordChanged"/>
            <TextBlock Grid.Column="4" Text="{loc:Loc ClusterMigration.Locale}" VerticalAlignment="Center"
                       Margin="14,0,8,0"/>
            <ComboBox x:Name="LocaleBox" Grid.Column="5" Style="{StaticResource ModernComboBox}"
                      ItemsSource="{Binding LocaleOptions}"
                      SelectedItem="{Binding Locale, Mode=TwoWay}"
                      MinWidth="110" VerticalContentAlignment="Center" Padding="6,2"/>
        </Grid>

        <!-- Прогресс «N из M: база» + сообщение об ошибке, затем «Мигрировать»/«Отмена». -->
        <StackPanel Grid.Row="6" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="ProgressText" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <!-- Полоса прогресса на всю ширину окна (issue #41: «сделать побольше по
                     ширине, а не только под локалью») — отдельной строкой, растянутой. -->
                <ProgressBar Grid.Row="1" x:Name="BusyProgress" Height="4" MinWidth="200"
                             HorizontalAlignment="Stretch" Margin="0,5,0,0"
                             IsIndeterminate="True" Visibility="Collapsed" Foreground="{DynamicResource InfoBrush}"
                             VerticalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="ErrorText" FontSize="12" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                       Margin="0,6,0,0" Text="{Binding ErrorMessage}"/>
            <!-- Единый контракт кнопок (issue #26): «Мигрировать» — акцентная ModernButton
                 (без жёсткой зелёной заливки и белого текста), «Отмена» — вторичная
                 SecondaryButton. -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="MigrateButton" Style="{StaticResource ModernButton}"
                        Padding="16,5" Margin="0,0,8,0"
                        Click="OnMigrate_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➜" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc ClusterMigration.MigrateButton}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" IsCancel="True"
                        Padding="14,5" Margin="18,0,0,0"
                        Click="OnCancel_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="✖" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Common.Cancel}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
