<UserControl x:Class="Workspace1C.ProfilesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:Workspace1C.Localization"
             mc:Ignorable="d"
             d:DesignHeight="460" d:DesignWidth="760">

    <UserControl.Resources>
        <!-- Implicit-стили для корректного отображения в тёмной теме.
             Локальные стили переопределяют стили родителя (окна настроек) внутри панели,
             поэтому панель самодостаточна и выглядит так же, как прежнее окно профилей. -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"/>
        <!-- НЕЛЬЗЯ BasedOn="{StaticResource ModernTextBox}" для PasswordBox: ModernTextBox имеет
             TargetType="TextBox", а BasedOn требует совместимости типов. PasswordBox получит
             темированный implicit-стиль из LightTheme/DarkTheme (см. комментарий в ProfilesWindow.xaml). -->
    </UserControl.Resources>

    <Grid Margin="0,0,8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ Подсказка и активная учётная запись ============ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{loc:Loc Profiles.Hint}" TextWrapping="Wrap" Opacity="0.85"/>
            <TextBlock Text="{Binding CurrentAccountLabel}" FontWeight="SemiBold" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ============ Выпадающее меню активной учётной записи ============ -->
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" Text="{loc:Loc Profiles.ActiveAccount}"
                       VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
            <ComboBox ItemsSource="{Binding Accounts}"
                      SelectedItem="{Binding CurrentProfile, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>

        <!-- ============ Список + редактор ============ -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: список учётных записей с бейджем «активная» -->
            <ListBox Grid.Column="0" Margin="0,0,12,0"
                     ItemsSource="{Binding Profiles}"
                     SelectedItem="{Binding SelectedProfile, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc Profiles.Active}" Margin="8,0,0,0"
                                       Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" FontSize="11"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Правая колонка: панель редактирования выбранной записи -->
            <Border Grid.Column="1" Padding="14,12" CornerRadius="8"
                    Background="{DynamicResource ItemHoverBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding EditingTitle}" FontWeight="SemiBold" FontSize="15"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <!-- Приглашение, когда запись не выбрана -->
                    <TextBlock Text="{loc:Loc Profiles.SelectToEdit}" TextWrapping="Wrap" Opacity="0.8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProfile}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Поля редактирования -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProfile}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{loc:Loc Profiles.Name}" VerticalAlignment="Center" Margin="0,0,8,0" Width="100"/>
                            <TextBox x:Name="NameBox" Width="260" Padding="8,6"
                                     Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{loc:Loc Profiles.Password}" VerticalAlignment="Center" Margin="0,0,8,0" Width="100"/>
                            <PasswordBox x:Name="PasswordInput" Width="260" Padding="8,6" PasswordChanged="OnPassword_Changed"/>
                        </StackPanel>
                        <CheckBox x:Name="ProtectCheck" Content="{loc:Loc Profiles.ProtectWithPassword}" Margin="108,0,0,0"
                                  IsChecked="{Binding ProtectWithPassword}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ Ошибка ============ -->
        <TextBlock Grid.Row="3" x:Name="ErrorLabel" TextWrapping="Wrap" Margin="0,0,0,12" Text="{Binding ErrorMessage}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- ============ Кнопки ============ -->
        <DockPanel Grid.Row="4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="120" Margin="0,0,8,0"
                    Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Command="{Binding DeleteCommand}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="DeleteOutline" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Profiles.Delete}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="150" Margin="0,0,8,0"
                    Style="{StaticResource ModernButton}"
                    Command="{Binding ActivateCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="★" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Profiles.Activate}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="130" Margin="0,0,8,0"
                    Style="{StaticResource ModernButton}"
                    Command="{Binding SaveCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource SuccessBrush}" Text="✔" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Profiles.Save}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="130"
                    Style="{StaticResource ModernButton}"
                    Command="{Binding CreateCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="＋" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Profiles.Create}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
