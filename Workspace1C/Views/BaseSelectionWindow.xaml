<Window x:Class="Workspace1C.BaseSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Icon="{StaticResource AppIcon}"
        Height="480" Width="480" MinHeight="360" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <!-- Стиль ListBox не задаём: именованного ресурса ModernListBox нет (падало
             при открытии окна), тема даёт неявный стиль ListBox автоматически (issue #312). -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HintText" Grid.Row="0" Margin="0,0,0,10"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

        <ListBox x:Name="ItemsList" Grid.Row="1"
                 BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                              Margin="2,3" Cursor="Hand">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="{loc:Loc Selection.SelectAll}" Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}" Padding="12,5" Margin="0,0,8,0"
                    Click="OnSelectAll_Click"/>
            <Button Content="{loc:Loc Selection.None}" Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}" Padding="12,5"
                    Click="OnSelectNone_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Width="110" Margin="0,0,8,0" IsCancel="True"
                    Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="✖" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Common.Cancel}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="OkButton" Width="130" IsDefault="True"
                    Style="{StaticResource ModernButton}" Click="OnOk_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource SuccessBrush}" Text="✔" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Common.Ok}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
