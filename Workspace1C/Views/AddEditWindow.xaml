<Window x:Class="Workspace1C.AddEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:Workspace1C.Controls"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        mc:Ignorable="d"
        Title="{loc:Loc AddEdit.Title}"
        Icon="{StaticResource AppIcon}"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Стиль варианта выбора (радиокнопка с иконкой и описанием) -->
        <Style x:Key="OptionRadioButton" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="OptionBorder"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrushColor}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10"
                                Margin="0,0,0,10"
                                Cursor="Hand">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OptionBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OptionBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="OptionBorder" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="OptionBorder" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="{loc:Loc AddEdit.Question}" FontSize="15" FontWeight="SemiBold"/>
            <controls:HelpLink Margin="8,0,0,0" VerticalAlignment="Center"
                               HelpText="{loc:Loc AddEdit.HelpText}"/>
        </StackPanel>

        <!-- Варианты выбора -->
        <StackPanel Grid.Row="1">
            <RadioButton x:Name="InfobaseOption" Style="{StaticResource OptionRadioButton}"
                         IsChecked="True" GroupName="AddType"
                         Tag="Infobase" Checked="OnOption_Checked">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Grid.Column="0" Kind="ClipboardTextOutline" Width="22" Height="22"
                                             VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc AddEdit.ExistingBase}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{loc:Loc AddEdit.ExistingBaseDescription}"
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </RadioButton>

            <RadioButton Style="{StaticResource OptionRadioButton}"
                         GroupName="AddType"
                         Tag="CreateEmpty" Checked="OnOption_Checked">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Grid.Column="0" Kind="ContentSave" Width="22" Height="22"
                                             VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc AddEdit.CreateEmpty}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{loc:Loc AddEdit.CreateEmptyDescription}"
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </RadioButton>

            <RadioButton Style="{StaticResource OptionRadioButton}"
                         GroupName="AddType"
                         Tag="CreateFromTemplate" Checked="OnOption_Checked">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Grid.Column="0" Kind="CubeOutline" Width="22" Height="22"
                                             VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc AddEdit.CreateFromTemplate}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{loc:Loc AddEdit.CreateFromTemplateDescription}"
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </RadioButton>

            <RadioButton x:Name="GroupOption" Style="{StaticResource OptionRadioButton}"
                         GroupName="AddType"
                         Tag="Group" Checked="OnOption_Checked">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Grid.Column="0" Kind="FolderOutline" Width="22" Height="22"
                                             VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc AddEdit.Group}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{loc:Loc AddEdit.GroupDescription}"
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </RadioButton>
        </StackPanel>

        <!-- Кнопки — единый контракт (issue #26): «Далее» — акцентная ModernButton,
             «Отмена» — вторичная SecondaryButton. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="130" Height="36" Margin="0,0,10,0" IsDefault="True" Click="OnNext_Click"
                    Style="{DynamicResource ModernButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowRight" Width="16" Height="16"
                                             Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc AddEdit.Next}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            <Button Width="130" Height="36" IsCancel="True"
                    Style="{DynamicResource SecondaryButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16"
                                             Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Common.Cancel}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
