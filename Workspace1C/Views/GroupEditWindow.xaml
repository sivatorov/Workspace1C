<Window x:Class="Workspace1C.GroupEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Workspace1C.Controls"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        mc:Ignorable="d"
        Title="{loc:Loc GroupEdit.Title}"
        Icon="{StaticResource AppIcon}"
        Width="540"
        Height="640"
        MinWidth="460"
        MinHeight="480"
        MaxHeight="880"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="PaletteColorButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Плитки пикера иконок на кистях темы (аудит UI, п. 2.6): фон и наведение
             следуют IconPickerBaseBrush/IconPickerHoverBrush вместо фиксированных
             тёмно-серых #374151/#4B5563. -->
        <Style x:Key="IconPickButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource IconPickerBaseBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource IconPickerHoverBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IconPickerHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== Стиль горизонтальных вкладок (по аналогии с настройками) ===================== -->
        <Style x:Key="SettingsSubTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TabStripPlacement" Value="Top"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Полоса вкладок: равная ширина, общая линия снизу -->
                            <Border Grid.Row="0"
                                    BorderBrush="{DynamicResource BorderBrushColor}"
                                    BorderThickness="0,0,0,1"
                                    Margin="0,0,0,10">
                                <UniformGrid Rows="1" IsItemsHost="True"/>
                            </Border>
                            <ContentPresenter Grid.Row="1"
                                              ContentSource="SelectedContent"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSubTabItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,3"
                                Margin="0,0,0,-1"
                                SnapsToDevicePixels="True"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <!-- Только нижняя акцентная линия — без заливки, чтобы не спорить с боковым меню -->
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="16,16,16,0"
                    Style="{StaticResource SettingsSubTabControl}">

            <!-- ============ Вкладка «Основные» ============ -->
            <TabItem x:Name="MainTabItem" Style="{StaticResource SettingsSubTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="TextBox" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                        <TextBlock Text="{loc:Loc GroupEdit.TabMain}" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="2,8,2,4"
                              CanContentScroll="False">
                    <GroupBox Header="{loc:Loc GroupEdit.BasicParams}" Padding="10" Margin="0,0,0,12"
                              BorderBrush="{DynamicResource BorderBrushColor}"
                              Background="{DynamicResource CardBackgroundBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc GroupEdit.NameLabel}" VerticalAlignment="Center" Margin="0,4"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,4" Padding="4,3"
                                     Style="{DynamicResource ModernTextBox}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc GroupEdit.ParentGroupLabel}" VerticalAlignment="Center" Margin="0,4"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Grid Grid.Row="1" Grid.Column="1" Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ParentPathBox" Grid.Column="0" IsReadOnly="True" Padding="4,3"
                                         Style="{DynamicResource ModernTextBox}"
                                         VerticalContentAlignment="Center"
                                         ToolTip="{loc:Loc GroupEdit.ParentTooltip}"/>
                                <Button x:Name="SelectParentButton" Grid.Column="1" Margin="6,0,0,0" Padding="10,4"
                                        Style="{DynamicResource SecondaryButton}"
                                        Click="OnSelectParent_Click" ToolTip="{loc:Loc GroupEdit.SelectParentTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderOutline" Width="15" Height="15" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc GroupEdit.SelectParent}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <controls:HelpLink Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   HelpText="{loc:Loc GroupEdit.ParentHelp}"/>
                            </Grid>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc GroupEdit.DescriptionLabel}" VerticalAlignment="Center" Margin="0,4"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox x:Name="DescriptionBox" Grid.Row="2" Grid.Column="1" Margin="0,4" Padding="4,3"
                                     Style="{DynamicResource ModernTextBox}"/>
                        </Grid>
                    </GroupBox>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Вкладка «Цвет» ============ -->
            <!-- По умолчанию активна вкладка «Основные» с именем (issue #297): при добавлении
                 группы имя важнее цвета ярлычка. «Цвет» выбирается явно в коде только для
                 служебных узлов «Без группы»/«Закреплённые», где «Основные» скрыта. -->
            <TabItem x:Name="ColorTabItem" Style="{StaticResource SettingsSubTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Palette" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                        <TextBlock Text="{loc:Loc GroupEdit.TabColor}" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer x:Name="ColorTabScroller"
                              Loaded="OnColorTab_Loaded"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="2,8,2,4"
                              CanContentScroll="False">
                    <GroupBox Header="{loc:Loc GroupEdit.TitleColor}" Padding="10" Margin="0,0,0,12"
                              BorderBrush="{DynamicResource BorderBrushColor}"
                              Background="{DynamicResource CardBackgroundBrush}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc GroupEdit.ColorHint}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"
                                       TextWrapping="Wrap"/>
                            <!-- Встроенный полный пикер цвета (как в окне выбора цвета) -->
                            <controls:ColorPickerControl x:Name="HeaderColorPicker"/>
                        </StackPanel>
                    </GroupBox>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Вкладка «Иконка» ============ -->
            <TabItem Style="{StaticResource SettingsSubTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Shape" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                        <TextBlock Text="{loc:Loc GroupEdit.TabIcon}" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer x:Name="IconTabScroller"
                              Loaded="OnIconTab_Loaded"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="2,8,2,4"
                              CanContentScroll="False">
                    <GroupBox Header="{loc:Loc GroupEdit.IconAndColor}" Padding="10" Margin="0,0,0,12"
                              BorderBrush="{DynamicResource BorderBrushColor}"
                              Background="{DynamicResource CardBackgroundBrush}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc GroupEdit.IconColorHint}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{loc:Loc GroupEdit.IconLabel}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"/>
                            <WrapPanel x:Name="IconPickerPanel" Margin="0,0,0,12"/>
                            <!-- Встроенный полный пикер цвета иконки (как в окне выбора цвета) -->
                            <controls:ColorPickerControl x:Name="IconColorPicker"/>
                        </StackPanel>
                    </GroupBox>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Padding="16,10,16,16"
                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,1,0,0"
                Background="{DynamicResource CardBackgroundBrush}">
            <!-- Единый контракт кнопок (issue #26): «Сохранить» — акцентная
                 ModernButton, «Отмена» — вторичная SecondaryButton. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="130" Height="36" Margin="0,0,10,0" IsDefault="True" Click="OnSave_Click"
                        Style="{DynamicResource ModernButton}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{DynamicResource IconSave}" Width="16" Height="16"
                              Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Common.Save}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Width="120" Height="36" IsCancel="True"
                        Style="{DynamicResource SecondaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{DynamicResource IconClear}" Width="14" Height="14"
                              Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Common.Cancel}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
