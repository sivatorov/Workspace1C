<Window x:Class="Workspace1C.TrayMenuEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        xmlns:conv="clr-namespace:Workspace1C.Converters"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="{loc:Loc TrayMenu.Title}"
        Icon="{StaticResource AppIcon}"
        Height="560" Width="760"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <!-- Implicit-стили для корректного отображения в тёмной теме -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}"/>
        <!-- Превью иконок блоков (issue #62): ТА ЖЕ геометрия приложения, что рисует
             адаптер трея (Path по ключу через IconKeyToGeometryConverter), а не
             MaterialDesign-иконка, которая в трее выглядела бы «совсем другой». -->
        <conv:IconKeyToGeometryConverter x:Key="IconKeyToGeometry"/>
        <!-- Шаблон узла дерева: чекбокс видимости + иконка + заголовок + пометка вида -->
        <HierarchicalDataTemplate x:Key="TrayNodeTemplate" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <CheckBox IsChecked="{Binding IsVisible}"
                          VerticalAlignment="Center"
                          ToolTip="{loc:Loc TrayMenu.VisibleTooltip}"/>
                <Path Data="{Binding DisplayIconKey, Converter={StaticResource IconKeyToGeometry}}"
                      Width="16" Height="16" Stretch="Uniform" Margin="4,0,0,0"
                      VerticalAlignment="Center" Fill="{Binding DisplayIconColor}">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DisplayIconKey}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <TextBlock Text="{Binding Title}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding KindLabel}" Margin="8,0,0,0" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- ============ Нижняя панель кнопок ============ -->
        <!-- Порядок кнопок (issue #62): «Сохранить» слева, «Отмена» справа — как в
             остальных окнах программы (отмена всегда в конце). -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OkButton" Width="130" IsDefault="True"
                    Style="{StaticResource ModernButton}" Click="OnOk_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource SuccessBrush}" Text="✔" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc TrayMenu.Save}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="110" Margin="8,0,0,0"
                    Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Content="{loc:Loc Common.Cancel}" IsCancel="True"/>
        </StackPanel>

        <!-- ============ Центральная область: дерево + панель операций ============ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Дерево компоновки -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                    CornerRadius="6" Background="{DynamicResource CardBackgroundBrush}" Padding="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc TrayMenu.TreeHeader}"
                               Margin="4,4,4,8" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TreeView x:Name="TrayMenuTree" ItemsSource="{Binding Roots}"
                              ItemTemplate="{StaticResource TrayNodeTemplate}"
                              ItemContainerStyle="{StaticResource ModernTreeViewItem}"
                              SelectedItemChanged="OnTree_SelectedItemChanged"
                              BorderThickness="0" Background="Transparent"/>
                </DockPanel>
            </Border>

            <!-- Панель операций -->
            <StackPanel Grid.Column="2">
                <!-- Порядок блоков -->
                <TextBlock Text="{loc:Loc TrayMenu.MoveHeader}" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ModernButton}" Command="{Binding MoveUpCommand}"
                            ToolTip="{loc:Loc TrayMenu.MoveUpTooltip}" Padding="10,6" Margin="0,0,6,0">
                        <materialDesign:PackIcon Kind="ArrowUp" Width="16" Height="16"/>
                    </Button>
                    <Button Style="{StaticResource ModernButton}" Command="{Binding MoveDownCommand}"
                            ToolTip="{loc:Loc TrayMenu.MoveDownTooltip}" Padding="10,6" Margin="0,0,6,0">
                        <materialDesign:PackIcon Kind="ArrowDown" Width="16" Height="16"/>
                    </Button>
                    <Button Style="{StaticResource ModernButton}" Click="OnAddGroupClick"
                            ToolTip="{loc:Loc TrayMenu.AddGroupTooltip}" Padding="10,6" Margin="0,0,6,0">
                        <materialDesign:PackIcon Kind="FolderPlus" Width="16" Height="16"/>
                    </Button>
                    <Button Style="{StaticResource ModernButton}" Command="{Binding AddSeparatorCommand}"
                            ToolTip="{loc:Loc TrayMenu.AddSeparatorTooltip}" Padding="10,6" Margin="0,0,6,0">
                        <materialDesign:PackIcon Kind="Minus" Width="16" Height="16"/>
                    </Button>
                    <Button Style="{StaticResource ModernButton}" Click="OnEditGroupClick"
                            ToolTip="{loc:Loc TrayMenu.EditGroupTooltip}" Padding="10,6" Margin="0,0,6,0"
                            IsEnabled="{Binding CanEditGroup}">
                        <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16"/>
                    </Button>
                    <Button Style="{StaticResource ModernButton}" Click="OnDeleteClick"
                            ToolTip="{loc:Loc TrayMenu.DeleteTooltip}" Padding="10,6"
                            IsEnabled="{Binding CanDelete}">
                        <materialDesign:PackIcon Kind="Delete" Width="16" Height="16"/>
                    </Button>
                </StackPanel>

                <!-- Стиль блока -->
                <TextBlock Text="{loc:Loc TrayMenu.BlockStyleHeader}" Margin="0,14,0,4"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ComboBox x:Name="BlockStyleCombo" ItemsSource="{Binding StyleOptions}"
                          SelectedItem="{Binding SelectedBlockStyle}"
                          IsEnabled="{Binding HasSelection}">
                    <!-- Локализованные подписи стилей: «Блок меню» / «Подменю» (issue #62). -->
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{loc:Loc TrayMenu.StyleBlock}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="Submenu">
                                                <Setter Property="Text" Value="{loc:Loc TrayMenu.StyleSubmenu}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{loc:Loc TrayMenu.StyleHint}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>

                <!-- Переименование / удаление -->
                <TextBlock Text="{loc:Loc TrayMenu.GroupsHeader}" Margin="0,14,0,4"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <!-- Перемещение блоков в пользовательскую группу (issue #62, замечание 7OH:
                     «Создал группу, но переместить туда 2 блока не смог»). -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Style="{StaticResource ModernButton}" Click="OnMoveToGroupClick"
                            Padding="12,7" Margin="0,0,6,0" HorizontalAlignment="Left"
                            IsEnabled="{Binding CanMoveToGroup}"
                            ToolTip="{loc:Loc TrayMenu.MoveToGroupTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderMove" Width="16" Height="16" Margin="0,0,4,0"/>
                            <TextBlock Text="{loc:Loc TrayMenu.MoveToGroup}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModernButton}" Click="OnUnGroupClick"
                            Padding="12,7" HorizontalAlignment="Left"
                            IsEnabled="{Binding CanUnGroup}"
                            ToolTip="{loc:Loc TrayMenu.UnGroupTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Restore" Width="16" Height="16" Margin="0,0,4,0"/>
                            <TextBlock Text="{loc:Loc TrayMenu.UnGroup}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button Style="{StaticResource ModernButton}" Click="OnEditGroupClick"
                        Padding="12,7" Margin="0,0,0,6" HorizontalAlignment="Left"
                        IsEnabled="{Binding CanEditGroup}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16" Margin="0,0,4,0"/>
                        <TextBlock Text="{loc:Loc TrayMenu.EditGroup}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ModernButton}" Click="OnDeleteClick"
                        Padding="12,7" Margin="0,0,0,14" HorizontalAlignment="Left"
                        IsEnabled="{Binding CanDelete}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" Margin="0,0,4,0"/>
                        <TextBlock Text="{loc:Loc TrayMenu.Delete}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Сброс -->
                <Button Style="{StaticResource ModernButton}" Command="{Binding ResetDefaultCommand}"
                        Padding="12,7" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Restore" Width="16" Height="16" Margin="0,0,4,0"/>
                        <TextBlock Text="{loc:Loc TrayMenu.Reset}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Пояснение -->
                <Border Margin="0,14,0,0" Padding="10" CornerRadius="6"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                    <TextBlock Text="{loc:Loc TrayMenu.Hint}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                </Border>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
