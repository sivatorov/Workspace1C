<Window x:Class="Workspace1C.RepositoryBatchUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Icon="{StaticResource AppIcon}"
        Height="560" Width="640" MinHeight="420" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <!-- Стиль ListBox не задаём: именованного ресурса ModernListBox нет (падало
             при открытии окна), тема даёт неявный стиль ListBox автоматически (issue #312). -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HintText" Grid.Row="0" Margin="0,0,0,10"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

        <!-- Список баз с хранилищами и флажками -->
        <ListBox x:Name="ItemsList" Grid.Row="1"
                 BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding IsSelectable}"
                              Margin="2,3" Cursor="Hand">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="{loc:Loc Selection.SelectAll}" Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}" Padding="12,5" Margin="0,0,8,0"
                    Click="OnSelectAll_Click"/>
            <Button Content="{loc:Loc Selection.None}" Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}" Padding="12,5"
                    Click="OnSelectNone_Click"/>
        </StackPanel>

        <!-- Заголовок лога -->
        <TextBlock x:Name="LogHeader" Grid.Row="3" Margin="0,14,0,6" FontWeight="SemiBold"
                   Text="{loc:Loc RepoUpdate.Log}"/>

        <!-- Построчный лог прогона -->
        <ListBox x:Name="LogList" Grid.Row="4"
                 BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                 IsHitTestVisible="False"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                               FontFamily="Consolas"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="2,1"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="SummaryText" Grid.Row="5" Margin="0,10,0,0" FontWeight="SemiBold"
                   TextWrapping="Wrap" Text="{Binding Summary}"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Width="110" Margin="0,0,8,0" IsCancel="True"
                    Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Click="OnClose_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="✖" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Common.Close}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="UpdateButton" Width="180" IsDefault="True"
                    Style="{StaticResource ModernButton}" Click="OnUpdateSelected_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⇅" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc RepoUpdate.UpdateSelected}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
