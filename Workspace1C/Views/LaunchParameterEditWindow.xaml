<!-- Диалог правки пользовательского параметра справочника «Запустить с выбором
     параметров» (issue #68): ключ командной строки и описание. WPF-версия; Avalonia —
     LaunchParameterEditWindow.Avalonia.cs. Отдельное модальное окно — по требованию
     «Изменять лучше в отдельном диалоге». -->
<Window x:Class="Workspace1C.LaunchParameterEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Icon="{StaticResource AppIcon}"
        Title="{loc:Loc LaunchParams.EditTitle}"
        Height="260" Width="480" MinHeight="240" MinWidth="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="13"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <!-- Issue #61: у явного стиля FieldLabel Foreground не наследуется от неявного
                 стиля окна — задаём кисть подписи формы явно, иначе в тёмной теме
                 подписи полей остаются чёрными. -->
            <Setter Property="Foreground" Value="{DynamicResource FormLabelBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:Loc LaunchParams.Parameter}" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="KeyBox" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                     Padding="6,3" TextChanged="OnTextChanged"/>
        </Grid>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:Loc LaunchParams.Description}" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="CommentBox" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                     Padding="6,3"/>
        </Grid>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" FontSize="12" TextWrapping="Wrap"
                   Margin="0,10,0,0" Visibility="Collapsed"/>

        <!-- Единый контракт кнопок (issue #26): «Сохранить» — акцентная ModernButton,
             «Отмена» — вторичная SecondaryButton. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SaveButton" Style="{StaticResource ModernButton}"
                    Padding="16,6" Margin="0,0,8,0"
                    IsDefault="True" Click="OnSave_Click">
                <TextBlock Text="{loc:Loc Updates.Save}" VerticalAlignment="Center"/>
            </Button>
            <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}"
                    Padding="16,6"
                    IsCancel="True" Click="OnCancel_Click">
                <TextBlock Text="{loc:Loc Updates.Cancel}" VerticalAlignment="Center"/>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
