    <StreamGeometry x:Key="GlyphWindowClose.Glass">M7,7 L17,17 M17,7 L7,17</StreamGeometry>

    <!-- ===================== ГЛИФЫ ШАБЛОНОВ ЭЛЕМЕНТОВ (ComboBox, подменю, CheckBox) ===================== -->
