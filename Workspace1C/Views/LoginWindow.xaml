<Window x:Class="Workspace1C.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        mc:Ignorable="d"
        Title="{loc:Loc Auth.Title}"
        Icon="{StaticResource AppIcon}"
        Width="460"
        SizeToContent="Height"
        MinHeight="220"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <!-- Implicit-стили для корректного отображения в тёмной теме -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <!-- Issue #164 (1.0.1.121): высота окна — по содержимому (SizeToContent="Height").
             Строка списка профилей — Auto и именована, чтобы при одной записи схлопнуть
             её в ноль (иначе *-строка оставляла пустоту над полем пароля). -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="ProfilesListRow" Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ Подсказка ============ -->
        <TextBlock Grid.Row="0" x:Name="HintLabel" Text="{loc:Loc Auth.SelectAccountHint}"
                   TextWrapping="Wrap" Margin="0,0,0,12" Opacity="0.85"/>

        <!-- ============ Список учётных записей ============ -->
        <!-- MaxHeight: при многих профилях прокрутка остаётся внутри списка, а окно
             (SizeToContent="Height") не выходит за экран. -->
        <ListBox x:Name="ProfilesList" Grid.Row="1" Margin="0,0,0,12" MaxHeight="280"
                 SelectionChanged="OnProfilesList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{DynamicResource IconLock}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" x:Name="LockIcon" Opacity="0.0"/>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ============ Поле пароля ============ -->
        <!-- Подпись показывает, в какую запись входим (issue #164): префикс из локализации,
             имя активной записи — жирным. Текст собирается в ApplySelectionState по формату
             Auth.PasswordForAccountFormat («Пароль учётной записи {0}»). -->
        <StackPanel Grid.Row="2" x:Name="PasswordPanel" Visibility="Collapsed" Margin="0,0,0,12">
            <TextBlock Margin="0,0,0,4">
                <Run x:Name="PasswordLabelPrefix" Text="{loc:Loc Auth.Password}"/>
                <Run x:Name="PasswordLabelAccount" FontWeight="Bold"/>
                <Run x:Name="PasswordLabelSuffix"/>
            </TextBlock>
            <PasswordBox x:Name="PasswordInput" Padding="8,6" KeyDown="OnPasswordInput_KeyDown"/>
        </StackPanel>

        <!-- ============ Ошибка ============ -->
        <TextBlock Grid.Row="3" x:Name="ErrorLabel" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                   Margin="0,0,0,12" Visibility="Collapsed"/>

        <!-- ============ Кнопки ============ -->
        <!-- Порядок кнопок приведён к конвенции проекта (issue #98): главная кнопка —
             слева, «Отмена» — справа (последней), как во всех остальных окнах. -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="LoginButton" Width="130" Margin="0,0,8,0"
                    IsDefault="True" KeyboardNavigation.TabIndex="900"
                    Style="{StaticResource PrimaryButton}"
                    Click="OnLogin_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{DynamicResource IconCheck}" Width="16" Height="16" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Auth.Login}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="110"
                    IsCancel="True" KeyboardNavigation.TabIndex="1000"
                    Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{DynamicResource IconClose}" Width="16" Height="16" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Common.Cancel}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
