<Window x:Class="Workspace1C.MaintenanceCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Icon="{StaticResource AppIcon}"
        Height="840" Width="1080" MinHeight="660" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"/>

        <!-- Вертикальное выравнивание содержимого ячеек по центру (как в ActualReleasesWindow,
             issue #264): для DataGridTextColumn центрирование задаётся через ElementStyle. -->
        <Style x:Key="CenteredCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <Style x:Key="CellTextAccent" TargetType="TextBlock" BasedOn="{StaticResource CenteredCellText}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и фильтр-переключатель «Только проблемы» -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{loc:Loc Maintenance.Title}"/>
            <CheckBox x:Name="OnlyProblemsCheck" Margin="24,2,0,0" VerticalAlignment="Center"
                      Content="{loc:Loc Maintenance.OnlyProblems}"
                      IsChecked="{Binding OnlyProblems, UpdateSourceTrigger=PropertyChanged}"
                      Cursor="Hand"/>
        </StackPanel>

        <TextBlock x:Name="SummaryTextBlock" Grid.Row="1" Margin="0,6,0,10" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding SummaryText}"/>

        <!-- Таблица баз × состояние -->
        <DataGrid x:Name="BasesGrid" Grid.Row="2"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal"
                  RowHeight="38"
                  AlternatingRowBackground="{DynamicResource CardBackgroundBrush}"
                  BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                  MouseDoubleClick="OnGrid_MouseDoubleClick">
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <!-- Имя базы + пояснение (группа, сервер/база) -->
                <DataGridTemplateColumn Width="2*" Header="{loc:Loc Maintenance.Base}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" Margin="4,0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Width="*" Header="{loc:Loc Maintenance.Availability}"
                                    Binding="{Binding AvailabilityText}"
                                    ElementStyle="{StaticResource CellTextAccent}"/>
                <DataGridTextColumn Width="*" Header="{loc:Loc Maintenance.LastBackup}"
                                    Binding="{Binding LastBackupText}"
                                    ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn Width="80" Header="{loc:Loc Maintenance.Size}"
                                    Binding="{Binding SizeText}"
                                    ElementStyle="{StaticResource CenteredCellText}"/>
                <!-- Свободное место на диске (0.3.9.96): для файловых баз —
                     «C:\ — 23,4 ГБ (12%)»; ниже порога ячейка подсвечивается красным. -->
                <DataGridTextColumn Width="1.3*" Header="{loc:Loc Maintenance.FreeSpace}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CenteredCellText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FreeSpaceIsProblem}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Width="90" Header="{loc:Loc Maintenance.Cache}"
                                    Binding="{Binding CacheText}"
                                    ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn Width="1.5*" Header="{loc:Loc Maintenance.Config}"
                                    Binding="{Binding ConfigurationText}"
                                    ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn Width="1.3*" Header="{loc:Loc Maintenance.DataAge}"
                                    Binding="{Binding DataAgeText}"
                                    ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn Width="1.3*" Header="{loc:Loc Maintenance.Update}"
                                    Binding="{Binding UpdateText}"
                                    ElementStyle="{StaticResource CenteredCellText}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Секция «История размеров и прогноз диска» (п.7, 1.0.0.89) -->
        <Border Grid.Row="3" Margin="0,10,0,0" Padding="10"
                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая колонка: топ баз по росту + период + прогноз роста базы -->
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Loc Maintenance.HistoryTitle}" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Maintenance.HistoryPeriod}" FontSize="12" Margin="14,0,4,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <RadioButton x:Name="Period7Radio" GroupName="HistoryPeriod" Content="7" Margin="4,0,0,0"
                                     Cursor="Hand" VerticalAlignment="Center" Checked="OnHistoryPeriodChanged"/>
                        <RadioButton x:Name="Period30Radio" GroupName="HistoryPeriod" Content="30" Margin="6,0,0,0"
                                     IsChecked="True" Cursor="Hand" VerticalAlignment="Center" Checked="OnHistoryPeriodChanged"/>
                        <RadioButton x:Name="Period90Radio" GroupName="HistoryPeriod" Content="90" Margin="6,0,0,0"
                                     Cursor="Hand" VerticalAlignment="Center" Checked="OnHistoryPeriodChanged"/>
                    </StackPanel>
                    <ListBox x:Name="HistoryList" Height="132" Margin="0,8,0,0"
                             BorderThickness="0" Background="Transparent"
                             ItemsSource="{Binding HistoryRows}"
                             SelectedItem="{Binding SelectedHistoryRow, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="4,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding GrowthText}" FontSize="11" Foreground="{DynamicResource ErrorBrush}"/>
                                        <TextBlock Text="{Binding CurrentSizeText}" FontSize="11" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="HistoryEmptyTextBlock" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding HistoryEmptyText}"/>
                    <TextBlock x:Name="ForecastTextBlock" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding ForecastText}"/>
                </StackPanel>

                <!-- Правая колонка: график роста + прогноз диска под копиями -->
                <Border Grid.Column="1" Margin="12,0,0,0" Padding="8" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Background="{DynamicResource CardBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="HistoryChartCaptionBox" Grid.Row="0" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Text="{Binding HistoryChartCaption}"
                                   TextTrimming="CharacterEllipsis"/>
                        <Canvas x:Name="HistoryChartCanvas" Grid.Row="1" Height="150" Margin="0,4,0,0"
                                Background="Transparent" SizeChanged="OnHistoryChartSizeChanged"/>
                        <TextBlock x:Name="DiskForecastTextBlock" Grid.Row="2" Margin="0,4,0,0" FontSize="12"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding DiskForecastText}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CheckAvailabilityButton" Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}" Padding="12,5" Margin="0,0,8,0"
                    Click="OnCheckAvailability_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⟳" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Maintenance.CheckAvailability}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="OpenBaseButton" Width="150" Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}" Margin="0,0,8,0"
                    Click="OnOpenBase_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⇲" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Maintenance.OpenBase}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="CloseButton" Width="110" IsCancel="True"
                    Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Click="OnClose_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="✖" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Common.Close}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock x:Name="HintText" Grid.Row="5" Margin="0,8,0,0" FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{loc:Loc Maintenance.Hint}"/>
    </Grid>
</Window>
