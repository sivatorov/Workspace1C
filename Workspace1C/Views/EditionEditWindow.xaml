<Window x:Class="Workspace1C.EditionEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Icon="{StaticResource AppIcon}"
        Width="520" Height="520"
        MinWidth="460" MinHeight="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Поля формы используют ОБЩИЙ стиль приложения ModernTextBox (скругление 8 px,
             акцентная рамка при наведении/фокусе), как в остальных окнах правки — CreateInfobase,
             GroupEdit, Settings и др. Локальный неявный стиль TextBox убран (issue #321):
             он делал поля «чужеродными» по сравнению с остальными окнами. -->

        <!-- Основная зелёная кнопка -->
        <!-- Кнопки — единый контракт (issue #26): акцентная ModernButton. Имя
             PrimaryButtonStyle сохранено. -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>

        <!-- Серая кнопка-контур -->
        <Style x:Key="OutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="EditorTitle" Grid.Row="0" FontSize="15" FontWeight="SemiBold"/>

        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <!-- Редакция/каталог релизов типовой конфигурации (issue #321): модальный диалог
                 вместо инлайн-полей под списком. Поля: имя, «Ред», «Подред» и ручная ссылка.
                 Единый стиль полей — ModernTextBox (общий вид окон приложения, issue #321). -->
            <TextBlock Text="{loc:Loc Updates.Name}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="NameBox" Style="{DynamicResource ModernTextBox}"/>

            <TextBlock Text="{loc:Loc Updates.EditionRed}" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <TextBox x:Name="RedBox" Style="{DynamicResource ModernTextBox}"/>

            <TextBlock Text="{loc:Loc Updates.EditionSubRed}" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <TextBox x:Name="SubRedBox" Style="{DynamicResource ModernTextBox}"/>

            <!-- Переопределённая ссылка (issue #369): полная ссылка либо только конечная
                 часть после releases.1c.ru/project/ (например «Enterprise13») —
                 полная ссылка собирается автоматически. -->
            <TextBlock Text="{loc:Loc Updates.UrlOverride}" FontWeight="SemiBold" Margin="0,12,0,4"
                       ToolTip="{loc:Loc Updates.UrlOverrideHint}"/>
            <TextBox x:Name="UrlOverrideBox" Style="{DynamicResource ModernTextBox}"
                     ToolTip="{loc:Loc Updates.UrlOverrideHint}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SaveButton" Width="140" Height="34" Margin="0,0,10,0" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" Click="OnSaveClick">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Check" Width="16" Height="16"/>
                    <TextBlock Text="{loc:Loc Updates.Save}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="120" Height="34" IsCancel="True" Style="{StaticResource OutlineButtonStyle}"
                    Click="OnCancelClick">
                <TextBlock Text="{loc:Loc Updates.Cancel}" VerticalAlignment="Center"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>