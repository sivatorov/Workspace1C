<Window x:Class="Workspace1C.NetworkDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Icon="{StaticResource AppIcon}"
        Height="620" Width="860" MinHeight="460" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="CenteredCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        <Style x:Key="CardText" TargetType="TextBlock" BasedOn="{StaticResource CenteredCellText}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CenteredColumnHeader" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Адрес, сервер с портом и команды (issue #335): выбор сервера из списка
             подставляет сохранённый порт; поля — на первой строке, кнопки команд —
             на второй, чтобы при узком окне кнопки не обрезались (0.3.9.269). -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <!-- Одно поле «Сервер:» (issue #335): редактируемый список — можно ввести адрес
                     вручную или выбрать известный сервер из выпадающего списка (Host/SelectedServer
                     синхронизированы ViewModel: выбор подставляет адрес и сохранённый порт). -->
                <TextBlock Text="{loc:Loc Diagnostics.ServerLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Width="220" Style="{StaticResource ModernComboBox}" IsEditable="True"
                          IsTextSearchEnabled="False" Padding="6,3"
                          VerticalContentAlignment="Center"
                          ItemsSource="{Binding AvailableServers}"
                          SelectedItem="{Binding SelectedServer, Mode=TwoWay}"
                          Text="{Binding Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{loc:Loc Diagnostics.Port}" VerticalAlignment="Center" Margin="10,0,6,0"/>
                <TextBox Width="64" Style="{StaticResource ModernTextBox}" Padding="6,3"
                         VerticalContentAlignment="Center"
                         Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Style="{StaticResource ModernButton}"
                        Background="{DynamicResource ItemHoverBrush}" Padding="12,5" Margin="14,0,0,0"
                        Command="{Binding RunCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔎" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Diagnostics.Run}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ModernButton}"
                        Background="{DynamicResource ItemHoverBrush}" Padding="12,5" Margin="0,0,8,0"
                        Command="{Binding CheckPortsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔌" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Diagnostics.CheckPorts}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ModernButton}"
                        Background="{DynamicResource ItemHoverBrush}" Padding="12,5" Margin="0,0,8,0"
                        Command="{Binding CheckRepositoryCommand}"
                        ToolTip="{loc:Loc Diagnostics.CheckRepositoryTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗄️" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Diagnostics.CheckRepository}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ModernButton}"
                        Background="{DynamicResource ItemHoverBrush}" Padding="12,5" Margin="0,0,8,0"
                        Command="{Binding RetryCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⟳" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Diagnostics.Retry}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ModernButton}" IsCancel="True"
                        Background="{DynamicResource ItemHoverBrush}" Padding="12,5"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Click="OnClose_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="✖" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Common.Close}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Карточка хоста: DNS, IP-адреса, пинг -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Padding="12,8" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="{loc:Loc Diagnostics.DnsLabel}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding DnsText}" Style="{StaticResource CardText}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="{loc:Loc Diagnostics.IpAddresses}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding IpAddressesText}" Style="{StaticResource CardText}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Loc Diagnostics.PingLabel}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding PingText}" Style="{StaticResource CardText}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Таблица портов -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Ports}" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                  CanUserDeleteRows="False" ColumnHeaderStyle="{StaticResource CenteredColumnHeader}"
                  SelectionMode="Single" SelectionUnit="FullRow" GridLinesVisibility="Horizontal"
                  RowHeight="34" AlternatingRowBackground="{DynamicResource CardBackgroundBrush}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Loc Diagnostics.ColPort}" Binding="{Binding Port}" Width="70"/>
                <DataGridTextColumn Header="{loc:Loc Diagnostics.ColService}" Binding="{Binding ServiceName}" Width="*"/>
                <DataGridTextColumn Header="{loc:Loc Diagnostics.ColState}" Binding="{Binding StateText}" Width="90"/>
                <DataGridTextColumn Header="{loc:Loc Diagnostics.ColRtt}" Binding="{Binding RttText}" Width="80"/>
                <DataGridTextColumn Header="{loc:Loc Diagnostics.ColNote}" Binding="{Binding NoteText}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Выводы/подсказки -->
        <ItemsControl Grid.Row="3" ItemsSource="{Binding Hints}" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="•" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Статус -->
        <TextBlock Grid.Row="4" Text="{Binding StatusText}" Margin="0,10,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
    </Grid>
</Window>
