<!-- Avalonia-версия тёмной темы (Linux). Палитра ресурсов, соответствуют ключам
     ColorScheme.Definitions. Актуальные цвета накладываются ThemeManager.ApplyScheme. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AccentColor">#FFB300</Color>
    <Color x:Key="AccentHoverColor">#FFCA28</Color>
    <Color x:Key="AccentPressedColor">#FF8F00</Color>
    <Color x:Key="SidebarColor">#111827</Color>
    <Color x:Key="SidebarHoverColor">#1F2937</Color>
    <Color x:Key="SidebarSelectedColor">#FFB300</Color>
    <Color x:Key="ContentBackgroundColor">#0F172A</Color>
    <Color x:Key="CardBackgroundColor">#1E293B</Color>
    <Color x:Key="InputBackgroundColor">#273548</Color>
    <Color x:Key="BorderColor">#334155</Color>
    <Color x:Key="TextPrimaryColor">#F1F5F9</Color>
    <Color x:Key="TextSecondaryColor">#CBD5E1</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFF</Color>
    <Color x:Key="ButtonTextColor">#000000</Color>
    <Color x:Key="FavoriteColor">#FBBF24</Color>
    <Color x:Key="FavoriteTextColor">#1C1917</Color>
    <Color x:Key="ItemHoverColor">#334155</Color>
    <Color x:Key="ItemSelectedColor">#1E3A5F</Color>
    <Color x:Key="AvatarBackgroundColor">#1E3A5F</Color>
    <Color x:Key="AvatarTextColor">#FFB300</Color>
    <Color x:Key="SecondaryButtonBackgroundColor">#FFF3CD</Color>
    <Color x:Key="SecondaryButtonHoverColor">#FFE69C</Color>
    <Color x:Key="SecondaryButtonPressedColor">#FFD54D</Color>
    <!-- Опасная кнопка (issue #26): единый красный и белый текст (WCAG ≥ 4.5). -->
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="DangerHoverColor">#B91C1C</Color>
    <!-- Семантические статусы (аудит UI 1.0.1.10, п. 2.1): осветлённые варианты
         для контраста на тёмном фоне. -->
    <Color x:Key="SuccessColor">#22C55E</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>
    <Color x:Key="InfoColor">#38BDF8</Color>
    <!-- Мягкая красная плашка (аудит UI, п. 2.4): тёмный красноватый фон вместо
         светлых фиксированных #FEF2F2/#FECACA. -->
    <Color x:Key="DangerSoftColor">#3F1D1D</Color>
    <Color x:Key="DangerSoftBorderColor">#7F1D1D</Color>
    <!-- Плашка «Закреплено» (аудит UI, п. 2.5): тёмно-сиреневый фон со светлым текстом. -->
    <Color x:Key="PinnedBadgeColor">#4C1D95</Color>
    <Color x:Key="PinnedBadgeTextColor">#DDD6FE</Color>
    <!-- Пикер иконок (аудит UI, п. 2.6): тёмные плитки, как раньше, но из темы. -->
    <Color x:Key="IconPickerBaseColor">#374151</Color>
    <Color x:Key="IconPickerHoverColor">#4B5563</Color>
    <Color x:Key="DangerPressedColor">#991B1B</Color>
    <Color x:Key="DangerTextColor">#FFFFFF</Color>
    <!-- Дорожка переключателя в выключенном положении (issue #26): тёмная #475569
         на тёмной странице, чтобы выключенный тумблер не выглядел белым. -->
    <Color x:Key="SettingsToggleTrackColor">#475569</Color>
    <!-- «Зебра» таблиц (чередование строк, issue #26): в тёмной теме приглушённая
         slate-700, светлых/белых полос нет. -->
    <Color x:Key="ZebraRowColor">#334155</Color>
    <Color x:Key="TreeHoverColor">#334155</Color>
    <Color x:Key="TreeSelectedColor">#B45309</Color>
    <Color x:Key="ScrollTrackBrush">#16202E</Color>
    <Color x:Key="ScrollThumbBrush">#3B4A5F</Color>
    <Color x:Key="ScrollThumbHoverBrush">#4A5B73</Color>
    <Color x:Key="ScrollThumbPressedBrush">#5A6B85</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{DynamicResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{DynamicResource SidebarColor}"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{DynamicResource SidebarHoverColor}"/>
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="{DynamicResource SidebarSelectedColor}"/>
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{DynamicResource ContentBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{DynamicResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{DynamicResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="BorderBrushColor" Color="{DynamicResource BorderColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}"/>
    <!-- Единая кисть «подпись поля формы» (issue #61): подписи и заголовки полей ввода
         всегда контрастны в обеих темах, включая стенерированные схемы. -->
    <SolidColorBrush x:Key="FormLabelBrush" Color="{DynamicResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{DynamicResource TextOnAccentColor}"/>
    <SolidColorBrush x:Key="ButtonTextBrush" Color="{DynamicResource ButtonTextColor}"/>
    <SolidColorBrush x:Key="FavoriteBrush" Color="{DynamicResource FavoriteColor}"/>
    <SolidColorBrush x:Key="FavoriteTextBrush" Color="{DynamicResource FavoriteTextColor}"/>
    <SolidColorBrush x:Key="ItemHoverBrush" Color="{DynamicResource ItemHoverColor}"/>
    <SolidColorBrush x:Key="ItemSelectedBrush" Color="{DynamicResource ItemSelectedColor}"/>
    <SolidColorBrush x:Key="AvatarBackgroundBrush" Color="{DynamicResource AvatarBackgroundColor}"/>
    <SolidColorBrush x:Key="AvatarTextBrush" Color="{DynamicResource AvatarTextColor}"/>
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{DynamicResource SecondaryButtonBackgroundColor}"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="{DynamicResource SecondaryButtonHoverColor}"/>
    <SolidColorBrush x:Key="SecondaryButtonPressedBrush" Color="{DynamicResource SecondaryButtonPressedColor}"/>
    <!-- Кисти опасной кнопки (issue #26): единая красная заливка и белый текст. -->
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{DynamicResource DangerHoverColor}"/>
    <SolidColorBrush x:Key="DangerPressedBrush" Color="{DynamicResource DangerPressedColor}"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="{DynamicResource DangerTextColor}"/>
    <SolidColorBrush x:Key="SettingsToggleTrackBrush" Color="{DynamicResource SettingsToggleTrackColor}"/>
    <SolidColorBrush x:Key="ZebraRowBrush" Color="{DynamicResource ZebraRowColor}"/>
    <SolidColorBrush x:Key="TreeHoverBrush" Color="{DynamicResource TreeHoverColor}"/>
    <SolidColorBrush x:Key="TreeSelectedBrush" Color="{DynamicResource TreeSelectedColor}"/>
    <!-- Семантические статусы (аудит UI, п. 2.1). -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource ErrorColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{DynamicResource InfoColor}"/>
    <!-- Мягкая красная плашка и плашка закрепления (аудит UI, пп. 2.4–2.5). -->
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{DynamicResource DangerSoftColor}"/>
    <SolidColorBrush x:Key="DangerSoftBorderBrush" Color="{DynamicResource DangerSoftBorderColor}"/>
    <SolidColorBrush x:Key="PinnedBadgeBrush" Color="{DynamicResource PinnedBadgeColor}"/>
    <SolidColorBrush x:Key="PinnedBadgeTextBrush" Color="{DynamicResource PinnedBadgeTextColor}"/>
    <!-- Пикер иконок (аудит UI, п. 2.6). -->
    <SolidColorBrush x:Key="IconPickerBaseBrush" Color="{DynamicResource IconPickerBaseColor}"/>
    <SolidColorBrush x:Key="IconPickerHoverBrush" Color="{DynamicResource IconPickerHoverColor}"/>
</ResourceDictionary>