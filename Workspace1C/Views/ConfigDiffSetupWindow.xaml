<Window x:Class="Workspace1C.ConfigDiffSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        mc:Ignorable="d"
        Title="{loc:Loc ConfigDiff.Title}"
        Icon="{StaticResource AppIcon}"
        Width="560" MinHeight="440" MaxHeight="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <!-- Надписи радио-кнопок режима тоже берут цвет из темы: в светлой схеме без
             явного стиля они наследуют системный Foreground и могут сливаться с фоном
             (issue #316). -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}"/>
        <Style TargetType="Button" BasedOn="{StaticResource ModernButton}"/>
    </Window.Resources>

    <StackPanel x:Name="RootPanel" Margin="16">
        <!-- ============ Описание ============ -->
        <TextBlock Text="{loc:Loc ConfigDiff.Description}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

        <!-- ============ Режим сравнения ============ -->
        <RadioButton x:Name="ModeBaseVsCfRadio" GroupName="Mode" Content="{loc:Loc ConfigDiff.ModeBaseVsCf}"
                     Checked="OnModeChanged" Margin="0,0,0,6"/>
        <RadioButton x:Name="ModeCfVsCfRadio" GroupName="Mode" Content="{loc:Loc ConfigDiff.ModeCfVsCf}"
                     Checked="OnModeChanged" Margin="0,0,0,12"/>

        <!-- ============ База (режим «База ↔ .cf») ============ -->
        <StackPanel x:Name="BasePanel">
            <TextBlock Text="{loc:Loc ConfigDiff.SelectBase}" Margin="0,0,0,4"/>
            <!-- Issue #316: явный ItemTemplate — закрытый комбобокс показывает имя базы,
                 а не ToString() объекта (имя типа Infobase, «ключ»). -->
            <ComboBox x:Name="BasesBox" Padding="6,4" Margin="0,0,0,12"
                      SelectionChanged="OnBaseChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <!-- ============ Левый .cf (режим «.cf ↔ .cf») ============ -->
        <StackPanel x:Name="CfLeftPanel">
            <TextBlock Text="{loc:Loc ConfigDiff.SelectCfLeft}" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="LeftCfBox" Padding="6,4"/>
                <Button Grid.Column="1" Content="{loc:Loc ConfigDiff.Browse}" Width="90" Margin="8,0,0,0"
                        Click="OnBrowseLeft_Click"/>
            </Grid>
        </StackPanel>

        <!-- ============ Правый .cf ============ -->
        <TextBlock Text="{loc:Loc ConfigDiff.SelectCfRight}" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="RightCfBox" Padding="6,4"/>
            <Button Grid.Column="1" Content="{loc:Loc ConfigDiff.Browse}" Width="90" Margin="8,0,0,0"
                    Click="OnBrowseRight_Click"/>
        </Grid>

        <!-- ============ Платформа 1С ============ -->
        <TextBlock Text="{loc:Loc ConfigDiff.Platform}" Margin="0,0,0,4"/>
        <ComboBox x:Name="PlatformBox" Padding="6,4" Margin="0,0,0,4" IsEditable="True"/>
        <TextBlock x:Name="PlatformHint" Text="{loc:Loc ConfigDiff.PlatformHint}" FontSize="11" TextWrapping="Wrap"
                   Margin="0,0,0,10" Foreground="{DynamicResource TextSecondaryBrush}"/>

        <!-- ============ Ошибка ============ -->
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" FontSize="12"
                   MaxHeight="120" Visibility="Collapsed" Margin="0,0,0,10"/>

        <!-- ============ Кнопки ============ -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CompareButton" Content="{loc:Loc ConfigDiff.Compare}" Width="130"
                    Margin="0,0,8,0" Click="OnCompare_Click"/>
            <Button Content="{loc:Loc ConfigDiff.Cancel}" Width="100" IsCancel="True" Click="OnCancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>