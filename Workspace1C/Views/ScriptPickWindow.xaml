<Window x:Class="Workspace1C.ScriptPickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Title="Выбор скрипта"
        Width="680" Height="480" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="13"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <!-- Темизация окна «Выбор скрипта» (issue #291): стили из LightTheme/DarkTheme,
             как у остальных окон (BackupScenariosWindow и др.). -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ModernButton}"/>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ModernListBoxItem}"/>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <!-- Футер диалога (аудит UI, пп. 3.3 и 5.6): единые MinWidth/Padding и ключи локализации. -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="RunButton" Content="{loc:Loc Common.Run}" MinWidth="96" Margin="0,0,8,0" Padding="12,5" IsEnabled="False" Click="Run_Click"/>
            <Button x:Name="EditButton" Content="{loc:Loc Common.Edit}" MinWidth="96" Margin="0,0,8,0" Padding="12,5" IsEnabled="False" Click="Edit_Click"/>
            <Button Content="{loc:Loc Common.Close}" MinWidth="96" Padding="12,5" IsCancel="True" Click="Close_Click"/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="HintText" Grid.Row="0" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,6"/>

            <ListBox x:Name="ScenariosList" Grid.Row="1" BorderThickness="1" Margin="0,0,0,8"
                     SelectionChanged="ScenariosList_SelectionChanged"
                     MouseDoubleClick="ScenariosList_MouseDoubleClick"
                     KeyDown="ScenariosList_KeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="3">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding FilePath}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2">
                <!-- Issue #61: подписи полей — единая кисть формы FormLabelBrush (не вторичная
                     и не фиксированный тёмный цвет), а итоговая строка запуска — стиль
                     ModernTextBox: читаемый текст в обеих темах на фоне поля ввода. -->
                <TextBlock x:Name="PreviewLabel" Text="{loc:Loc Script.CommandLinePreview}" Foreground="{DynamicResource FormLabelBrush}" FontSize="11" Margin="2,0,0,2"/>
                <TextBox x:Name="PreviewBox" IsReadOnly="True" TextWrapping="Wrap" Padding="4"
                         Style="{StaticResource ModernTextBox}"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>