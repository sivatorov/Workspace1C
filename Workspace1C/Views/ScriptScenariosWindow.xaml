<Window x:Class="Workspace1C.ScriptScenariosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Title="Сценарии"
        Width="720" Height="540" MinWidth="580" MinHeight="430"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="13"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <!-- Темизация окна «Сценарии» (issue #291): стили из LightTheme/DarkTheme,
             как у остальных окон (BackupScenariosWindow, ConnectionSettingsWindow и др.). -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ModernButton}"/>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ModernListBoxItem}"/>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <!-- Футер диалога (аудит UI, пп. 3.3 и 5.4): единые MinWidth/Padding и ключи локализации. -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="AddButton" Content="{loc:Loc Common.Add}" MinWidth="96" Margin="0,0,8,0" Padding="12,5" Click="Add_Click"/>
            <Button x:Name="EditButton" Content="{loc:Loc Common.Edit}" MinWidth="96" Margin="0,0,8,0" Padding="12,5" IsEnabled="False" Click="Edit_Click"/>
            <Button x:Name="DeleteButton" Content="{loc:Loc Common.Delete}" MinWidth="96" Margin="0,0,8,0" Padding="12,5" IsEnabled="False" Click="Delete_Click"/>
            <Button Content="{loc:Loc Common.Close}" MinWidth="96" Padding="12,5" IsCancel="True" Click="Close_Click"/>
        </StackPanel>

        <ListBox x:Name="ScenariosList" SelectionChanged="ScenariosList_SelectionChanged"
                 BorderThickness="1" Margin="0,0,0,8"
                 MouseDoubleClick="ScenariosList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="3">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding FilePath}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding ParametersSummary}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>