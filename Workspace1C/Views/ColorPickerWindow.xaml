<Window x:Class="Workspace1C.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Workspace1C.Controls"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        mc:Ignorable="d"
        Title="{loc:Loc ColorPicker.Title}"
        Icon="{StaticResource AppIcon}"
        Height="560" Width="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Встроенный пикер цвета (полная палитра, яркость, RGB, HEX, предустановки) -->
        <controls:ColorPickerControl x:Name="Picker" Grid.Row="0"/>

        <!-- ============ Кнопки ============ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button MinWidth="90" Style="{DynamicResource ModernButton}" Margin="0,0,8,0" IsDefault="True" Click="OnOk_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource SuccessBrush}" Text="✔" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Common.Ok}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button MinWidth="110" Style="{DynamicResource SecondaryButton}" IsCancel="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="✖" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Common.Cancel}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
