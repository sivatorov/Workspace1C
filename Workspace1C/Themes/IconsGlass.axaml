<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        IconsGlass.axaml — набор иконок «Glass» (Phosphor Duotone — передний слой и полупрозрачный фон (.Back)).
        ФАЙЛ СГЕНЕРИРОВАН tools/icongen/generate_icon_sets.py — не редактируйте вручную,
        правьте карту tools/icongen/icon_map.py и перезапустите генератор.
        Источник: Phosphor Icons (duotone), MIT License.
        Ключи: Icon<Имя>.Glass — варианты ключей базового набора; Pack.<Kind>.Glass — варианты
        значков materialDesign:PackIcon; *.Back.Glass — полупрозрачный фоновый слой.
        Резолв и живое переключение: ThemeManager.ApplyIconSet переопределяет базовые
        ключи ресурсами активного набора (ThemeFeatureMap.IconOverrides).
    -->

    <!-- ===================== ГЛИФЫ КНОПОК ОКНА (рукописные, штрих) ===================== -->
    <StreamGeometry x:Key="IconMinimize.Glass">M6,12 L18,12</StreamGeometry>
    <StreamGeometry x:Key="IconMaximize.Glass">M6,6 L18,6 L18,18 L6,18 Z</StreamGeometry>
    <StreamGeometry x:Key="IconRestore.Glass">M9,6 H18 V15 H9 Z M6,9 H15 V18 H6 Z</StreamGeometry>
    <StreamGeometry x:Key="GlyphWindowMinimize.Glass">M6,12 H18</StreamGeometry>
