<Window x:Class="Workspace1C.BatchOperationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Icon="{StaticResource AppIcon}"
        Height="680" Width="980" MinHeight="520" MinWidth="780"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <!-- Раскладка issue #92 (v1.0.1.25, комментарий 7OH): список баз с поиском и
         кнопками «Выделить все/Снять все» — слева, на ВСЮ высоту окна и вдвое уже
         прежнего (колонки 1* : 2*); справа сверху вниз — подсказка, параметры операции
         (путь, шаблон, DT/CF, «Перед операцией»; высота по содержимому, подписи
         галочек видны целиком), журнал (оставшаяся высота), сводка и кнопки. -->
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"/>
        <!-- Тематизация полей ввода (issue #92, v100115): в тёмной теме поля
             PathBox/TemplateBox иначе рисуются системным стилем («чёрный на тёмном»). -->
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="240"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая колонка на всю высоту окна: поиск, «Выделить все/Снять все», список. -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Поиск по данным баз (issue #92, v1.0.1.25): лупа слева, текст начинается
                 правее неё, подсказка «Поиск по данным баз», кнопка очистки в конце поля.
                 Ищется подстрока в имени, группе, сервере, имени базы на сервере, пути
                 файловой базы и адресе веб-публикации (без учёта регистра). -->
            <Border Grid.Row="0" CornerRadius="6" BorderThickness="1" MinHeight="32"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrushColor}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{DynamicResource IconSearch}" Stretch="Uniform"
                          Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Fill="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Style="{x:Null}"
                             BorderThickness="0" Background="Transparent" Padding="0,5"
                             VerticalContentAlignment="Center"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock x:Name="SearchWatermark" Grid.Column="1" Margin="2,0,0,0"
                               Text="{loc:Loc BatchOps.SearchHint}" VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button x:Name="SearchClearButton" Grid.Column="2" Width="26" Height="26" Margin="0,0,3,0"
                            Padding="0" Cursor="Hand" ToolTip="{loc:Loc BatchOps.SearchClear}"
                            Click="OnSearchClear_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="{DynamicResource IconClose}" Stretch="Uniform" Width="10" Height="10"
                              Fill="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                </Grid>
            </Border>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,6">
                    <Button Content="{loc:Loc Selection.SelectAll}" Style="{StaticResource ModernButton}"
                            Background="{DynamicResource ItemHoverBrush}" Padding="12,5" Margin="0,0,8,0"
                            Click="OnSelectAll_Click"/>
                    <Button Content="{loc:Loc Selection.None}" Style="{StaticResource ModernButton}"
                            Background="{DynamicResource ItemHoverBrush}" Padding="12,5"
                            Click="OnSelectNone_Click"/>
                </StackPanel>

            <!-- Список баз с флажками -->
            <ListBox x:Name="ItemsList" Grid.Row="2"
                     BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding IsSelectable}"
                                  Margin="2,3" Cursor="Hand">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding StatusText}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Правая колонка: подсказка, параметры, журнал, сводка, кнопки. -->
        <Grid Grid.Column="1" Margin="14,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="HintText" Grid.Row="0" Margin="0,0,0,10"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>

            <!-- Путь: каталог выгрузки .dt/.cf или файл конфигурации .cf; ниже — шаблон
                 имени файла ({Имя}/{Дата}), формат DT/CF и блок «Перед операцией». -->
            <StackPanel Grid.Row="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PathLabel" Grid.Column="0" VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBox x:Name="PathBox" Grid.Column="1" VerticalContentAlignment="Center"
                             Text="{Binding PathText, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button x:Name="BrowseButton" Grid.Column="2" Content="…" Width="34" Margin="6,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Background="{DynamicResource ItemHoverBrush}"
                            Click="OnBrowse_Click"/>
                </Grid>
                <StackPanel x:Name="DumpOptionsPanel" Margin="0,8,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TemplateLabel" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="TemplateBox" Grid.Column="1" VerticalContentAlignment="Center"
                                 Text="{Binding Template, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{loc:Loc BatchOps.TemplateHint}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <RadioButton x:Name="KindDtRadio" GroupName="BatchDumpKind"
                                     VerticalAlignment="Center" Checked="OnKindDt_Checked"/>
                        <RadioButton x:Name="KindCfRadio" GroupName="BatchDumpKind" Margin="16,0,0,0"
                                     VerticalAlignment="Center" Checked="OnKindCf_Checked"/>
                    </StackPanel>
                    <!-- Выгрузка запущенных баз (issue #92, v1.0.1.25): ibcmd не проверяет
                         сеансы — под ответственность пользователя. -->
                    <CheckBox x:Name="AllowRunningCheck" Margin="0,6,0,0"
                              IsChecked="{Binding AllowRunningBases, UpdateSourceTrigger=PropertyChanged}">
                        <TextBlock x:Name="AllowRunningText" TextWrapping="Wrap"/>
                    </CheckBox>
                </StackPanel>

                <!-- Блок «Перед операцией» (issue #92, v1.0.1.21, пожелание aepkugesi):
                     завершение сеансов и блокировки сеансов/регламентных заданий перед
                     выгрузкой/загрузкой; после операции блокировки снимаются автоматически. -->
                <StackPanel x:Name="PreparePanel" Margin="0,10,0,0">
                    <TextBlock x:Name="PrepareHeader" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <CheckBox x:Name="PrepareTerminateCheck" Margin="0,1"
                              IsChecked="{Binding PrepareTerminateSessions, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,1">
                        <CheckBox x:Name="PrepareDenySessionsCheck" VerticalAlignment="Center"
                                  IsChecked="{Binding PrepareDenyNewSessions, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock x:Name="PreparePermissionLabel" VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <TextBox x:Name="PreparePermissionBox" Width="140" VerticalContentAlignment="Center"
                                 Text="{Binding PreparePermissionCode, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{loc:Loc BatchOps.Prepare.PermissionCodeHint}"/>
                    </StackPanel>
                    <CheckBox x:Name="PrepareDenyJobsCheck" Margin="0,1"
                              IsChecked="{Binding PrepareDenyScheduledJobs, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock x:Name="PrepareHint" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Поле «Пароль пользователя СУБД» (issue #92, v1.0.1.26, пожелание 7OH):
                     rac отдаёт логин СУБД (db-user), но не пароль; если у базы нет профиля
                     СУБД — пароль вводится здесь и подставляется в профиль после rac-резолва.
                     Файловым базам поле просто не используется. Пароль не сохраняется. -->
                <StackPanel x:Name="SqlPasswordPanel" Margin="0,10,0,0">
                    <TextBlock x:Name="SqlPasswordLabel" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <PasswordBox x:Name="SqlPasswordBox" Width="260" HorizontalAlignment="Left"
                                 VerticalContentAlignment="Center"/>
                    <TextBlock x:Name="SqlPasswordHint" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="LogHeader" Grid.Row="2" Margin="0,14,0,6" FontWeight="SemiBold"
                       Text="{loc:Loc BatchOps.Log}"/>

            <!-- Построчный лог прогона. Issue #92 (v1.0.1.26): IsHitTestVisible="False"
                 снят — именно он блокировал прокрутку журнала колесом и ползунком.
                 Выделение строк запрещено: контейнер без фокуса и без визуала выделения. -->
            <ListBox x:Name="LogList" Grid.Row="3" MinHeight="90"
                     BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                   FontFamily="Consolas"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="2,1"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="SummaryText" Grid.Row="4" Margin="0,10,0,0" FontWeight="SemiBold"
                       TextWrapping="Wrap" Text="{Binding Summary}"/>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="StopButton" Width="130" Margin="0,0,8,0" IsEnabled="False"
                        Style="{StaticResource ModernButton}"
                        Background="{DynamicResource ItemHoverBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Click="OnStop_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏹" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc BatchOps.Stop}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Margin="0,0,8,0" x:Name="RunButton" Width="190" IsDefault="True"
                        Style="{StaticResource ModernButton}" Click="OnRun_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="▶" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RunButtonText" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CloseButton" Width="110" IsCancel="True"
                        Style="{StaticResource ModernButton}"
                        Background="{DynamicResource ItemHoverBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Click="OnClose_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="✖" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Common.Close}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
