<Window x:Class="Workspace1C.ItsAccountEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Icon="{StaticResource AppIcon}"
        Width="460" Height="360"
        MinWidth="420" MinHeight="330"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Основная зелёная кнопка -->
        <!-- Кнопки — единый контракт (issue #26): акцентная ModernButton и вторичная
             SecondaryButton. Имена PrimaryButtonStyle/OutlineButtonStyle сохранены. -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>

        <!-- Серая кнопка-контур -->
        <Style x:Key="OutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="EditorTitle" Grid.Row="0" FontSize="15" FontWeight="SemiBold"/>

        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <!-- Фокус по умолчанию на первом поле (наименование) — issue #333. -->
            <TextBlock Text="{loc:Loc ItsAccounts.Name}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="NameBox" Padding="10,7" FontSize="13" VerticalContentAlignment="Center"/>

            <TextBlock Text="{loc:Loc ItsAccounts.Login}" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <TextBox x:Name="LoginBox" Padding="10,7" FontSize="13" VerticalContentAlignment="Center"/>

            <TextBlock Text="{loc:Loc ItsAccounts.Password}" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <!-- Просмотр пароля «глазом» (issue #333): при показе вместо PasswordBox
                 показывается редактируемое текстовое поле; правки возвращаются обратно
                 при скрытии (паттерн окна свойств базы, issue #211). -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <PasswordBox x:Name="PasswordBox" Padding="10,7" FontSize="13"
                                 VerticalContentAlignment="Center"/>
                    <TextBox x:Name="PasswordRevealTextBox" Visibility="Collapsed" Padding="10,7"
                             FontSize="13" VerticalContentAlignment="Center"/>
                </Grid>
                <Button x:Name="ShowPasswordToggle" Grid.Column="1" Width="32" Height="32" Margin="6,0,0,0"
                        Style="{DynamicResource IconButton}" Click="OnShowPasswordToggle_Click"
                        ToolTip="{loc:Loc Connection.ShowPasswordTooltip}">
                    <materialDesign:PackIcon Kind="EyeOutline" Width="16" Height="16"/>
                </Button>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SaveButton" Width="140" Height="34" Margin="0,0,10,0" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" Click="OnSaveClick">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Check" Width="16" Height="16"/>
                    <TextBlock Text="{loc:Loc Updates.Save}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="120" Height="34" IsCancel="True" Style="{StaticResource OutlineButtonStyle}"
                    Click="OnCancelClick">
                <TextBlock Text="{loc:Loc Updates.Cancel}" VerticalAlignment="Center"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>