<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        IconsWindowsXp.axaml — набор иконок «WindowsXp» (Phosphor Fill — плотные заливки классической Windows XP).
        ФАЙЛ СГЕНЕРИРОВАН tools/icongen/generate_icon_sets.py — не редактируйте вручную,
        правьте карту tools/icongen/icon_map.py и перезапустите генератор.
        Источник: Phosphor Icons (fill), MIT License.
        Ключи: Icon<Имя>.WindowsXp — варианты ключей базового набора; Pack.<Kind>.WindowsXp — варианты
        значков materialDesign:PackIcon; *.Back.WindowsXp — полупрозрачный фоновый слой.
        Резолв и живое переключение: ThemeManager.ApplyIconSet переопределяет базовые
        ключи ресурсами активного набора (ThemeFeatureMap.IconOverrides).
    -->

    <!-- ===================== ГЛИФЫ КНОПОК ОКНА (рукописные, штрих) ===================== -->
    <StreamGeometry x:Key="IconMinimize.WindowsXp">M6,12 L18,12</StreamGeometry>
    <StreamGeometry x:Key="IconMaximize.WindowsXp">M6,6 L18,6 L18,18 L6,18 Z</StreamGeometry>
    <StreamGeometry x:Key="IconRestore.WindowsXp">M9,6 H18 V15 H9 Z M6,9 H15 V18 H6 Z</StreamGeometry>
    <StreamGeometry x:Key="GlyphWindowMinimize.WindowsXp">M7,12 H14</StreamGeometry>
    <StreamGeometry x:Key="GlyphWindowMaximize.WindowsXp">M6,6 H18 V18 H6 Z M6,8.5 H18</StreamGeometry>
    <StreamGeometry x:Key="GlyphWindowRestore.WindowsXp">M5,10 H15 V19 H5 Z M5,12.5 H15 M9,10 V5 H19 V14 H15 M9,7.5 H19</StreamGeometry>
    <StreamGeometry x:Key="GlyphWindowClose.WindowsXp">M7,7 L17,17 M17,7 L7,17</StreamGeometry>

    <!-- ===================== ГЛИФЫ ШАБЛОНОВ ЭЛЕМЕНТОВ (ComboBox, подменю, CheckBox) ===================== -->
    <StreamGeometry x:Key="GlyphCheckMark.WindowsXp">M 3.5,7.6 L 6.6,10.8 L 14.2,3.4</StreamGeometry>
    <StreamGeometry x:Key="GlyphComboArrow.WindowsXp">M0,0 L4,4 L8,0 M0,3 L4,7 L8,3</StreamGeometry>
    <StreamGeometry x:Key="GlyphSubmenuArrow.WindowsXp">M 0,0 L 5,4.5 L 0,9 Z</StreamGeometry>

