<Window x:Class="Workspace1C.FindLostBasesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Title="{loc:Loc FindLostBases.Title}"
        Icon="{StaticResource AppIcon}"
        Width="920" Height="620"
        MinHeight="480" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Кнопки «Отметить все / Снять все»: без рамки, с подсветкой при наведении -->
        <Style x:Key="SelectAllButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" FontSize="15" FontWeight="SemiBold" Text="{loc:Loc FindLostBases.Title}"/>

        <!-- Верхняя панель: выбор дисков/корней + кнопки Найти базы / Прекратить -->
        <Border Grid.Row="1" Margin="0,12,0,0"
                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                CornerRadius="6" Background="{DynamicResource CardBackgroundBrush}">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,0,1"
                        Padding="8,4" Background="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource SelectAllButtonStyle}"
                                ToolTip="{loc:Loc FindLostBases.Drive.AllTooltip}" Click="OnDriveCheckAll">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckboxMultipleMarked" Width="16" Height="16"
                                                         Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc FindLostBases.Drive.All}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource SelectAllButtonStyle}"
                                Margin="16,0,0,0" ToolTip="{loc:Loc FindLostBases.Drive.NoneTooltip}" Click="OnDriveCheckNone">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckboxMultipleBlankOutline" Width="16" Height="16"
                                                         Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc FindLostBases.Drive.None}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Единый контракт кнопок (issue #26): «Остановить» — опасная
                             DangerButton, «Искать» — акцентная ModernButton. -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Button x:Name="StopButton" Width="120" Height="34" IsEnabled="False" Click="OnStop_Click"
                                    Style="{DynamicResource DangerButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="StopCircleOutline" Width="16" Height="16"
                                                             Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc FindLostBases.Button.Stop}" VerticalAlignment="Center"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Button Grid.Column="4" x:Name="SearchButton" Width="180" Height="34" IsDefault="True"
                                Click="OnSearch_Click" Style="{DynamicResource ModernButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderSearch" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc FindLostBases.Button.Search}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                <!-- Ввод произвольного каталога как дополнительного корня поиска -->
                <Border DockPanel.Dock="Top" Padding="8,4" Background="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderPathBox" Grid.Column="0" Height="30" Padding="6,0"
                                 VerticalContentAlignment="Center"
                                 materialDesign:HintAssist.Hint="{loc:Loc FindLostBases.FolderPlaceholder}"
                                 KeyDown="OnFolderPath_KeyDown"/>
                        <Button Grid.Column="1" x:Name="BrowseFolderButton" Height="30" Margin="8,0,0,0"
                                Padding="14,0" Cursor="Hand" Click="OnBrowseFolder_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderOutline" Width="16" Height="16"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc FindLostBases.Button.Browse}" Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" x:Name="AddFolderButton" Height="30" Margin="8,0,0,0"
                                Padding="14,0" Cursor="Hand" Click="OnAddFolder_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderPlus" Width="16" Height="16"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc FindLostBases.Button.AddFolder}" Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                <WrapPanel x:Name="DrivesPanel" Margin="8,6"/>
            </DockPanel>
        </Border>

        <!-- Таблица найденных баз -->
        <Border Grid.Row="2" Margin="0,12,0,0"
                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                CornerRadius="6" Background="{DynamicResource CardBackgroundBrush}">
            <DockPanel>
                <!-- «Отметить все / Снять все» для найденных баз -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,6,8,2">
                    <Button Style="{StaticResource SelectAllButtonStyle}"
                            ToolTip="{loc:Loc FindLostBases.FoundAllTooltip}" Click="OnFoundCheckAll">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckboxMultipleMarked" Width="16" Height="16"
                                                     Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc FindLostBases.FoundAll}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SelectAllButtonStyle}"
                            Margin="16,0,0,0" ToolTip="{loc:Loc FindLostBases.FoundNoneTooltip}" Click="OnFoundCheckNone">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckboxMultipleBlankOutline" Width="16" Height="16"
                                                     Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc FindLostBases.FoundNone}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <DataGrid x:Name="BasesGrid" AutoGenerateColumns="False"
                      HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserSortColumns="False" RowHeaderWidth="0" SelectionMode="Single"
                      CellEditEnding="OnCellEditEnding"
                      BorderThickness="0" Background="Transparent" GridLinesVisibility="None"
                      RowHeight="30" AlternatingRowBackground="{DynamicResource CardBackgroundBrush}">
                <DataGrid.Columns>
                    <!-- Флажок через шаблонную колонку с CheckBox -->
                    <DataGridTemplateColumn Width="60">
                        <DataGridTemplateColumn.Header>
                            <TextBlock x:Name="CheckedHeaderText" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{loc:Loc FindLostBases.Column.CheckedHeaderFormat}"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding NotInApp}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Width="*" Header="{loc:Loc FindLostBases.Column.Name}"
                                        Binding="{Binding Name}" IsReadOnly="True"/>
                    <DataGridTextColumn Width="2*" Header="{loc:Loc FindLostBases.Column.Path}"
                                        Binding="{Binding Path}" IsReadOnly="True"/>
                    <DataGridTextColumn Width="Auto" Header="{loc:Loc FindLostBases.Column.Size}"
                                        Binding="{Binding SizeText}" IsReadOnly="True"/>
                    <DataGridTextColumn Width="Auto" Header="{loc:Loc FindLostBases.Column.Modified}"
                                        Binding="{Binding LastWriteText}" IsReadOnly="True"/>

                    <!-- В приложении -->
                    <DataGridTemplateColumn Width="90" Header="{loc:Loc FindLostBases.Column.InApp}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="●" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           ToolTip="{loc:Loc FindLostBases.AlreadyInAppHint}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding InApp}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- В ibases.v8i -->
                    <DataGridTemplateColumn Width="90" Header="{loc:Loc FindLostBases.Column.InV8i}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="●" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding InIbasesV8i}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource PurpleAccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Нижняя панель: прогресс + Добавить в список баз / Закрыть -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Единый контракт кнопок (issue #26): «Добавить» — акцентная ModernButton,
                 «Закрыть» — вторичная SecondaryButton. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="AddButton" Width="200" Height="36" Margin="0,0,10,0" IsEnabled="False"
                        Click="OnAdd_Click" Style="{DynamicResource ModernButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="DatabasePlus" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc FindLostBases.Button.Add}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Width="140" Height="36" IsCancel="True"
                        Style="{DynamicResource SecondaryButton}" Click="OnClose_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Common.Close}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <CheckBox x:Name="AddToAppCheckBox" Content="{loc:Loc FindLostBases.AddToApp}"
                              IsChecked="True" Cursor="Hand" VerticalAlignment="Center"
                              Checked="OnDestinationChanged" Unchecked="OnDestinationChanged"/>
                    <CheckBox x:Name="AddToV8iCheckBox" Content="{loc:Loc FindLostBases.AddToV8i}"
                              IsChecked="True" Cursor="Hand" VerticalAlignment="Center"
                              Margin="16,0,0,0"
                              Checked="OnDestinationChanged" Unchecked="OnDestinationChanged"/>
                </StackPanel>
                <TextBlock x:Name="ProgressText" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SummaryText" FontSize="12" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
