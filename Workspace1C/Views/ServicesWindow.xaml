<Window x:Class="Workspace1C.ServicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        xmlns:local="clr-namespace:Workspace1C"
        xmlns:vm="clr-namespace:Workspace1C.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Icon="{StaticResource AppIcon}"
        Height="600" Width="900" MinHeight="460" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <!-- Строка статуса: цвет кружка из #RRGGBB модели строки. -->
        <local:BrushFromHexConverter x:Key="BrushFromHex"/>
        <!-- Кнопка «Системный диалог» видна только на Windows. -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Кнопка-иконка строки действий (issue #11): без текста, узкая, с подсказкой. -->
        <Style x:Key="IconOnlyButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <!-- Кнопка команды службы: только цветная иконка, без подписи (замечание 7OH
             18.10: «выключить надписи у кнопок управления состоянием на панели»),
             по ширине чуть больше кнопки «Добавить группу». -->
        <Style x:Key="CommandButton" TargetType="Button" BasedOn="{StaticResource IconOnlyButton}">
            <Setter Property="Padding" Value="13,5"/>
            <Setter Property="MinWidth" Value="44"/>
        </Style>
        <Style x:Key="ToolbarSeparator" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="{DynamicResource BorderBrushColor}"/>
        </Style>
    </Window.Resources>

    <!-- Порядок: сверху кнопки/заголовок/строки, внизу статус, последний — список
         (LastChildFill): он занимает всё оставшееся место (~15 строк). -->
    <DockPanel Margin="16" LastChildFill="True">
        <!-- Первая строка: «Настроить» и «Системный диалог» (только Windows; на Linux
             кнопка скрывается по CanOpenSystemDialog). -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="ConfigureButton" Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}" Padding="12,5" Margin="0,0,6,0"
                    Click="OnConfigure_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚙" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{loc:Loc Services.Configure}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="SystemDialogButton" Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}" Padding="12,5" Margin="0,0,6,0"
                    Visibility="{Binding CanOpenSystemDialog, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Click="OnSystemDialog_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🗔" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#2563EB"/>
                    <TextBlock Text="{loc:Loc Services.SystemDialog}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <!-- «Выдать права» (issue #11, 7OH 17.10): права текущего пользователя на
                 управление службами списка — один запрос повышения прав (только Windows). -->
            <Button x:Name="GrantRightsButton" Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}" Padding="12,5"
                    ToolTip="{loc:Loc Services.GrantRights.Hint}"
                    Visibility="{Binding CanGrantRights, Converter={StaticResource BooleanToVisibilityConverter}}"
                    IsEnabled="{Binding HasRows}"
                    Click="OnGrantRights_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🛡" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#7C3AED"/>
                    <TextBlock Text="{loc:Loc Services.GrantRights}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Заголовок списка «Службы». -->
        <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,8"
                   Text="{loc:Loc Services.ListTitle}"/>

        <!-- Строка кнопок-иконок над списком (issue #11). Группы («Добавить группу /
             Изменить группу / Удалить группу / Переместить выше / ниже») скрыты —
             место зарезервировано комментарием (итерация 2 issue #11). -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <!-- «Свернуть все»/«Развернуть все» (issue #11; замечание 7OH: глифы ⏷/⏶ не
                 совпадали с главным окном): те же PackIcon ExpandAll/CollapseAll, что в
                 главном окне (MainWindow.xaml:567 и 574), с разделителем после них. -->
            <Button x:Name="ExpandAllButton" Style="{StaticResource IconOnlyButton}"
                    ToolTip="{loc:Loc Services.ExpandAll}" IsEnabled="{Binding CanExpandAllGroups}"
                    Click="OnExpandAll_Click">
                <materialDesign:PackIcon Kind="ExpandAll" Width="18" Height="18"
                                         Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Button>
            <Button x:Name="CollapseAllButton" Style="{StaticResource IconOnlyButton}"
                    ToolTip="{loc:Loc Services.CollapseAll}" IsEnabled="{Binding CanExpandAllGroups}"
                    Click="OnCollapseAll_Click">
                <materialDesign:PackIcon Kind="CollapseAll" Width="18" Height="18"
                                         Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Button>
            <Border Style="{StaticResource ToolbarSeparator}"/>
            <!-- Порядок задаёт пользователь (issue #11, 7OH 17.10): «Переместить выше / ниже»
                 для корневых строк списка (службы вне групп и папки-группы); порядок служб
                 внутри группы задаётся в редакторе группы. -->
            <Button x:Name="MoveUpButton" Style="{StaticResource IconOnlyButton}"
                    ToolTip="{loc:Loc Services.MoveUp}" IsEnabled="{Binding CanMoveUp}"
                    Click="OnMoveUp_Click">
                <TextBlock Text="▲" VerticalAlignment="Center" Foreground="#2563EB"/>
            </Button>
            <Button x:Name="MoveDownButton" Style="{StaticResource IconOnlyButton}"
                    ToolTip="{loc:Loc Services.MoveDown}" IsEnabled="{Binding CanMoveDown}"
                    Click="OnMoveDown_Click">
                <TextBlock Text="▼" VerticalAlignment="Center" Foreground="#2563EB"/>
            </Button>
            <Border Style="{StaticResource ToolbarSeparator}"/>
            <!-- Группы служб (issue #11, итерация 2 — релиз 1.0.0.12): «Добавить/Изменить/
                 Удалить группу». Кнопки неактивны, пока окно не установит GroupEditorProvider
                 (окно редактирования группы — Задача 3). -->
            <Button x:Name="AddGroupButton" Style="{StaticResource IconOnlyButton}"
                    ToolTip="{loc:Loc Services.GroupAddHint}" IsEnabled="{Binding CanAddGroup}"
                    Click="OnAddGroup_Click">
                <TextBlock Text="📦" VerticalAlignment="Center" Foreground="#7C3AED"/>
            </Button>
            <Button x:Name="EditGroupButton" Style="{StaticResource IconOnlyButton}"
                    ToolTip="{loc:Loc Services.GroupEditHint}" IsEnabled="{Binding CanEditGroup}"
                    Click="OnEditGroup_Click">
                <TextBlock Text="✎" VerticalAlignment="Center" Foreground="#7C3AED"/>
            </Button>
            <!-- «Перенести в группу» (issue #11, 1.0.0.14): рядом с кнопкой правки. -->
            <Button x:Name="MoveToGroupButton" Style="{StaticResource IconOnlyButton}"
                    ToolTip="{loc:Loc Services.MoveToGroupHint}" IsEnabled="{Binding CanMoveToGroup}"
                    Click="OnMoveToGroup_Click">
                <TextBlock Text="⇄" VerticalAlignment="Center" Foreground="#0EA5E9"/>
            </Button>
            <Button x:Name="DeleteGroupButton" Style="{StaticResource IconOnlyButton}"
                    ToolTip="{loc:Loc Services.GroupDeleteHint}" IsEnabled="{Binding CanDeleteGroup}"
                    Click="OnDeleteGroup_Click">
                <TextBlock Text="🗑" VerticalAlignment="Center" Foreground="#DC2626"/>
            </Button>
            <Border Style="{StaticResource ToolbarSeparator}"/>
            <Button x:Name="RefreshButton" Style="{StaticResource IconOnlyButton}"
                    ToolTip="{loc:Loc Services.Refresh}" Click="OnRefresh_Click">
                <TextBlock Text="⟳" VerticalAlignment="Center" Foreground="#2563EB"/>
            </Button>
            <Border Style="{StaticResource ToolbarSeparator}"/>
            <!-- Команды — только цветные иконки, без подписей (замечание 7OH 18.10:
                 «выключить надписи у кнопок управления состоянием на панели»);
                 подписи — подсказками, в контекстном меню подписи остаются.
                 «Восстановить» — треугольник с палочкой справа (ServiceCommandGlyphs). -->
            <Button x:Name="StartButton" Style="{StaticResource CommandButton}"
                    ToolTip="{loc:Loc Services.Start}"
                    IsEnabled="{Binding CanStart}" Click="OnStart_Click">
                <TextBlock Text="{x:Static vm:ServiceCommandGlyphs.StartGlyph}" VerticalAlignment="Center" Foreground="#16A34A"/>
            </Button>
            <Button x:Name="StopButton" Style="{StaticResource CommandButton}"
                    ToolTip="{loc:Loc Services.Stop}"
                    IsEnabled="{Binding CanStop}" Click="OnStop_Click">
                <TextBlock Text="{x:Static vm:ServiceCommandGlyphs.StopGlyph}" VerticalAlignment="Center" Foreground="#DC2626"/>
            </Button>
            <Border Style="{StaticResource ToolbarSeparator}"/>
            <Button x:Name="PauseButton" Style="{StaticResource CommandButton}"
                    ToolTip="{loc:Loc Services.Pause}"
                    IsEnabled="{Binding CanPause}" Click="OnPause_Click">
                <TextBlock Text="{x:Static vm:ServiceCommandGlyphs.PauseGlyph}" VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}"/>
            </Button>
            <Button x:Name="ContinueButton" Style="{StaticResource CommandButton}"
                    ToolTip="{loc:Loc Services.Continue}"
                    IsEnabled="{Binding CanContinue}" Click="OnContinue_Click">
                <TextBlock Text="{x:Static vm:ServiceCommandGlyphs.ContinueGlyph}" VerticalAlignment="Center" Foreground="#0EA5E9"/>
            </Button>
            <Border Style="{StaticResource ToolbarSeparator}"/>
            <Button x:Name="RestartButton" Style="{StaticResource CommandButton}"
                    ToolTip="{loc:Loc Services.Restart}"
                    IsEnabled="{Binding CanRestart}" Click="OnRestart_Click">
                <TextBlock Text="{x:Static vm:ServiceCommandGlyphs.RestartGlyph}" VerticalAlignment="Center" Foreground="#2563EB"/>
            </Button>
            <Border Style="{StaticResource ToolbarSeparator}"/>
            <!-- Подменю «Все сервисы» (Запустить / Остановить / Перезапустить). -->
            <Button x:Name="AllServicesButton" Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}" Padding="10,5" Margin="0,0,6,0"
                    Click="OnAllServices_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Loc Services.AllServices}" VerticalAlignment="Center"/>
                    <TextBlock Text=" ▾" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Подсказка при пустом списке (issue #11): ничего в сам ListBox не добавляем. -->
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{loc:Loc Services.Empty}" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasRows}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Статус-строка окна (ошибки, «недоступно на этой системе»). -->
        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{Binding StatusText}" TextWrapping="Wrap"/>

        <!-- Список служб — иерархический (issue #11, 1.0.0.14): службы вне групп —
             корневые строки, группы — папки, внутри которых службы, как базы внутри
             групп в основном окне. Заполняет остаток окна. -->
        <TreeView x:Name="ServicesList" ItemsSource="{Binding Rows}"
                  SelectedItemChanged="OnServicesList_SelectedItemChanged"
                  ContextMenuOpening="OnServicesList_ContextMenuOpening"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  Background="{DynamicResource CardBackgroundBrush}">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="MinHeight" Value="26"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Padding" Value="8,2"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.Resources>
                <!-- Папка-группа: кружок статуса + иконка-папка + имя + статус;
                     дети — службы группы (ItemsSource на Children). -->
                <HierarchicalDataTemplate DataType="{x:Type vm:ServiceGroupRow}" ItemsSource="{Binding Children}">
                    <!-- Нижний отступ строки-папки (замечание 7OH 19.10): без него высота
                         строки группы чуть меньше высоты обычной строки службы. -->
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <!-- Галочка «Временно отключить» (issue #37). -->
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Fill="{Binding StatusColorHex, Converter={StaticResource BrushFromHex}}"/>
                        <TextBlock Grid.Column="1" Text="📦" Margin="0,0,6,0"
                                   VerticalAlignment="Center" Foreground="#7C3AED"/>
                        <TextBlock Grid.Column="2" Text="{Binding DisplayName}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="3" Text="{Binding StatusText}"
                                   VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="12,0,0,0"/>
                        <CheckBox Grid.Column="4" Margin="14,0,0,0" VerticalAlignment="Center"
                                  IsChecked="{Binding IsTemporarilyDisabled, Mode=TwoWay}"
                                  ToolTip="{loc:Loc Services.TemporarilyDisable}"/>
                    </Grid>
                </HierarchicalDataTemplate>
                <!-- Служба (корневая или внутри группы). -->
                <DataTemplate DataType="{x:Type vm:ServiceInfoRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <!-- Галочка «Временно отключить» (issue #37). -->
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Fill="{Binding StatusColorHex, Converter={StaticResource BrushFromHex}}"/>
                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding StatusText}"
                                   VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="12,0,0,0"/>
                        <CheckBox Grid.Column="3" Margin="14,0,0,0" VerticalAlignment="Center"
                                  IsChecked="{Binding IsTemporarilyDisabled, Mode=TwoWay}"
                                  ToolTip="{loc:Loc Services.TemporarilyDisable}"/>
                    </Grid>
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>
    </DockPanel>
</Window>