<Window x:Class="Workspace1C.ServerEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Icon="{StaticResource AppIcon}"
        Height="420" Width="480" MinHeight="400" MinWidth="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <!-- Issue #61: у явного стиля FieldLabel Foreground не наследуется от неявного
                 стиля окна — задаём кисть подписи формы явно, иначе в тёмной теме
                 подписи полей остаются чёрными. -->
            <Setter Property="Foreground" Value="{DynamicResource FormLabelBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- Единый отступ каркаса диалога 14 (аудит UI, п. 3.2). -->
    <StackPanel Margin="14">
        <TextBlock x:Name="EditorTitle" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:Loc ServerMonitor.Servers.Description}"
                       Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="DescriptionBox" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                     Padding="6,3" VerticalContentAlignment="Center"/>
        </Grid>

        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:Loc ServerMonitor.Servers.Address}"
                       Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="AddressBox" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                     Padding="6,3" VerticalContentAlignment="Center"
                     ToolTip="{loc:Loc ServerMonitor.PortTooltip}"/>
        </Grid>

        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:Loc ServerMonitor.Servers.Port}"
                       Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="PortBox" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                     Padding="6,3" VerticalContentAlignment="Center"
                     ToolTip="{loc:Loc ServerMonitor.PortTooltip}"/>
        </Grid>

        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:Loc ServerMonitor.Servers.User}"
                       Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="UserBox" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                     Padding="6,3" VerticalContentAlignment="Center"/>
        </Grid>

        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:Loc ServerMonitor.Servers.Password}"
                       Style="{StaticResource FieldLabel}"/>
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="PasswordBox" Grid.Column="0" Padding="6,3"/>
                <!-- Issue #49: поле показа пароля — обычный TextBox (раньше был второй
                     PasswordBox, и «глаз» снова показывал маску вместо пароля). -->
                <!-- Поле показа пароля — стиль темы (issue #51: акцентный контур; #61:
                     читаемый текст в тёмной схеме вместо дефолтного чёрного). -->
                <TextBox x:Name="PasswordRevealTextBox" Grid.Column="0" Padding="6,3"
                         Style="{StaticResource ModernTextBox}"
                         VerticalContentAlignment="Center" Visibility="Collapsed"/>
                <Button x:Name="ShowPasswordButton" Grid.Column="1" Width="30" Margin="6,0,0,0"
                        Style="{DynamicResource IconButton}"
                        Content="👁" Click="OnShowPasswordToggle_Click"/>
            </Grid>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SaveButton" Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}" Padding="16,6" Margin="0,0,8,0"
                    IsDefault="True" Click="OnSaveClick">
                <TextBlock Text="{loc:Loc Updates.Save}" VerticalAlignment="Center"/>
            </Button>
            <Button x:Name="CancelButton" Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}" Padding="16,6"
                    IsCancel="True" Click="OnCancelClick">
                <TextBlock Text="{loc:Loc Updates.Cancel}" VerticalAlignment="Center"/>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
