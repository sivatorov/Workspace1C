<!-- Диалог ввода произвольного названия (Avalonia/Linux). Тексты приходят
     параметрами конструктора, а не из локализации: окно используется под
     разные задачи (переименование схемы, группы и прочее), поэтому в разметке
     только раскладка. Windows-аналог: Views/NameInputWindow.xaml. -->
<local:ModalWindowBase xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:local="clr-namespace:Workspace1C"
                       x:Class="Workspace1C.NameInputWindow"
                       MinWidth="440"
                       MinHeight="200"
                       SizeToContent="Height"
                       FontSize="13"
                       CanResize="False"
                       SystemDecorations="None">
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto">
        <TextBlock Grid.Row="0" x:Name="Prompt" Margin="0,0,0,8"/>
        <TextBox Grid.Row="1" x:Name="NameBox" TabIndex="0" Theme="{DynamicResource ModernTextBox}"/>
        <!-- Отступ панели кнопок сверху взят из разметки WPF. -->
        <ContentControl Grid.Row="2" x:Name="ButtonsHost" Margin="0,16,0,0"/>
    </Grid>
</local:ModalWindowBase>
