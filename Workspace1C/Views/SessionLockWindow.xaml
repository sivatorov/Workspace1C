<!-- Высота окна увеличена (issue #20, комментарий 7OH 20.10): «Код разрешения»
     с описанием должен помещаться без прокрутки. -->
<Window x:Class="Workspace1C.SessionLockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        mc:Ignorable="d"
        Title="{loc:Loc SessionLock.Title}"
        Icon="{StaticResource AppIcon}"
        Height="680" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}"/>
        <Style TargetType="Button" BasedOn="{StaticResource ModernButton}"/>
    </Window.Resources>

    <!-- Компоновка (issue #20): поля — в прокручиваемой области, кнопки зафиксированы
         снизу и всегда видны (раньше при малом экране нижние кнопки и часть последнего
         поля ввода уходили за границу окна). -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- ============ Описание ============ -->
                <TextBlock x:Name="DescriptionLabel" Text="{loc:Loc SessionLock.Description}"
                           TextWrapping="Wrap" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <!-- ============ Время начала ============ -->
                <TextBlock Text="{loc:Loc SessionLock.StartTime}" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Высота полей выровнена с остальными (issue #20, комментарий 7OH 20.10):
                         DatePicker по умолчанию выше TextBox/ComboBox (ModernTextBox MinHeight=36). -->
                    <DatePicker x:Name="StartDate" Height="36" Padding="6,4" SelectedDateFormat="Short"/>
                    <TextBox x:Name="StartTimeBox" Grid.Column="1" Width="110" Height="36" Margin="8,0,0,0" Padding="6,4"/>
                </Grid>

                <!-- ============ Длительность ============ -->
                <TextBlock Text="{loc:Loc SessionLock.Duration}" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DurationBox" Height="36" Padding="6,4"/>
                    <TextBlock x:Name="DurationUnitLabel" Grid.Column="1" Text="{loc:Loc SessionLock.Minutes}"
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Grid>

                <!-- ============ Шаблон ============ -->
                <TextBlock Text="{loc:Loc SessionLock.Template}" Margin="0,0,0,4"/>
                <ComboBox x:Name="TemplateBox" SelectionChanged="TemplateBox_SelectionChanged" Margin="0,0,0,10" Padding="6,4"/>

                <!-- ============ Сообщение ============ -->
                <TextBlock Text="{loc:Loc SessionLock.Message}" Margin="0,0,0,4"/>
                <TextBox x:Name="MessageTextBox" Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Padding="6,4" Margin="0,0,0,4"/>
                <TextBlock x:Name="PlaceholdersHint" Text="{loc:Loc SessionLock.PlaceholdersHint}"
                           TextWrapping="Wrap" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <!-- ============ Код разрешения (issue #20, 1cv8.cdn) ============ -->
                <TextBlock Text="{loc:Loc SessionLock.PermissionCode}" Margin="0,0,0,4"/>
                <TextBox x:Name="PermissionCodeBox" Padding="6,4" Margin="0,0,0,4"/>
                <TextBlock Text="{loc:Loc SessionLock.PermissionCodeHint}"
                           TextWrapping="Wrap" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ Кнопки (всегда видны, issue #20) ============ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="UnlockButton" Width="180" Margin="0,0,8,0"
                    Click="OnUnlock_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource SuccessBrush}" Text="✔" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="UnlockTextBlock" Text="{loc:Loc SessionLock.Unlock}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="LockButton" Width="180" IsDefault="True"
                    Click="OnLock_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔒" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LockTextBlock" Text="{loc:Loc SessionLock.Lock}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
