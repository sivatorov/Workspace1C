<!-- Окно «Миграция между кластерами 1С» (issue #41, переработка по комментарию 7OH,
     Avalonia/Linux). Windows-аналог: Views/ClusterMigrationWindow.xaml. Двухпанельная
     раскладка: группа «Источник» (Сервер 1С + Подключиться, Кластер + Получить базы,
     Загружено баз) и группа «Приёмник» (те же поля; кнопка «Получить статусы» проставляет
     статусы приёмника «Есть в кластере»/пусто по совпадению имени). Чеклист баз источника
     со статусами источника/приёмника, опции «Создавать группу по имени кластера» и
     «Не удалять в старом кластере», учётные данные СУБД и кнопка «Мигрировать». Вся
     логика — в чистой ClusterMigrationViewModel; панели «Источник»/«Приёмник» и кнопки
     строит код за разметкой в хостах (паттерн BaseSelectionWindow.axaml). -->
<local:ModalWindowBase xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:local="clr-namespace:Workspace1C"
                       xmlns:loc="clr-namespace:Workspace1C.Localization"
                       x:Class="Workspace1C.ClusterMigrationWindow"
                       Title="{loc:Loc ClusterMigration.Title}"
                       Width="1200" Height="700"
                       MinWidth="1000" MinHeight="520"
                       FontSize="13"
                       CanResize="True">
    <Grid Margin="16" RowDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">

        <!-- Двухпанельная раскладка: «Источник» и «Приёмник» (issue #41).
             Панели строит код (Controls.GroupBoxPanel.Build) в хостах. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,24,*" Margin="0,0,0,10">
            <ContentControl x:Name="SourcePanelHost" Grid.Column="0"/>
            <ContentControl x:Name="TargetPanelHost" Grid.Column="2"/>
        </Grid>

        <!-- Чеклист баз источника: флажок, имя, описание, кластер, подключение,
             статус источника, статус приёмника. Фон списка — явная кисть темы
             (issue #76 «Цвета фона строк»): не полагаемся только на глобальный
             селектор, чтобы строки не оставались светлыми в тёмной теме. -->
        <ListBox Grid.Row="1" x:Name="BasesList"
                 Background="{DynamicResource CardBackgroundBrush}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto,1.2*,130,1.4*,130,130" Margin="2,2">
                        <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center"
                                  Grid.Column="0" Margin="0,0,8,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.65"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding ClusterName}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="3" Text="{Binding ConnectionString}"
                                   FontSize="11" Opacity="0.7" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="4" Text="{Binding SourceStatus}"
                                   FontSize="11" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="5" Text="{Binding TargetStatusDisplay}"
                                   FontSize="11" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Сводка выделения «Выделено: N из M · будет перенесено: N» + кнопки
             «Выделить все»/«Снять все» (issue #41, комментарий 7OH): сразу под списком,
             НАД галочками-опциями. Контент строит код (BulkHost — паттерн BaseSelectionWindow). -->
        <ContentControl Grid.Row="2" x:Name="BulkHost" Margin="0,8,0,0"/>

        <!-- Опции: «Создавать группу по имени кластера» + «Не удалять в старом кластере»
             в одной строке (issue #41). -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="18" Margin="0,8,0,0">
            <CheckBox x:Name="GroupByClusterCheck"
                      Content="{loc:Loc ClusterMigration.GroupByCluster}"
                      VerticalAlignment="Center"/>
            <CheckBox x:Name="KeepInSourceCheck"
                      Content="{loc:Loc ClusterMigration.KeepInSource}"
                      VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Тип СУБД + Сервер СУБД (issue #41, комментарий 7OH): rac «infobase create»
             требует непустые значения "dbms" и "db-server"; для приёмника на другом
             сервере СУБД значения источника не подходят. Строка выше учётных данных СУБД. -->
        <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto,*" Margin="0,8,0,0">
            <TextBlock Text="{loc:Loc ClusterMigration.Dbms}" VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <ComboBox x:Name="DbmsBox" Grid.Column="1" Padding="6,2"
                      VerticalContentAlignment="Center"
                      ItemsSource="{Binding DbmsOptions}"
                      SelectedItem="{Binding Dbms, Mode=TwoWay}"/>
            <TextBlock Grid.Column="2" Text="{loc:Loc ClusterMigration.DbServer}"
                       VerticalAlignment="Center" Margin="14,0,8,0"/>
            <TextBox x:Name="DbServerBox" Grid.Column="3" Padding="6,4"
                     VerticalContentAlignment="Center"
                     Text="{Binding DbServer, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <!-- Учётные данные СУБД в одну линию. -->
        <Grid Grid.Row="5" ColumnDefinitions="Auto,*,Auto,*,Auto,Auto" Margin="0,8,0,0">
            <TextBlock Text="{loc:Loc ClusterMigration.DbUser}" VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBox x:Name="DbUserBox" Grid.Column="1" Padding="6,4"
                     VerticalContentAlignment="Center"
                     Text="{Binding DbUser, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Column="2" Text="{loc:Loc ClusterMigration.DbPassword}"
                       VerticalAlignment="Center" Margin="14,0,8,0"/>
            <TextBox x:Name="DbPasswordBox" Grid.Column="3" Padding="6,4"
                      PasswordChar="•" VerticalContentAlignment="Center"/>
            <!-- Локаль — после логина/пароля, списком выбора как при добавлении базы
                 (issue #41, комментарий 7OH: «Поле с локалью на поле не замечено»). -->
            <TextBlock Grid.Column="4" Text="{loc:Loc ClusterMigration.Locale}"
                       VerticalAlignment="Center" Margin="14,0,8,0"/>
            <ComboBox x:Name="LocaleBox" Grid.Column="5" Padding="6,2" MinWidth="110"
                      VerticalContentAlignment="Center"
                      ItemsSource="{Binding LocaleOptions}"
                      SelectedItem="{Binding Locale, Mode=TwoWay}"/>
        </Grid>

        <!-- Прогресс «N из M: база» + сообщение об ошибке, затем «Мигрировать»/«Отмена». -->
        <StackPanel Grid.Row="6" Margin="0,10,0,0" Spacing="6">
            <Grid RowDefinitions="Auto,Auto">
                <TextBlock x:Name="ProgressText" FontSize="12" Opacity="0.65"
                           VerticalAlignment="Center"/>
                <!-- Полоса прогресса на всю ширину окна (issue #41: «сделать побольше
                     по ширине, а не только под локалью») — отдельной строкой, растянутой
                     на всю доступную ширину (HorizontalAlignment=Stretch). -->
                <ProgressBar x:Name="BusyProgress" Grid.Row="1" Height="4" MinWidth="200"
                             HorizontalAlignment="Stretch" Margin="0,5,0,0" IsIndeterminate="True"
                             Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Center" IsVisible="False"/>
            </Grid>
            <TextBlock x:Name="ErrorText" FontSize="12" Foreground="{DynamicResource ErrorBrush}"
                       TextWrapping="Wrap"/>
            <DockPanel Margin="0,10,0,0">
                <ContentControl x:Name="CancelHost" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                <ContentControl x:Name="MigrateHost" DockPanel.Dock="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </StackPanel>
    </Grid>
</local:ModalWindowBase>
