<Window x:Class="Workspace1C.RacInfobaseCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Icon="{StaticResource AppIcon}"
        Height="600" Width="560" MinHeight="540" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <!-- Issue #61: у явного стиля FieldLabel Foreground не наследуется от неявного
                 стиля окна — задаём кисть подписи формы явно, иначе в тёмной теме
                 подписи полей остаются чёрными. -->
            <Setter Property="Foreground" Value="{DynamicResource FormLabelBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- Горизонтальная полоса - fallback (issue #55): при узком окне контент не
         обрезается правым краем, а прокручивается. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <!-- Единый отступ каркаса диалога 14 (аудит UI, п. 3.2). -->
        <StackPanel Margin="14">
            <TextBlock x:Name="EditorTitle" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Loc ServerMonitor.Infobase.Name}"
                           Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NameBox" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                         Padding="6,3" VerticalContentAlignment="Center"/>
            </Grid>

            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Loc ServerMonitor.Infobase.Description}"
                           Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="DescriptionBox" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                         Padding="6,3" VerticalContentAlignment="Center"/>
            </Grid>

            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Loc ServerMonitor.Infobase.Dbms}"
                           Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="DbmsBox" Grid.Column="1" Style="{StaticResource ModernComboBox}"
                          Padding="6,3" VerticalContentAlignment="Center"/>
            </Grid>

            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Loc ServerMonitor.Infobase.DbServer}"
                           Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="DbServerBox" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                         Padding="6,3" VerticalContentAlignment="Center"/>
            </Grid>

            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Loc ServerMonitor.Infobase.DbName}"
                           Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="DbNameBox" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                         Padding="6,3" VerticalContentAlignment="Center"/>
            </Grid>

            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Loc ServerMonitor.Infobase.DbUser}"
                           Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="DbUserBox" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                         Padding="6,3" VerticalContentAlignment="Center"/>
            </Grid>

            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Loc ServerMonitor.Infobase.DbPassword}"
                           Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="DbPasswordBox" Grid.Column="1" Padding="6,3"/>
            </Grid>

            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Loc ServerMonitor.Infobase.Locale}"
                           Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="LocaleBox" Grid.Column="1" Style="{StaticResource ModernComboBox}"
                          Padding="6,3" VerticalContentAlignment="Center"/>
            </Grid>

            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Loc ServerMonitor.Infobase.SecurityLevel}"
                           Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="SecurityLevelBox" Grid.Column="1" Style="{StaticResource ModernComboBox}"
                          Padding="6,3" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="0"/>
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                </ComboBox>
            </Grid>

            <CheckBox x:Name="CreateDbBox" Margin="160,8,0,0" VerticalContentAlignment="Center"
                      IsChecked="False">
                <TextBlock Text="{loc:Loc ServerMonitor.Infobase.CreateDb}" VerticalAlignment="Center"/>
            </CheckBox>

            <CheckBox x:Name="ScheduledJobsDenyBox" Margin="160,4,0,0" VerticalContentAlignment="Center"
                      IsChecked="False">
                <TextBlock Text="{loc:Loc ServerMonitor.Infobase.ScheduledJobsDeny}" VerticalAlignment="Center"/>
            </CheckBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="SaveButton" Style="{StaticResource ModernButton}"
                        Background="{DynamicResource ItemHoverBrush}" Padding="16,6" Margin="0,0,8,0"
                        IsDefault="True" Click="OnSaveClick">
                    <TextBlock Text="{loc:Loc Updates.Save}" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="CancelButton" Style="{StaticResource ModernButton}"
                        Background="{DynamicResource ItemHoverBrush}" Padding="16,6"
                        IsCancel="True" Click="OnCancelClick">
                    <TextBlock Text="{loc:Loc Updates.Cancel}" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>