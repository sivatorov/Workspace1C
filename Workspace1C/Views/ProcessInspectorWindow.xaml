<Window x:Class="Workspace1C.ProcessInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Icon="{StaticResource AppIcon}"
        Height="560" Width="1080" MinHeight="400" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Вертикальное выравнивание содержимого ячеек по центру (как в MaintenanceCenterWindow). -->
        <Style x:Key="CenteredCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <Style x:Key="CellTextAccent" TargetType="TextBlock" BasedOn="{StaticResource CenteredCellText}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и итоговая строка -->
        <TextBlock Grid.Row="0" FontSize="15" FontWeight="SemiBold"
                   Text="{loc:Loc ProcessInspector.Title}"/>
        <TextBlock x:Name="SummaryTextBlock" Grid.Row="1" Margin="0,6,0,10" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding SummaryText}"/>

        <!-- Таблица процессов 1С -->
        <DataGrid x:Name="ProcessesGrid" Grid.Row="2"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  GridLinesVisibility="Horizontal"
                  RowHeight="38"
                  AlternatingRowBackground="{DynamicResource CardBackgroundBrush}"
                  BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                  MouseDoubleClick="OnGrid_MouseDoubleClick">
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <!-- База: имя (или «Неизвестная база») + пояснение -->
                <DataGridTemplateColumn Width="2*" Header="{loc:Loc ProcessInspector.Base}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" Margin="4,0">
                                <TextBlock Text="{Binding BaseName}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Width="*" Header="{loc:Loc ProcessInspector.Mode}"
                                    Binding="{Binding ModeText}"
                                    ElementStyle="{StaticResource CellTextAccent}"/>
                <DataGridTextColumn Width="*" Header="{loc:Loc ProcessInspector.User}"
                                    Binding="{Binding UserName}"
                                    ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn Width="*" Header="{loc:Loc ProcessInspector.StartTime}"
                                    Binding="{Binding StartTimeText}"
                                    ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn Width="70" Header="PID"
                                    Binding="{Binding Pid}"
                                    ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn Width="1.6*" Header="{loc:Loc ProcessInspector.Connection}"
                                    Binding="{Binding ConnectionText}"
                                    ElementStyle="{StaticResource CenteredCellText}"
                                    ToolTipService.ToolTip="{Binding FullCommandLine}"/>

                <!-- Значок-флаг: сопоставлен ли процесс с известной базой -->
                <DataGridTemplateColumn Width="96" Header="{loc:Loc ProcessInspector.Known}"
                                        CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding KnownSymbol}" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKnown}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопки: «Обновить», «Завершить процесс», «Закрыть» -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="RefreshButton" Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}" Padding="12,5" Margin="0,0,8,0"
                    Click="OnRefresh_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⟳" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc ProcessInspector.Refresh}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="KillButton" Width="170" Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}" Margin="0,0,8,0"
                    Click="OnKillProcess_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✕" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc ProcessInspector.KillProcess}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="CloseButton" Width="110" IsCancel="True"
                    Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Click="OnClose_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="✖" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Common.Close}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock x:Name="HintText" Grid.Row="4" Margin="0,8,0,0" FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{loc:Loc ProcessInspector.Hint}"/>
    </Grid>
</Window>
