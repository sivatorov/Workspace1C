<Window x:Class="Workspace1C.Services.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Title="{loc:Loc Update.NewVersionAvailable}"
        Icon="{StaticResource AppIcon}"
        SizeToContent="Height"
        Width="680"
        MaxWidth="760"
        MinWidth="640"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </Window.Resources>

    <Border Padding="0" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}">
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Иконка (общая для всех этапов диалога) -->
            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Margin="0,0,16,0"
                    VerticalAlignment="Top"
                    Background="{DynamicResource ItemHoverBrush}">
                <materialDesign:PackIcon Kind="CloudDownloadOutline"
                                         Width="24" Height="24" Foreground="{DynamicResource AccentBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1">

                <!-- Этап 1: предложение скачать новую версию -->
                <StackPanel x:Name="OfferPanel">
                    <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CurrentVersionText" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="NewVersionText" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="WhatsNewLabel" Margin="0,14,0,4" FontWeight="SemiBold"/>
                    <FlowDocumentScrollViewer x:Name="BodyViewer" MaxHeight="180"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              IsToolBarVisible="False"
                                              FontSize="12"
                                              Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <!-- Кнопки: «Скачать» слева, «Отмена» справа; между ними —
                         «Пропустить эту версию» (issue #116): версия не будет
                         предлагаться до выхода более новой.
                         Единый контракт кнопок (issue #26): скачивание — ModernButton
                         (акцентная заливка AccentBrush + контрастный TextOnAccentBrush),
                         пропуск и отмена — SecondaryButton (карточка + контур + текст темы).
                         Прежняя жёсткая зелёная кнопка #16A34A с белым текстом убрана. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="DownloadButton" Width="150" Height="34" Padding="0" IsDefault="True"
                                Style="{DynamicResource ModernButton}" Margin="0,0,10,0"
                                Click="OnDownloadClick">
                            <TextBlock x:Name="DownloadText" Text="{loc:Loc Update.Download}" VerticalAlignment="Center"
                                       FontWeight="SemiBold" FontSize="13"/>
                        </Button>
                        <!-- Issue #107 п.2 (v1.0.1.50): MinWidth вместо Width — кнопка
                             авторасширяется, «Пропустить эту версию» больше не обрезается
                             при другом масштабе шрифта/длинных локализациях. -->
                        <Button x:Name="SkipVersionButton" MinWidth="170" Height="34"
                                Style="{DynamicResource SecondaryButton}" Margin="0,0,10,0"
                                ToolTip="{loc:Loc Update.SkipHint}"
                                Click="OnSkipVersionClick">
                            <TextBlock x:Name="SkipVersionText" Text="{loc:Loc Update.SkipVersion}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Button>
                        <Button x:Name="CancelButton" Width="100" Height="34"
                                Style="{DynamicResource SecondaryButton}"
                                Click="OnCancelClick">
                            <TextBlock x:Name="CancelText" Text="{loc:Loc Update.Cancel}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Этап 2: скачивание -->
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                    <TextBlock x:Name="ProgressHeadingText" FontSize="15" FontWeight="Bold"
                               Text="{loc:Loc Update.Downloading}" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="ProgressBar" Height="6" Margin="0,16,0,0" Maximum="100"
                                 Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="ProgressText" Margin="0,8,0,0" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Этап 3: вопрос, как применить скачанное обновление -->
                <StackPanel x:Name="RestartPanel" Visibility="Collapsed">
                    <TextBlock x:Name="RestartHeadingText" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>

                    <!-- «Перезапустить сейчас» (основная кнопка) и «Обновить после закрытия» -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="RestartNowButton" Width="230" Height="34" Padding="0" IsDefault="True"
                                Style="{DynamicResource ModernButton}" Margin="0,0,10,0"
                                Click="OnRestartNowClick">
                            <TextBlock x:Name="RestartNowText" Text="{loc:Loc Update.RestartNow}" VerticalAlignment="Center"
                                       FontWeight="SemiBold" FontSize="13"/>
                        </Button>
                        <Button x:Name="UpdateAfterCloseButton" Width="240" Height="34"
                                Style="{DynamicResource SecondaryButton}"
                                Click="OnUpdateAfterCloseClick">
                            <TextBlock x:Name="UpdateAfterCloseText" Text="{loc:Loc Update.UpdateAfterClose}"
                                       VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Этап 4: завершение (подтверждение применения) -->
                <StackPanel x:Name="DonePanel" Visibility="Collapsed">
                    <TextBlock x:Name="DoneText" FontSize="13" TextWrapping="Wrap"/>
                    <Button x:Name="DoneCloseButton" Width="100" Height="34" Margin="0,20,0,0"
                            HorizontalAlignment="Right"
                            Style="{DynamicResource SecondaryButton}"
                            Click="OnDoneCloseClick">
                        <TextBlock x:Name="DoneCloseText" Text="{loc:Loc Common.Close}"
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>

                <!-- Этап 5: ошибка — встроена в это же окно, чтобы при сбое
                     не открывалось дополнительное окно поверх (уменьшает число
                     окон при обновлении). -->
                <StackPanel x:Name="ErrorPanel" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorHeadingText" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"
                               Foreground="#DC2626"
                               Text="{loc:Loc Update.ErrorTitle}"/>
                    <TextBlock x:Name="ErrorText" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button x:Name="ErrorCloseButton" Width="100" Height="34" Margin="0,20,0,0"
                            HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="1.5"
                            BorderBrush="{DynamicResource BorderBrushColor}"
                            Cursor="Hand"
                            Click="OnDoneCloseClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8" Padding="14,6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="{loc:Loc Common.Close}"
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>

            </StackPanel>
        </Grid>
    </Border>
</Window>