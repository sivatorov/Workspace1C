<Window x:Class="Workspace1C.Services.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Title="{loc:Loc Update.NewVersionAvailable}"
        Icon="{StaticResource AppIcon}"
        MaxWidth="900"
        MaxHeight="760"
        MinWidth="680"
        MinHeight="160"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </Window.Resources>

    <Border Padding="0" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}">
        <DockPanel Margin="20">
            <WrapPanel x:Name="OfferButtonsPanel" DockPanel.Dock="Bottom" Visibility="{Binding Visibility, ElementName=OfferPanel}" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <!-- Issue #116 (v1.0.1.58): когда файл обновления уже скачан в фоне
                     (режим «Загружать с предложением установки»), вместо «Скачать»
                     показывается «Установить» — она применяет готовый файл по
                     существующей логике автообновления. Видимость кнопок
                     переключает код-бихайнд по состоянию UpdateService. -->
                <Button x:Name="InstallButton" Width="150" Height="34" Padding="0"
                        Style="{DynamicResource ModernButton}" Margin="0,0,10,0"
                        Visibility="Collapsed"
                        Click="OnInstallClick">
                    <!-- Issue #116 (17.11.2026 14:07): основная кнопка диалога
                         называется «Обновить» во всех режимах и на всех путях —
                         в том числе когда файл уже скачан (действие прежнее:
                         применить готовый файл). -->
                    <TextBlock x:Name="InstallText" Text="{loc:Loc Update.Update}" VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="13"/>
                </Button>
                <Button x:Name="DownloadButton" Width="150" Height="34" Padding="0" IsDefault="True"
                        Style="{DynamicResource ModernButton}" Margin="0,0,10,0"
                        Click="OnDownloadClick">
                    <!-- Issue #116 (1.0.1.82): «Скачать» → «Обновить» — кнопка
                         запускает загрузку и установку, а не только скачивание. -->
                    <TextBlock x:Name="DownloadText" Text="{loc:Loc Update.Update}" VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="13"/>
                </Button>
                <!-- Issue #107 п.2 (v1.0.1.50): MinWidth вместо Width — кнопка
                     авторасширяется, «Пропустить эту версию» больше не обрезается
                     при другом масштабе шрифта/длинных локализациях. -->
                <Button x:Name="SkipVersionButton" MinWidth="170" Height="34"
                        Style="{DynamicResource SecondaryButton}" Margin="0,0,10,0"
                        ToolTip="{loc:Loc Update.SkipHint}"
                        Click="OnSkipVersionClick">
                    <TextBlock x:Name="SkipVersionText" Text="{loc:Loc Update.SkipVersion}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Button>
                <Button x:Name="CancelButton" Width="100" Height="34"
                        Style="{DynamicResource SecondaryButton}"
                        Click="OnCancelClick">
                    <TextBlock x:Name="CancelText" Text="{loc:Loc Update.Cancel}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Button>
            </WrapPanel>
            <WrapPanel x:Name="RestartButtonsPanel" DockPanel.Dock="Bottom" Visibility="{Binding Visibility, ElementName=RestartPanel}" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="RestartNowButton" Width="230" Height="34" Padding="0" IsDefault="True"
                        Style="{DynamicResource ModernButton}" Margin="0,0,10,0"
                        Click="OnRestartNowClick">
                    <TextBlock x:Name="RestartNowText" Text="{loc:Loc Update.RestartNow}" VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="13"/>
                </Button>
                <Button x:Name="UpdateAfterCloseButton" Width="240" Height="34"
                        Style="{DynamicResource SecondaryButton}"
                        Click="OnUpdateAfterCloseClick">
                    <TextBlock x:Name="UpdateAfterCloseText" Text="{loc:Loc Update.UpdateAfterClose}"
                               VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Button>
            </WrapPanel>
        <!-- Issue #139 (1.0.1.102): по умолчанию прокрутка отключена. Код-бихайнд
             включает Auto только при реальном переполнении по высоте
             (UpdateDialogSizePolicy.ShouldShowVerticalScrollBar), поэтому в обычном
             состоянии справа нет полосы, а панель кнопок всегда видна. -->
        <ScrollViewer x:Name="ContentScroller"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Иконка (общая для всех этапов диалога) -->
            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Margin="0,0,16,0"
                    VerticalAlignment="Top"
                    Background="{DynamicResource ItemHoverBrush}">
                <materialDesign:PackIcon Kind="CloudDownloadOutline"
                                         Width="24" Height="24" Foreground="{DynamicResource AccentBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1">

                <!-- Этап 1: предложение скачать новую версию -->
                <StackPanel x:Name="OfferPanel">
                    <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CurrentVersionText" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="NewVersionText" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <!-- Issue #155: версия была пропущена, но пользователь открыл
                         ручную проверку снова — поясняем, что можно обновить или
                         пропустить повторно. -->
                    <TextBlock x:Name="SkippedHintText" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                    <!-- Issue #116 (1.0.1.82): ссылка «Что нового» открывает стандартный
                         диалог изменений новой версии. Показывается в ручных режимах,
                         где блок описания в этом окне скрыт. -->
                    <TextBlock x:Name="WhatsNewLink" Margin="0,8,0,0" Visibility="Collapsed">
                        <Hyperlink Click="OnWhatsNewLinkClick">
                            <Run x:Name="WhatsNewLinkText"/>
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock x:Name="WhatsNewLabel" Margin="0,14,0,4" FontWeight="SemiBold"/>
                    <!-- Issue #139 (1.0.1.103): описание релиза — в рамке-карточке, как
                         в окне «Что нового». Высота тела увеличена: при прежних 180 DIP
                         полоса прокрутки появлялась почти всегда, хотя текст почти
                         помещался. Теперь окно больше (до 900×760), и обычное описание
                         читается целиком без прокрутки. -->
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrushColor}"
                            BorderThickness="1" CornerRadius="6" Padding="10">
                        <FlowDocumentScrollViewer x:Name="BodyViewer" MaxHeight="420"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  IsToolBarVisible="False"
                                                  FontSize="12"
                                                  Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>

                    <!-- Кнопки: «Скачать» слева, «Отмена» справа; между ними —
                         «Пропустить эту версию» (issue #116): версия не будет
                         предлагаться до выхода более новой.
                         Единый контракт кнопок (issue #26): скачивание — ModernButton
                         (акцентная заливка AccentBrush + контрастный TextOnAccentBrush),
                         пропуск и отмена — SecondaryButton (карточка + контур + текст темы).
                         Прежняя жёсткая зелёная кнопка #16A34A с белым текстом убрана.
                         Issue #139 (1.0.1.84): WrapPanel вместо горизонтального
                         StackPanel — при узкой ширине кнопки переносятся, а не
                         обрезаются справа. -->

                </StackPanel>

                <!-- Этап 2: скачивание -->
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                    <TextBlock x:Name="ProgressHeadingText" FontSize="15" FontWeight="Bold"
                               Text="{loc:Loc Update.Downloading}" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="ProgressBar" Height="6" Margin="0,16,0,0" Maximum="100"
                                 Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="ProgressText" Margin="0,8,0,0" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Этап 3: вопрос, как применить скачанное обновление -->
                <StackPanel x:Name="RestartPanel" Visibility="Collapsed">
                    <TextBlock x:Name="RestartHeadingText" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>

                    <!-- «Перезапустить сейчас» (основная кнопка) и «Обновить после закрытия».
                         Issue #139 (1.0.1.84): WrapPanel — кнопки переносятся при узкой ширине. -->

                </StackPanel>

                <!-- Этап 4: завершение (подтверждение применения) -->
                <StackPanel x:Name="DonePanel" Visibility="Collapsed">
                    <TextBlock x:Name="DoneText" FontSize="13" TextWrapping="Wrap"/>
                    <Button x:Name="DoneCloseButton" Width="100" Height="34" Margin="0,20,0,0"
                            HorizontalAlignment="Right"
                            Style="{DynamicResource SecondaryButton}"
                            Click="OnDoneCloseClick">
                        <TextBlock x:Name="DoneCloseText" Text="{loc:Loc Common.Close}"
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>

                <!-- Этап 5: ошибка — встроена в это же окно, чтобы при сбое
                     не открывалось дополнительное окно поверх (уменьшает число
                     окон при обновлении). -->
                <StackPanel x:Name="ErrorPanel" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorHeadingText" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"
                               Foreground="#DC2626"
                               Text="{loc:Loc Update.ErrorTitle}"/>
                    <TextBlock x:Name="ErrorText" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button x:Name="ErrorCloseButton" Width="100" Height="34" Margin="0,20,0,0"
                            HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="1.5"
                            BorderBrush="{DynamicResource BorderBrushColor}"
                            Cursor="Hand"
                            Click="OnDoneCloseClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8" Padding="14,6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="{loc:Loc Common.Close}"
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>

            </StackPanel>
            </Grid>
        </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
