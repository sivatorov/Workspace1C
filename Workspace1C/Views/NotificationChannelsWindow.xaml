<Window x:Class="Workspace1C.NotificationChannelsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Icon="{StaticResource AppIcon}"
        Width="620" Height="720"
        MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldPassword" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Кнопки — единый контракт (issue #26): акцентная ModernButton и вторичная
             SecondaryButton. Имена PrimaryButtonStyle/OutlineButtonStyle сохранены. -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
        <Style x:Key="OutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Loc Notifications.Title}" FontSize="15" FontWeight="SemiBold"/>

        <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <!-- ===== Telegram ===== -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Loc Notifications.TelegramHeader}"/>
                <CheckBox x:Name="TelegramEnabledCheck">
                    <TextBlock Text="{loc:Loc Notifications.TelegramEnabled}"/>
                </CheckBox>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{loc:Loc Notifications.TelegramToken}"/>
                    <PasswordBox Grid.Row="0" Grid.Column="1" x:Name="TelegramTokenBox" Style="{StaticResource FieldPassword}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{loc:Loc Notifications.TelegramChatId}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="TelegramChatBox" Style="{StaticResource FieldBox}"/>
                </Grid>
                <TextBlock Style="{StaticResource HintText}" Text="{loc:Loc Notifications.TelegramHint}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="TelegramTestButton" Style="{StaticResource OutlineButtonStyle}" Click="OnTelegramTestClick" MinWidth="120">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlayCircleOutline" Width="15" Height="15" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc Notifications.Test}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="TelegramStatusText" Style="{StaticResource HintText}" Margin="10,0,0,0"
                               VerticalAlignment="Center" MaxWidth="380"/>
                </StackPanel>

                <!-- ===== Email ===== -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Loc Notifications.EmailHeader}"/>
                <CheckBox x:Name="EmailEnabledCheck">
                    <TextBlock Text="{loc:Loc Notifications.EmailEnabled}"/>
                </CheckBox>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{loc:Loc Notifications.SmtpHost}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="SmtpHostBox" Style="{StaticResource FieldBox}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldLabel}" Margin="10,0,8,0" Text="{loc:Loc Notifications.SmtpPort}"/>
                    <TextBox Grid.Row="0" Grid.Column="3" x:Name="SmtpPortBox" Style="{StaticResource FieldBox}"/>

                    <CheckBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="SmtpStartTlsCheck">
                        <TextBlock Text="{loc:Loc Notifications.SmtpStartTls}"/>
                    </CheckBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{loc:Loc Notifications.SmtpUser}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="SmtpUserBox" Style="{StaticResource FieldBox}"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{loc:Loc Notifications.SmtpPassword}"/>
                    <PasswordBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" x:Name="SmtpPasswordBox" Style="{StaticResource FieldPassword}"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{loc:Loc Notifications.EmailFrom}"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" x:Name="EmailFromBox" Style="{StaticResource FieldBox}"/>
                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{loc:Loc Notifications.EmailTo}"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" x:Name="EmailToBox" Style="{StaticResource FieldBox}"/>
                </Grid>
                <TextBlock Style="{StaticResource HintText}" Text="{loc:Loc Notifications.EmailHint}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="EmailTestButton" Style="{StaticResource OutlineButtonStyle}" Click="OnEmailTestClick" MinWidth="120">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlayCircleOutline" Width="15" Height="15" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc Notifications.Test}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="EmailStatusText" Style="{StaticResource HintText}" Margin="10,0,0,0"
                               VerticalAlignment="Center" MaxWidth="380"/>
                </StackPanel>

                <!-- ===== События ===== -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Loc Notifications.EventsHeader}"/>
                <CheckBox x:Name="OnBackupCheck">
                    <TextBlock Text="{loc:Loc Notifications.OnBackup}"/>
                </CheckBox>
                <CheckBox x:Name="OnScheduledCheck">
                    <TextBlock Text="{loc:Loc Notifications.OnScheduledTasks}"/>
                </CheckBox>
                <CheckBox x:Name="OnUpdatesCheck">
                    <TextBlock Text="{loc:Loc Notifications.OnUpdates}"/>
                </CheckBox>
                <CheckBox x:Name="OnlyProblemsCheck" Margin="0,8,0,4">
                    <TextBlock Text="{loc:Loc Notifications.OnlyProblems}"/>
                </CheckBox>

                <!-- ===== Лицензии (п.5 «Мониторинг лицензий», выпуск 1.0.0.87) ===== -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Loc Notifications.LicensesHeader}"/>
                <TextBlock Style="{StaticResource HintText}" Text="{loc:Loc Notifications.LicensesHint}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{loc:Loc Notifications.LicenseThreshold}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="LicenseThresholdBox" Style="{StaticResource FieldBox}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Margin="0,4,0,0" Text="{loc:Loc Notifications.LicenseRepeatHours}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" x:Name="LicenseRepeatBox" Style="{StaticResource FieldBox}"/>
                </Grid>
                <TextBlock Style="{StaticResource HintText}" Text="{loc:Loc Notifications.LicenseRepeatHint}"/>

                <!-- ===== Прогноз диска под копиями (п.7 «История размеров», 1.0.0.89) ===== -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Loc Notifications.DiskForecastHeader}"/>
                <TextBlock Style="{StaticResource HintText}" Text="{loc:Loc Notifications.DiskForecastHint}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{loc:Loc Notifications.DiskForecastThreshold}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="DiskForecastThresholdBox" Style="{StaticResource FieldBox}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Margin="0,4,0,0" Text="{loc:Loc Notifications.DiskForecastRepeatDays}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" x:Name="DiskForecastRepeatBox" Style="{StaticResource FieldBox}"/>
                </Grid>
                <TextBlock Style="{StaticResource HintText}" Text="{loc:Loc Notifications.DiskForecastRepeatHint}"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Width="140" Height="34" Margin="0,0,10,0" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" Click="OnSaveClick">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Check" Width="16" Height="16"/>
                    <TextBlock Text="{loc:Loc Common.Save}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="120" Height="34" IsCancel="True" Style="{StaticResource OutlineButtonStyle}" Click="OnCancelClick">
                <TextBlock Text="{loc:Loc Common.Cancel}" VerticalAlignment="Center"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
