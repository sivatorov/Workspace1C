<Window x:Class="Workspace1C.ScheduledTaskEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Title="Задание по расписанию"
        Width="560" Height="620" MinWidth="500" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="13"
        Background="{DynamicResource ContentBackgroundBrush}"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <!-- Темизация окна «Задание по расписанию» (issue #291): стили из LightTheme/DarkTheme,
             как у остальных окон (ConnectionSettingsWindow, AppLockWindow и др.). -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ModernButton}"/>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}"/>
        <Style TargetType="CheckBox" BasedOn="{StaticResource ModernMaterialCheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <!-- Пункт списка (тип задания / сценарий / база / канал уведомления / единица
             повтора): явный ItemTemplate вместо DisplayMemberPath из code-behind.
             Закрытый комбобокс с ModernComboBox рисует выбранный элемент до применения
             DisplayMemberPath и показывал ToString() — то есть ключ («Backup»)
             вместо названия («Резервная копия»), issue #372.
             SelectionBoxItemTemplate в WPF — read-only (RegisterReadOnly), его нельзя
             задать из разметки; WPF сам копирует ItemTemplate в закрытую часть при смене
             выбора, а ToString() => Text у ScheduledTaskOption — надёжный fallback. -->
        <DataTemplate x:Key="ScheduleOptionTemplate">
            <TextBlock Text="{Binding Text}"/>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <!-- Поля прокручиваются, нижние кнопки всегда видны (issue #366, 7OH:
                 «снизу кнопочки немного не влазят»). -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Локализация (аудит UI, п. 5.1): литералы заменены ключами Schedule.*. -->
                <TextBlock Text="{loc:Loc Schedule.Name}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox x:Name="NameBox" Grid.Column="1" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1" Text="{loc:Loc Schedule.Enabled}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <CheckBox x:Name="EnabledCheck" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="2" Text="{loc:Loc Schedule.Kind}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <ComboBox x:Name="KindCombo" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                          ItemTemplate="{StaticResource ScheduleOptionTemplate}"
                          SelectionChanged="KindCombo_SelectionChanged"/>

                <TextBlock Grid.Row="3" Text="{loc:Loc Schedule.Time}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox x:Name="TimeBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="4" Text="{loc:Loc Schedule.DaysTitle}" VerticalAlignment="Top" Margin="0,6,8,8"/>
                <StackPanel x:Name="DaysPanel" Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <CheckBox x:Name="MonCheck" Content="Пн" Margin="0,0,10,0" Tag="Monday"/>
                    <CheckBox x:Name="TueCheck" Content="Вт" Margin="0,0,10,0" Tag="Tuesday"/>
                    <CheckBox x:Name="WedCheck" Content="Ср" Margin="0,0,10,0" Tag="Wednesday"/>
                    <CheckBox x:Name="ThuCheck" Content="Чт" Margin="0,0,10,0" Tag="Thursday"/>
                    <CheckBox x:Name="FriCheck" Content="Пт" Margin="0,0,10,0" Tag="Friday"/>
                    <CheckBox x:Name="SatCheck" Content="Сб" Margin="0,0,10,0" Tag="Saturday"/>
                    <CheckBox x:Name="SunCheck" Content="Вс" Tag="Sunday"/>
                </StackPanel>

                <StackPanel x:Name="ScenarioPanel" Grid.Row="5" Grid.ColumnSpan="2" Margin="0,0,0,8">
                    <TextBlock Text="{loc:Loc Schedule.BackupScenario}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <!-- Кнопка доступа к списку сценариев (issue #292): позволяет посмотреть/создать
                         сценарий, не закрывая окно задания по расписанию. -->
                    <DockPanel>
                        <Button x:Name="ScenariosButton" DockPanel.Dock="Right" MinWidth="96" Content="{loc:Loc Schedule.Scenarios}" Padding="12,5" Margin="8,0,0,0" Click="Scenarios_Click"/>
                        <ComboBox x:Name="ScenarioCombo" Margin="0,0,0,0"
                                  ItemTemplate="{StaticResource ScheduleOptionTemplate}"/>
                    </DockPanel>
                </StackPanel>

                <StackPanel x:Name="InfobasePanel" Grid.Row="6" Grid.ColumnSpan="2" Margin="0,0,0,8">
                    <TextBlock Text="{loc:Loc Schedule.Infobase}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox x:Name="InfobaseCombo" Margin="0,0,0,0"
                              ItemTemplate="{StaticResource ScheduleOptionTemplate}"/>
                </StackPanel>

                <StackPanel x:Name="CfgPanel" Grid.Row="7" Grid.ColumnSpan="2" Margin="0,0,0,8">
                    <TextBlock Text="{loc:Loc Schedule.ConfigFile}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <DockPanel>
                        <Button x:Name="BrowseButton" DockPanel.Dock="Right" MinWidth="96" Content="{loc:Loc Common.Browse}" Padding="12,5" Margin="8,0,0,0" Click="Browse_Click"/>
                        <TextBox x:Name="CfgPathBox" Margin="0,0,0,0"/>
                    </DockPanel>
                </StackPanel>

                <!-- Опции проверки обновления платформы (issue #366): выражение проверки
                     («8.5.*», «8.3.27.*»), учёт тестовых сборок, канал уведомления и опция
                     «Уведомлять об отсутствии» (issue #366, 7OH). -->
                <StackPanel x:Name="PlatformPanel" Grid.Row="8" Grid.ColumnSpan="2" Margin="0,0,0,8">
                    <TextBlock x:Name="PlatformExpressionLabel" Text="{loc:Loc Schedule.PlatformCheck.Expression}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox x:Name="PlatformExpressionBox" Margin="0,0,0,8"/>
                    <CheckBox x:Name="PlatformIncludeTestCheck" Content="{loc:Loc Schedule.PlatformCheck.IncludeTest}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="PlatformNotifyLabel" Text="{loc:Loc Schedule.PlatformCheck.Notify}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox x:Name="PlatformNotifyCombo" Margin="0,0,0,0"
                              ItemTemplate="{StaticResource ScheduleOptionTemplate}"/>
                    <CheckBox x:Name="PlatformNotifyNoUpdatesCheck" Content="{loc:Loc Schedule.PlatformCheck.NotifyWhenNoUpdates}" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Опции проверки обновления конфигурации (issue #367): имя конфигурации
                     (выбор из списка баз + ручной ввод), канал уведомления и опция
                     «Уведомлять об отсутствии» (issue #367, 7OH). -->
                <StackPanel x:Name="ConfigPanel" Grid.Row="9" Grid.ColumnSpan="2" Margin="0,0,0,8">
                    <TextBlock x:Name="ConfigLabel" Text="{loc:Loc Schedule.ConfigCheck.Configuration}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox x:Name="ConfigCombo" IsEditable="True" Margin="0,0,0,8"/>
                    <TextBlock x:Name="ConfigNotifyLabel" Text="{loc:Loc Schedule.PlatformCheck.Notify}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox x:Name="ConfigNotifyCombo" Margin="0,0,0,0"
                              ItemTemplate="{StaticResource ScheduleOptionTemplate}"/>
                    <CheckBox x:Name="ConfigNotifyNoUpdatesCheck" Content="{loc:Loc Schedule.ConfigCheck.NotifyWhenNoUpdates}" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Повтор с интервалом (issue #366/#367, 7OH: «каждые х секунд, час/два/10 минут») —
                     общий для обоих типов заданий-проверок. -->
                <StackPanel x:Name="RepeatPanel" Grid.Row="10" Grid.ColumnSpan="2" Margin="0,0,0,8">
                    <CheckBox x:Name="RepeatCheck" Content="{loc:Loc Schedule.Repeat.Enabled}" Margin="0,0,0,8"/>
                    <DockPanel>
                        <TextBlock x:Name="RepeatValueLabel" Text="{loc:Loc Schedule.Repeat.ValueLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="RepeatUnitCombo" DockPanel.Dock="Right" Width="110" Margin="8,0,0,0"
                                  ItemTemplate="{StaticResource ScheduleOptionTemplate}"/>
                        <TextBox x:Name="RepeatValueBox" Width="80" HorizontalAlignment="Left"/>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Кнопки всегда видны: зафиксированы в нижней строке вне области прокрутки
             (issue #366, 7OH: «снизу кнопочки немного не влазят»). -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,12,0,0">
            <Button x:Name="OkButton" Content="{loc:Loc Common.Save}" MinWidth="96" Margin="0,0,8,0" Padding="12,5" IsDefault="True" Click="Ok_Click"/>
            <Button Content="{loc:Loc Common.Cancel}" MinWidth="96" Padding="12,5" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>