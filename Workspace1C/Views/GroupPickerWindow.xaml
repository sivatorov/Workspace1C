<Window x:Class="Workspace1C.GroupPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:Workspace1C.Themes"
        xmlns:vm="clr-namespace:Workspace1C.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:Workspace1C.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        mc:Ignorable="d"
        Title="{loc:Loc GroupPicker.Title}"
        Icon="{StaticResource AppIcon}"
        Width="560" Height="620"
        MinHeight="480" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <!-- Собственный стиль элемента дерева окна выбора группы: подсвечивается только
             ровно выбранная строка (и листья, и родители), родители не «засвечиваются»
             при выборе вложенной группы. -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="header" Background="Transparent" CornerRadius="6"
                                    Padding="4,3" Margin="0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" Grid.Column="0"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press" Width="20" Height="22"
                                                  Background="Transparent" BorderThickness="0"
                                                  Cursor="Hand" VerticalAlignment="Center">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <TextBlock x:Name="ExpanderSymbol" Text="+"
                                                           FontSize="16" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="ExpanderSymbol" Property="Text" Value="-"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Margin="16,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <!-- Только выбранная строка получает подсветку; родители при выборе
                                 вложенного узла остаются без выделения. -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="header" Property="Background" Value="{DynamicResource TreeSelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SortToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Единый контракт кнопок (issue #26): «Отмена» — вторичная SecondaryButton,
             основная кнопка — акцентная ModernButton. Локальные OutlinedButton
             (янтарный контур) и PrimaryButton (акцент) больше не дублируют темы,
             а наследуют единые стили; сохранены размеры окна. -->
        <Style x:Key="OutlinedButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="116"/>
            <Setter Property="Padding" Value="14,6"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="116"/>
            <Setter Property="Padding" Value="14,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- шапка -->
            <RowDefinition Height="Auto"/>  <!-- поиск + сортировка -->
            <RowDefinition Height="Auto"/>  <!-- подсказка -->
            <RowDefinition Height="*"/>     <!-- дерево -->
            <RowDefinition Height="Auto"/>  <!-- действия -->
        </Grid.RowDefinitions>

        <!-- Шапка: иконка + заголовок + подзаголовок + справка -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Margin="0,0,12,0"
                    VerticalAlignment="Top" Background="{DynamicResource AccentBrush}">
                <materialDesign:PackIcon Kind="Folder" Width="20" Height="20" Foreground="{DynamicResource TextOnAccentBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1">
                <!-- Перенос заголовка/подзаголовка (issue #55): при уменьшении ширины
                     окна текст переносится, а не обрезается правым краем. -->
                <TextBlock x:Name="TitleText" Text="" FontSize="15" FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="SubtitleText" Text="" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <controls:HelpLink x:Name="HelpLink" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Top"
                               HelpText=""/>
        </Grid>

        <!-- Поиск + сортировка -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="10" BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrushColor}"
                    Background="{DynamicResource CardBackgroundBrush}" Padding="10,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="16" Height="16"
                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                             Padding="0,7" VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="{loc:Loc GroupPicker.SearchPlaceholder}"
                             TextChanged="OnSearch_TextChanged"/>
                    <Button x:Name="ClearSearch" Grid.Column="2" Background="Transparent" BorderThickness="0"
                            Padding="4,0" Cursor="Hand" Visibility="Collapsed" Click="OnClearSearch_Click"
                            ToolTip="{loc:Loc Main.ClearSearch}">
                        <materialDesign:PackIcon Kind="Close" Width="13" Height="13"
                                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                <ToggleButton x:Name="SortAsc" Style="{StaticResource SortToggle}" IsChecked="True"
                              Click="OnSortAsc_Click" ToolTip="{loc:Loc Main.SortGroupsAscending}">
                    <materialDesign:PackIcon Kind="SortAscending" Width="16" Height="16"
                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                </ToggleButton>
                <ToggleButton x:Name="SortDesc" Style="{StaticResource SortToggle}"
                              Click="OnSortDesc_Click" ToolTip="{loc:Loc Main.SortGroupsDescending}">
                    <materialDesign:PackIcon Kind="SortDescending" Width="16" Height="16"
                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- Подсказка -->
        <TextBlock Grid.Row="2" Margin="0,0,0,8" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{loc:Loc GroupPicker.Hint}"/>

        <!-- Дерево групп: цвет и иконка каждой группы, как в настройках -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}">
            <Grid>
                <TreeView x:Name="GroupsTree"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="6"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectedItemChanged="OnGroupsTree_SelectedItemChanged"
                          MouseDoubleClick="OnGroupsTree_MouseDoubleClick">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:GroupNodeViewModel}"
                                                  ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <Border Padding="6,3" CornerRadius="6" Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Background="{Binding HeaderBrush}">
                                    <Path Width="18" Height="18" Stretch="Uniform"
                                          Fill="{Binding IconBrush}">
                                        <Path.Data>
                                            <!-- Набор иконок темы (0.3.12.60): привязка к IconSetState перерисовывает иконку при смене темы. -->
                                            <MultiBinding Converter="{StaticResource IconKeyToGeometryConverter}">
                                                <Binding Path="Icon"/>
                                                <Binding Path="Current" Source="{x:Static themes:IconSetState.Instance}"/>
                                            </MultiBinding>
                                        </Path.Data>
                                    </Path>
                                </Border>
                                <TextBlock Text="{Binding DisplayName}" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <TextBlock x:Name="EmptyLabel" Text="{loc:Loc Main.EmptyNoResults}"
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Действия: сводка выбора + кнопки -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="ChevronRight" Width="15" Height="15"
                                         Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                <TextBlock x:Name="PathLabel" FontSize="12" MaxWidth="260"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="SelectButton" Style="{StaticResource PrimaryButton}" IsDefault="True"
                        IsEnabled="False" Click="OnSelect_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Check" Width="16" Height="16"
                                                 Foreground="{DynamicResource TextOnAccentBrush}" Margin="0,0,6,0"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Common.Select}" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextOnAccentBrush}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource OutlinedButton}" IsCancel="True" Click="OnCancel_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Close" Width="15" Height="15"
                                                 Foreground="{DynamicResource ButtonTextBrush}" Margin="0,0,6,0"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Common.Cancel}" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Foreground="{DynamicResource ButtonTextBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
