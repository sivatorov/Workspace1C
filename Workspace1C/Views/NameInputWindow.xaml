<Window x:Class="Workspace1C.NameInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        mc:Ignorable="d"
        Title="{loc:Loc NameInput.Title}"
        Icon="{StaticResource AppIcon}"
        Width="440" MinHeight="200" MinWidth="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <!-- Implicit-стили для корректного отображения в тёмной теме -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ Подпись ============ -->
        <TextBlock Grid.Row="0" x:Name="PromptLabel" Text="{loc:Loc NameInput.Prompt}" Margin="0,0,0,8"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>

        <!-- ============ Поле ввода ============ -->
        <TextBox x:Name="NameBox" Grid.Row="1" Padding="8,6"
                 KeyDown="OnNameBox_KeyDown"/>

        <!-- ============ Кнопки ============ -->
        <!-- Порядок кнопок приведён к конвенции проекта (issue #98): главная кнопка —
             слева, «Отмена» — справа (последней), как во всех остальных окнах. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Width="130" Margin="0,0,8,0"
                    IsDefault="True" KeyboardNavigation.TabIndex="900"
                    Style="{StaticResource PrimaryButton}"
                    Click="OnOk_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{DynamicResource IconCheck}" Width="16" Height="16" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,6,0" VerticalAlignment="Center" x:Name="OkIcon"/>
                    <TextBlock x:Name="OkTextBlock" Text="{loc:Loc Common.Ok}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="110"
                    IsCancel="True" KeyboardNavigation.TabIndex="1000"
                    Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{DynamicResource IconClose}" Width="16" Height="16" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Common.Cancel}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
