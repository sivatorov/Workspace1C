<Window x:Class="Workspace1C.PlatformVersionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:models="clr-namespace:Workspace1C.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        mc:Ignorable="d"
        Title="{loc:Loc PlatformVersionPicker.Title}"
        Icon="{StaticResource AppIcon}"
        Width="520" Height="560"
        MinHeight="400" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TreeViewItem" BasedOn="{StaticResource ModernTreeViewItem}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="IsExpanded" Value="False"/>
            <Setter Property="Padding" Value="2,1"/>
        </Style>
        <Style x:Key="ArchRadio" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent" Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="20" Height="20" VerticalAlignment="Center">
                                <!-- Мягкая подложка для ховера (как ripple-зона Material Design) -->
                                <Ellipse x:Name="HoverRing" Width="32" Height="32"
                                         Fill="{DynamicResource ItemHoverBrush}"
                                         Opacity="0"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <!-- Внешний круг индикатора -->
                                <Border x:Name="Outer" Width="20" Height="20" CornerRadius="10"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrushColor}"
                                        BorderThickness="2"
                                        SnapsToDevicePixels="True"/>
                                <!-- Внутренняя точка выбора -->
                                <Ellipse x:Name="Dot" Width="9" Height="9"
                                         Fill="{DynamicResource AccentBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         RenderTransformOrigin="0.5,0.5"
                                         Visibility="Collapsed">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform ScaleX="0" ScaleY="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="9,0,0,0"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverRing" Property="Opacity" Value="1"/>
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Outer" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Outer" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Outer" Property="BorderThickness" Value="0"/>
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Dot" Property="Fill" Value="#FFFFFF"/>
                                <Setter TargetName="Dot" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="HoverRing" Property="Opacity" Value="0.6"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SortToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Фильтр разрядности + сортировка (как в стартере 1С) -->
        <Border Grid.Row="0" Padding="8,6" Margin="0,0,0,8"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="FilterAll" Content="{loc:Loc Common.All}" Style="{StaticResource ArchRadio}"
                                 GroupName="ArchFilter" IsChecked="True"
                                 Checked="OnArchFilter_Changed"/>
                    <RadioButton x:Name="FilterX32" Content="{loc:Loc PlatformVersionPicker.FilterX32}" Style="{StaticResource ArchRadio}"
                                 GroupName="ArchFilter"
                                 Checked="OnArchFilter_Changed"/>
                    <RadioButton x:Name="FilterX64" Content="{loc:Loc PlatformVersionPicker.FilterX64}" Style="{StaticResource ArchRadio}"
                                 GroupName="ArchFilter"
                                 Checked="OnArchFilter_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="SortAsc" Style="{StaticResource SortToggle}"
                                  ToolTip="{loc:Loc PlatformVersionPicker.SortAscTooltip}"
                                  Click="OnSortAsc_Click">
                        <materialDesign:PackIcon Kind="SortAscending" Width="16" Height="16"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="SortDesc" Style="{StaticResource SortToggle}"
                                  IsChecked="True" ToolTip="{loc:Loc PlatformVersionPicker.SortDescTooltip}"
                                  Click="OnSortDesc_Click">
                        <materialDesign:PackIcon Kind="SortDescending" Width="16" Height="16"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Дерево: 8.3 → 8.3.27 → 8.3.27.2214 (x64) -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                CornerRadius="6" Background="{DynamicResource CardBackgroundBrush}">
            <TreeView x:Name="PlatformsTree"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="4"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      SelectedItemChanged="OnPlatformsTree_SelectedItemChanged"
                      MouseDoubleClick="OnPlatformsTree_MouseDoubleClick">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type models:PlatformVersionGroup}"
                                              ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <!-- Иконка по типу узла: папка линии / папка сборок / куб x64|x32 -->
                            <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0"
                                                     VerticalAlignment="Center">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon" BasedOn="{StaticResource {x:Type materialDesign:PackIcon}}">
                                        <Setter Property="Kind" Value="Folder"/>
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                        <Style.Triggers>
                                            <!-- Линия 8.3 — папка-акцент -->
                                            <DataTrigger Binding="{Binding Kind}" Value="Line">
                                                <Setter Property="Kind" Value="Folder"/>
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                            </DataTrigger>
                                            <!-- Группа сборок 8.3.27 — открытая папка -->
                                            <DataTrigger Binding="{Binding Kind}" Value="BuildGroup">
                                                <Setter Property="Kind" Value="FolderOpen"/>
                                                <Setter Property="Foreground" Value="#3B82F6"/>
                                            </DataTrigger>
                                            <!-- Сборка x64 -->
                                            <DataTrigger Binding="{Binding Kind}" Value="LeafX64">
                                                <Setter Property="Kind" Value="CubeOutline"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <!-- Сборка x32 -->
                                            <DataTrigger Binding="{Binding Kind}" Value="LeafX32">
                                                <Setter Property="Kind" Value="Cube"/>
                                                <Setter Property="Foreground" Value="#8B5CF6"/>
                                            </DataTrigger>
                                            <!-- Сборка без метки разрядности -->
                                            <DataTrigger Binding="{Binding Kind}" Value="Leaf">
                                                <Setter Property="Kind" Value="Application"/>
                                                <Setter Property="Foreground" Value="#0EA5E9"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                            <!-- Имя узла, включая локализованный суффикс «(тонкий клиент)»
                                 (DisplayName — единый форматтер, issue #33). Оба стилевых
                                 свойства заданы через Setter (НЕ локально): в WPF локальное
                                 значение имеет приоритет над DataTrigger, из-за чего суффикс
                                 и оранжевая подсветка в 1.0.0.32 не показывались. -->
                            <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLeaf}" Value="False">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                            <!-- Тонкий клиент (issue #33): подсветка оранжевым —
                                                 видно, что полные возможности недоступны. -->
                                            <DataTrigger Binding="{Binding IsThinClient}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <!-- Единый контракт кнопок (issue #26): «Выбрать» — акцентная ModernButton,
             «Отмена» — вторичная SecondaryButton. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SelectButton" Width="140" Height="36" Margin="0,0,10,0" IsDefault="True"
                    Click="OnSelect_Click" IsEnabled="False"
                    Style="{DynamicResource ModernButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Check" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Common.Select}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            <Button Width="140" Height="36" IsCancel="True"
                    Style="{DynamicResource SecondaryButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Common.Cancel}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
