<Window x:Class="Workspace1C.ContextMenuGroupEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        mc:Ignorable="d"
        Title="{loc:Loc ContextMenu.Editor.GroupDialogTitle}"
        Icon="{StaticResource AppIcon}"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <!-- Implicit-стили для корректного отображения в тёмной теме -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ Имя группы ============ -->
        <TextBlock Grid.Row="0" Text="{loc:Loc ContextMenu.Editor.GroupNameLabel}"
                   Margin="0,0,0,6"/>
        <TextBox x:Name="NameBox" Grid.Row="1" Padding="8,6"
                 TextChanged="OnNameBox_TextChanged"/>

        <!-- ============ Кнопки — единый контракт (issue #26): акцентная
             ModernButton и вторичная SecondaryButton. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Width="130" Height="38" Margin="0,0,10,0"
                    IsDefault="True" Click="OnOk_Click"
                    Style="{DynamicResource ModernButton}">
                <TextBlock Text="{loc:Loc Common.Ok}" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </Button>
            <Button Width="130" Height="38" IsCancel="True"
                    Style="{DynamicResource SecondaryButton}">
                <TextBlock Text="{loc:Loc Common.Cancel}" VerticalAlignment="Center"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>