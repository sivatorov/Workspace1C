<Window x:Class="Workspace1C.ConfigUpdateLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Title="{loc:Loc Updates.EditConfig}"
        Icon="{StaticResource AppIcon}"
        Width="720" Height="660"
        MinHeight="580" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <!-- Кнопки — единый контракт (issue #26): акцентная ModernButton. Имя
             PrimaryButtonStyle сохранено. -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>

        <Style x:Key="OutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="15" FontWeight="SemiBold" Text="{loc:Loc Updates.EditConfig}"/>
        <TextBlock Grid.Row="1" x:Name="BaseNameText" FontSize="13" Margin="0,6,0,0" FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentBrush}"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
            <StackPanel>
                <!-- Типовая конфигурация: выпадающий список помечает происхождение записи
                     (★ типовая / пользовательская / ✎★ пользовательская копия — перекрывает
                     типовую, issue #322), чтобы было видно, какая именно запись выбрана. -->
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Updates.Name}"/>
                <ComboBox x:Name="ConfigCombo" SelectionChanged="OnConfigSelectionChanged" Padding="10,7"
                          VerticalContentAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2" ToolTip="{Binding ToolTipText}">
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding OriginBadge}" Margin="10,0,0,0" FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Редакция -->
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Updates.SelectEdition}"/>
                <ComboBox x:Name="EditionCombo" SelectionChanged="OnEditionSelectionChanged" Padding="10,7"
                          DisplayMemberPath="Name" VerticalContentAlignment="Center"/>

                <!-- Режим URL: авто / вручную -->
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Updates.Url}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <RadioButton x:Name="AutoUrlRadio" GroupName="UrlMode" Content="{loc:Loc Updates.UrlAuto}"
                                 VerticalContentAlignment="Center" Margin="0,0,20,0" Cursor="Hand"
                                 Checked="OnUrlModeChanged"/>
                    <RadioButton x:Name="ManualUrlRadio" GroupName="UrlMode" Content="{loc:Loc Updates.UrlManual}"
                                 VerticalContentAlignment="Center" Cursor="Hand"
                                 Checked="OnUrlModeChanged"/>
                </StackPanel>

                <TextBox x:Name="UrlBox" Padding="10,7" FontSize="12" VerticalContentAlignment="Center"
                         IsReadOnly="True" TextWrapping="Wrap"
                         materialDesign:HintAssist.Hint="{loc:Loc Updates.Url}"/>

                <!-- Сегмент адреса (ник каталога релизов) -->
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Updates.Segment}"/>
                <TextBox x:Name="SegmentBox" Padding="10,7" FontSize="12" VerticalContentAlignment="Center"
                         TextChanged="OnSegmentChanged"
                         materialDesign:HintAssist.Hint="{loc:Loc Updates.Segment}"/>
                <TextBlock FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{loc:Loc Updates.SegmentHint}"/>

                <!-- Типовые конфигурации / Определить версию — в одну строку (issue #322);
                     название конфигурации в поле выше занимает всю ширину окна. Надпись о текущих
                     свойствах базы — на отдельной строке под кнопками (не ужимает их и сама
                     переносится по всей ширине). -->
                <StackPanel Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ConfigTypesButton" Height="36" HorizontalAlignment="Left"
                                Style="{StaticResource OutlineButtonStyle}" Click="OnOpenConfigTypesClick">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FormatListBulleted" Width="16" Height="16"/>
                                <TextBlock Text="{loc:Loc Updates.ManageList}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="DefineVersionButton" Height="36" Margin="10,0,0,0"
                                HorizontalAlignment="Left" Style="{StaticResource OutlineButtonStyle}"
                                ToolTip="{loc:Loc Updates.DefineVersionHint}"
                                Click="OnDefineVersionClick">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="MagnifyScan" Width="16" Height="16"/>
                                <TextBlock Text="{loc:Loc Updates.DefineVersion}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock x:Name="CurrentConfigText" FontSize="12" Margin="0,8,0,0"
                               HorizontalAlignment="Left" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <TextBlock FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{loc:Loc Updates.MatchCriteriaHint}"/>
                </StackPanel>

                <TextBlock x:Name="ResultText" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="#16A34A"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Нижняя панель: Сохранить / Отмена -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveButton" Width="150" Height="36" Margin="0,0,10,0"
                        Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="OnSaveClick">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Check" Width="16" Height="16"/>
                        <TextBlock Text="{loc:Loc Updates.Save}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Width="120" Height="36" Style="{StaticResource OutlineButtonStyle}" IsCancel="True"
                        Click="OnCancelClick">
                    <TextBlock Text="{loc:Loc Updates.Cancel}" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>