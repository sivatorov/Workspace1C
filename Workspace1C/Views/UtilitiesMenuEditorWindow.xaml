<Window x:Class="Workspace1C.UtilitiesMenuEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        xmlns:conv="clr-namespace:Workspace1C.Converters"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="{loc:Loc Utilities.Editor.Title}"
        Icon="{StaticResource AppIcon}"
        Height="560" Width="760"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <!-- Implicit-стили для корректного отображения в тёмной теме -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}"/>
        <!-- Превью иконок каталога (issue #374): строковый ключ → PackIconKind. -->
        <conv:PackIconKindConverter x:Key="PackIconKindConverter"/>
        <!-- Шаблон узла дерева: чекбокс видимости + иконка + заголовок + пометка вида -->
        <HierarchicalDataTemplate x:Key="MenuNodeTemplate" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <!-- issue #4: у группы «Новинки программы» видимость зафиксирована
                     (CanToggleVisibility=false) — чекбокс отключён, менять можно
                     только местоположение. -->
                <CheckBox IsChecked="{Binding IsVisible}" IsEnabled="{Binding CanToggleVisibility}"
                          VerticalAlignment="Center"
                          ToolTip="{loc:Loc Utilities.Editor.VisibleTooltip}"/>
                <materialDesign:PackIcon Kind="{Binding DisplayIconKey, Converter={StaticResource PackIconKindConverter}}"
                                         Width="16" Height="16" Margin="4,0,0,0" VerticalAlignment="Center"
                                         Foreground="{Binding DisplayIconColor}">
                    <materialDesign:PackIcon.Style>
                        <Style TargetType="materialDesign:PackIcon" BasedOn="{StaticResource {x:Type materialDesign:PackIcon}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DisplayIconKey}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:PackIcon.Style>
                </materialDesign:PackIcon>
                <TextBlock Text="{Binding Title}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding KindLabel}" Margin="8,0,0,0" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- ============ Нижняя панель кнопок ============ -->
        <!-- Порядок кнопок (issue #374): «Готово» слева, «Отмена» справа — как в остальных
             окнах программы (отмена всегда в конце). -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OkButton" Width="130" IsDefault="True"
                    Style="{StaticResource ModernButton}" Click="OnOk_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource SuccessBrush}" Text="✔" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Utilities.Editor.Done}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="110" Margin="8,0,0,0"
                    Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Content="{loc:Loc Common.Cancel}" IsCancel="True"/>
        </StackPanel>

        <!-- ============ Центральная область: дерево + панель операций ============ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Дерево компоновки -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                    CornerRadius="6" Background="{DynamicResource CardBackgroundBrush}" Padding="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Utilities.Editor.TreeHeader}"
                               Margin="4,4,4,8" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TreeView x:Name="MenuTree" ItemsSource="{Binding Roots}"
                              ItemTemplate="{StaticResource MenuNodeTemplate}"
                              ItemContainerStyle="{StaticResource ModernTreeViewItem}"
                              SelectedItemChanged="OnTree_SelectedItemChanged"
                              BorderThickness="0" Background="Transparent"/>
                </DockPanel>
            </Border>

            <!-- Панель операций -->
            <StackPanel Grid.Column="2">
                <!-- Перемещение -->
                <TextBlock Text="{loc:Loc Utilities.Editor.MoveHeader}" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ModernButton}" Command="{Binding MoveUpCommand}"
                            ToolTip="{loc:Loc Utilities.Editor.MoveUpTooltip}" Padding="10,6" Margin="0,0,6,0">
                        <materialDesign:PackIcon Kind="ArrowUp" Width="16" Height="16"/>
                    </Button>
                    <Button Style="{StaticResource ModernButton}" Command="{Binding MoveDownCommand}"
                            ToolTip="{loc:Loc Utilities.Editor.MoveDownTooltip}" Padding="10,6" Margin="0,0,6,0">
                        <materialDesign:PackIcon Kind="ArrowDown" Width="16" Height="16"/>
                    </Button>
                    <Button Style="{StaticResource ModernButton}" Click="OnAddGroupClick"
                            ToolTip="{loc:Loc Utilities.Editor.AddGroupTooltip}" Padding="10,6" Margin="0,0,6,0">
                        <materialDesign:PackIcon Kind="FolderPlus" Width="16" Height="16"/>
                    </Button>
                    <Button Style="{StaticResource ModernButton}" Command="{Binding AddSeparatorCommand}"
                            ToolTip="{loc:Loc Utilities.Editor.AddSeparatorTooltip}" Padding="10,6" Margin="0,0,6,0">
                        <materialDesign:PackIcon Kind="Minus" Width="16" Height="16"/>
                    </Button>
                    <Button Style="{StaticResource ModernButton}" Click="OnEditGroupClick"
                            ToolTip="{loc:Loc Utilities.Editor.EditGroupTooltip}" Padding="10,6" Margin="0,0,6,0"
                            IsEnabled="{Binding CanEditGroup}">
                        <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16"/>
                    </Button>
                    <Button Style="{StaticResource ModernButton}" Click="OnDeleteGroupClick"
                            ToolTip="{loc:Loc Utilities.Editor.DeleteGroupTooltip}" Padding="10,6"
                            IsEnabled="{Binding CanDeleteGroup}">
                        <materialDesign:PackIcon Kind="Delete" Width="16" Height="16"/>
                    </Button>
                </StackPanel>

                <!-- Поместить в группу -->
                <TextBlock Text="{loc:Loc Utilities.Editor.MoveToGroupHeader}" Margin="0,14,0,4"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ModernButton}"
                            Command="{Binding MoveToGroupCommand}" Padding="10,6" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderMove" Width="16" Height="16" Margin="0,0,4,0"/>
                            <TextBlock Text="{loc:Loc Utilities.Editor.MoveToGroup}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <ComboBox x:Name="GroupCombo" ItemsSource="{Binding Groups}"
                              SelectedItem="{Binding SelectedGroup}">
                        <!-- Явный ItemTemplate вместо DisplayMemberPath: выбранное значение
                             показывает заголовок группы, а не ключ (issue #374). -->
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding GroupLabel}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </DockPanel>
                <Button Style="{StaticResource ModernButton}" Command="{Binding MoveToRootCommand}"
                        ToolTip="{loc:Loc Utilities.Editor.MoveToRootTooltip}" Padding="10,6" Margin="0,6,0,0"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowCollapseUp" Width="16" Height="16" Margin="0,0,4,0"/>
                        <TextBlock Text="{loc:Loc Utilities.Editor.MoveToRoot}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Иконки -->
                <TextBlock Text="{loc:Loc Utilities.Editor.IconHeader}" Margin="0,14,0,4"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ModernButton}"
                            Command="{Binding SetCatalogIconCommand}"
                            CommandParameter="{Binding SelectedIconKey}" Padding="10,6" Margin="6,0,0,0">
                        <TextBlock Text="{loc:Loc Utilities.Editor.ApplyIcon}" VerticalAlignment="Center"/>
                    </Button>
                    <ComboBox x:Name="IconCombo" ItemsSource="{Binding CatalogIcons}"
                              SelectedValuePath="Key" SelectedValue="{Binding SelectedIconKey}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="{Binding Key, Converter={StaticResource PackIconKindConverter}}"
                                                             Width="16" Height="16" Margin="0,0,6,0"
                                                             VerticalAlignment="Center" Foreground="{Binding Color}"/>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Style="{StaticResource ModernButton}" Click="OnExternalIcon_Click" Padding="10,6" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ImageOutline" Width="16" Height="16" Margin="0,0,4,0"/>
                            <TextBlock Text="{loc:Loc Utilities.Editor.ExternalIcon}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModernButton}" Command="{Binding ClearIconCommand}" Padding="10,6">
                        <TextBlock Text="{loc:Loc Utilities.Editor.ClearIcon}" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <!-- Сохранение/загрузка -->
                <TextBlock Text="{loc:Loc Utilities.Editor.FileHeader}" Margin="0,14,0,4"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ModernButton}" Command="{Binding SaveCommand}" Padding="10,6" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Margin="0,0,4,0"/>
                            <TextBlock Text="{loc:Loc Utilities.Editor.Save}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModernButton}" Command="{Binding LoadCommand}" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderDownload" Width="16" Height="16" Margin="0,0,4,0"/>
                            <TextBlock Text="{loc:Loc Utilities.Editor.Load}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Style="{StaticResource ModernButton}" Command="{Binding ResetDefaultCommand}" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Restore" Width="16" Height="16" Margin="0,0,4,0"/>
                            <TextBlock Text="{loc:Loc Utilities.Editor.Reset}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Пояснение -->
                <Border Grid.Column="0" Margin="0,14,0,0" Padding="10" CornerRadius="6"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                    <TextBlock Text="{loc:Loc Utilities.Editor.Hint}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                </Border>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
