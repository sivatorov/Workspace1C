<Window x:Class="Workspace1C.CacheCleanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Title="{loc:Loc CacheClean.Title}"
        Icon="{StaticResource AppIcon}"
        Width="580" Height="540"
        MinHeight="440" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- ===== Material Design чекбокс (квадрат со скруглением, цветная галочка, ховер) ===== -->
        <Style x:Key="ModernMaterialCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent" Cursor="Hand">
                            <Grid Width="20" Height="20" VerticalAlignment="Center">
                                <Border x:Name="BoxBorder" Width="20" Height="20" CornerRadius="4"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1.5"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <materialDesign:PackIcon x:Name="CheckIcon" Kind="Check" Width="13" Height="13"
                                                                 Foreground="White" HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center" Visibility="Collapsed"/>
                                        <materialDesign:PackIcon x:Name="DashIcon" Kind="Minus" Width="13" Height="13"
                                                                 Foreground="White" HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                            </Grid>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="BoxBorder" Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                <Setter TargetName="DashIcon" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Кнопки «Выбрать все» / «Снять все»: без чекбокса, с подсветкой при наведении ===== -->
        <Style x:Key="SelectAllButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" FontSize="15" FontWeight="SemiBold" Text="{loc:Loc CacheClean.TitleHeader}"/>
        <TextBlock Grid.Row="1" FontSize="12" Margin="0,6,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   Text="{loc:Loc CacheClean.Subtitle}"/>

        <!-- Тип кэша -->
        <TextBlock Grid.Row="2" FontWeight="SemiBold" Margin="0,16,0,6" Text="{loc:Loc CacheClean.CacheTypeLabel}"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <CheckBox x:Name="ProgramCacheCheck" Content="{loc:Loc CacheClean.ProgramCache}" Style="{StaticResource ModernMaterialCheckBox}"
                      Margin="0,0,8,0"
                      Checked="OnCacheKindChanged" Unchecked="OnCacheKindChanged"
                      ToolTip="%LOCALAPPDATA%\1C\1cv8…"/>
            <TextBlock x:Name="ProgramCacheSizeText" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,18,0" Text="…"/>
            <Rectangle Width="1" VerticalAlignment="Stretch" Margin="4,0,20,0"
                       Fill="{DynamicResource BorderBrushColor}"/>
            <CheckBox x:Name="UserCacheCheck" Content="{loc:Loc CacheClean.UserCache}" Style="{StaticResource ModernMaterialCheckBox}"
                      Checked="OnCacheKindChanged" Unchecked="OnCacheKindChanged"
                      ToolTip="%APPDATA%\1C\1cv8…"/>
            <TextBlock x:Name="UserCacheSizeText" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,0" Text="…"/>
        </StackPanel>

        <!-- Выбор баз -->
        <Border Grid.Row="4" Margin="0,12,0,0"
                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                CornerRadius="6" Background="{DynamicResource CardBackgroundBrush}">
            <DockPanel>
                <!-- Поиск базы -->
                <Grid DockPanel.Dock="Top" Margin="8,8,8,2">
                    <TextBox x:Name="SearchBox"
                             materialDesign:HintAssist.Hint="{loc:Loc CacheClean.SearchBase}"
                             VerticalContentAlignment="Center"
                             Padding="10,7"
                             FontSize="13"
                             TextChanged="OnSearchTextChanged"/>
                </Grid>
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,0,1"
                        Padding="8,4" Background="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SelectAllButton" Style="{StaticResource SelectAllButtonStyle}"
                                ToolTip="{loc:Loc CacheClean.SelectAllTooltip}"
                                Click="OnSelectAllClick">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckboxMultipleMarked" Width="16" Height="16"
                                                         Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc CacheClean.SelectAll}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" x:Name="ClearSelectionButton"
                                Style="{StaticResource SelectAllButtonStyle}"
                                Margin="16,0,0,0" ToolTip="{loc:Loc CacheClean.ClearAllTooltip}"
                                Click="OnClearSelectionClick">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckboxMultipleBlankOutline" Width="16" Height="16"
                                                         Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc CacheClean.ClearAll}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="2" x:Name="BasesCountText" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>
                </Border>
                <!-- Закреплённая шапка списка (остаётся вверху при прокрутке) -->
                <Grid x:Name="BasesHeaderGrid" DockPanel.Dock="Top" Margin="8,0,8,2"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <StackPanel x:Name="BasesPanel" Margin="4,2"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Нижняя панель: остатки от удалённых баз + кнопки -->
        <Grid Grid.Row="5" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Остатки кеша от удалённых баз -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <CheckBox x:Name="OrphanCacheCheck" Content="{loc:Loc CacheClean.OrphanCache}"
                          Style="{StaticResource ModernMaterialCheckBox}"
                          Checked="OnCacheKindChanged" Unchecked="OnCacheKindChanged"
                          ToolTip="{loc:Loc CacheClean.OrphanCacheTooltip}"/>
                <!-- Размер подписью под флажком, а не рядом: при ширине окна по умолчанию
                     соседняя строка с размером обрезалась кнопкой очистки (issue #178). -->
                <TextBlock x:Name="OrphanCacheSizeText" FontSize="12" Margin="24,2,0,0"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}" Text="…"/>
            </StackPanel>

            <!-- Единый контракт кнопок (issue #26): «Очистить» — акцентная ModernButton,
                 «Отмена» — вторичная SecondaryButton. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CleanButton" Width="180" Height="36" Margin="0,0,10,0" IsDefault="True"
                    Click="OnClean_Click" IsEnabled="False"
                    Style="{DynamicResource ModernButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Broom" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc CacheClean.Clean}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            <Button Width="140" Height="36" IsCancel="True"
                    Style="{DynamicResource SecondaryButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Common.Cancel}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
