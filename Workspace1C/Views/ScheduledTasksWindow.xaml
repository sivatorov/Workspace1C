<Window x:Class="Workspace1C.ScheduledTasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Title="Задания по расписанию"
        Width="760" Height="560" MinWidth="620" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="13"
        Background="{DynamicResource ContentBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Темизация окна «Задания по расписанию» (issue #291): стили из LightTheme/DarkTheme,
             как у остальных окон (ConnectionSettingsWindow, AppLockWindow и др.). -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ModernButton}"/>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ModernListBoxItem}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}"/>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"/>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <!-- Пункт фильтра по типу (issue #372): явный ItemTemplate вместо DisplayMemberPath
             из code-behind. Закрытый ModernComboBox рисует выбранный элемент до применения
             DisplayMemberPath и показывал ToString() — длинную строку
             «KindFilterOption { Value = ..., Text = ... }» вместо «Все типы»/«Резервная копия».
             SelectionBoxItemTemplate в WPF — read-only (RegisterReadOnly), его нельзя задать
             из разметки; WPF сам копирует ItemTemplate в закрытую часть при смене выбора,
             а ToString() => Text у KindFilterOption — надёжный fallback. -->
        <DataTemplate x:Key="ScheduleFilterOptionTemplate">
            <TextBlock Text="{Binding Text}"/>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="14">
        <!-- Фильтры списка (issue #372, п. 1–2): отбор по типу действия и поиск по всем полям. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <ComboBox x:Name="KindFilterCombo" Width="240" Margin="0,0,8,0"
                      ItemTemplate="{StaticResource ScheduleFilterOptionTemplate}"
                      SelectionChanged="KindFilterCombo_SelectionChanged"/>
            <TextBox x:Name="SearchBox" Width="320" TextChanged="SearchBox_TextChanged"/>
        </StackPanel>

        <!-- Кнопка «Закрыть» внизу убрана (issue #372, п. 3): закрытие — системное / Esc. -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <!-- Футер диалога (аудит UI, пп. 3.3 и 5.4): единые MinWidth/Padding и ключи локализации. -->
            <Button x:Name="RunButton" Content="{loc:Loc Schedule.RunNow}" MinWidth="96" Margin="0,0,8,0" Padding="12,5" Click="Run_Click"/>
            <Button x:Name="AddButton" Content="{loc:Loc Common.Add}" MinWidth="96" Margin="0,0,8,0" Padding="12,5" Click="Add_Click"/>
            <Button x:Name="EditButton" Content="{loc:Loc Common.Edit}" MinWidth="96" Margin="0,0,8,0" Padding="12,5" IsEnabled="False" Click="Edit_Click"/>
            <Button x:Name="CopyButton" Content="{loc:Loc Common.Copy}" MinWidth="96" Margin="0,0,8,0" Padding="12,5" IsEnabled="False" Click="Copy_Click"/>
            <Button x:Name="DeleteButton" Content="{loc:Loc Common.Delete}" MinWidth="96" Padding="12,5" IsEnabled="False" Click="Delete_Click"/>
        </StackPanel>

        <ListBox x:Name="TasksList" SelectionChanged="TasksList_SelectionChanged"
                 BorderThickness="1" Margin="0,0,0,8">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="3">
                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsActive, Mode=TwoWay}"
                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="{Binding KindText}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding ScheduleSummary}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding LastRunSummary}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>