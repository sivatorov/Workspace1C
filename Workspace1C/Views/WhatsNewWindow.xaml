<!-- Issue #116 п.3 (v1.0.1.55, 7OH): окно «Что нового» в полтора раза больше
     по обеим осям — сводка релиза читается целиком, галка «Показывать при
     запуске» и кнопки помещаются без обрезки текста.
     Issue #124 (v1.0.1.56): компоновка переведена с Grid (Auto/* /Auto строки)
     на DockPanel — при сжатии окна мышкой до минимума нижняя панель
     (галка «Показывать при запуске» + кнопки) докится к низу и измеряется
     до карточки сводки, поэтому больше не уезжает за нижнюю границу и
     не обрезается; сжимается только карточка со сводкой. -->
<Window x:Class="Workspace1C.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Icon="{StaticResource AppIcon}"
        Height="630" Width="840" MinHeight="480" MinWidth="660"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20" LastChildFill="True">
        <!-- Заголовок: «Что нового в Workspace 1C <версия>» (docked Top). -->
        <TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold"
                   Margin="0,0,0,12" TextWrapping="Wrap"/>

        <!-- Сводка изменений релиза: пункты списком, читаемо в обеих темах.
             Issue #116 п.1 (v1.0.1.50): вместо постоянного внешнего ScrollViewer —
             пустой хост; код-обёртка кладёт ОДИН скролл-контейнер (ScrollViewer
             для краткой сводки или FlowDocumentScrollViewer для markdown-текста
             GitHub-релиза), иначе колесо мыши перехватывалось вложенным
             FlowDocumentScrollViewer и текст не скроллился. -->

        <!-- Кнопки: открыть CHANGELOG на GitHub; галка «показывать при запуске»; закрыть
             (docked Bottom — измеряется до карточки сводки и не обрезается, issue #124). -->
        <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="ShowOnStartCheck" Grid.Column="0" VerticalAlignment="Center"
                      Content="{loc:Loc WhatsNew.ShowOnStart}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource DialogButton}" Click="OnOpenChangelog_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🌐" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc WhatsNew.OpenChangelog}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DialogButton}" IsCancel="True" Click="OnClose_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✖" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Common.Close}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Сводка изменений релиза (последний элемент — заполняет остаток). -->
        <Border Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                Padding="14" CornerRadius="4">
            <Grid x:Name="NotesHost"/>
        </Border>
    </DockPanel>
</Window>
