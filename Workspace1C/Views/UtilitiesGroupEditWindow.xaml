<Window x:Class="Workspace1C.UtilitiesGroupEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        xmlns:conv="clr-namespace:Workspace1C.Converters"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="{loc:Loc Utilities.Editor.GroupDialogTitle}"
        Icon="{StaticResource AppIcon}"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <!-- Implicit-стили для корректного отображения в тёмной теме -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}"/>
        <!-- Превью иконок каталога (issue #374): ТА ЖЕ геометрия приложения, что рисуют
             меню «Утилиты» и адаптер трея (Path по ключу через IconKeyToGeometryConverter),
             а не MaterialDesign PackIcon — выбранная иконка не должна «меняться по дороге». -->
        <conv:IconKeyToGeometryConverter x:Key="IconKeyToGeometry"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ Имя группы ============ -->
        <TextBlock Grid.Row="0" Text="{loc:Loc Utilities.Editor.GroupNameLabel}"
                   Margin="0,0,0,6"/>
        <TextBox x:Name="NameBox" Grid.Row="1" Padding="8,6"
                 TextChanged="OnNameBox_TextChanged"/>

        <!-- ============ Иконка ============ -->
        <TextBlock Grid.Row="2" Text="{loc:Loc Utilities.Editor.IconHeader}"
                   Margin="0,12,0,6"/>
        <ComboBox x:Name="IconCombo" Grid.Row="3" Margin="0,12,0,0"
                  HorizontalAlignment="Left" Width="220">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{Binding Key, Converter={StaticResource IconKeyToGeometry}}"
                              Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0"
                              VerticalAlignment="Center" Fill="{Binding Color}"/>
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- ============ Кнопки — единый контракт (issue #26): акцентная
             ModernButton и вторичная SecondaryButton. -->
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Width="130" Height="38" Margin="0,0,10,0"
                    IsDefault="True" Click="OnOk_Click"
                    Style="{DynamicResource ModernButton}">
                <TextBlock Text="{loc:Loc Common.Ok}" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </Button>
            <Button Width="130" Height="38" IsCancel="True"
                    Style="{DynamicResource SecondaryButton}">
                <TextBlock Text="{loc:Loc Common.Cancel}" VerticalAlignment="Center"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>